+static int s6sy761_wait_boot_complete(struct s6sy761_data *sdata)
 {
+	unsigned long timeout = jiffies + msecs_to_jiffies(400);
 	u8 buffer[S6SY761_EVENT_SIZE];
 	u8 event;
 	int ret;
 
+	do {
+		ret = i2c_smbus_read_i2c_block_data(sdata->client,
+						    S6SY761_READ_ONE_EVENT,
+						    S6SY761_EVENT_SIZE,
+						    buffer);
+		if (ret < 0)
+			return ret;
+
+		event = (buffer[0] >> 2) & 0xf;
+
+		if ((event == S6SY761_EVENT_INFO ||
+		     event == S6SY761_EVENT_VENDOR_INFO) &&
+		    buffer[1] == S6SY761_INFO_BOOT_COMPLETE)
+			return 0;
+
+		msleep(20);
+	} while (time_before(jiffies, timeout));
+
+	return -ENODEV;
+}
+
