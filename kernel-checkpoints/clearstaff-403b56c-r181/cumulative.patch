+/*
+ * Commit one guarded checkpoint as a native persistent_ram pmsg record.
+ * R6 imports this zone into /sys/fs/pstore before reusing it. The boot
+ * protocol requires the MMU and D-cache to be off at primary entry; the first
+ * call is additionally guarded by explicit SCTLR checks.
+ */
+	.macro	hotdog_pmsg_stage stage
+	movz	x9, #0xeff0
+	movk	x9, #0xa9bf, lsl #16
+	str	wzr, [x9, #0x00]		// invalidate header while updating
+	mov	w10, #16
+	str	w10, [x9, #0x04]		// next write position
+	str	w10, [x9, #0x08]		// valid payload size
+	movz	w10, #0x4448
+	movk	w10, #0x4d50, lsl #16	// little-endian ASCII "HDPM"
+	str	w10, [x9, #0x0c]
+	movz	w10, #0x0001
+	movk	w10, #0x0008, lsl #16	// instrumentation build 8.1
+	str	w10, [x9, #0x10]
+	mov	w10, #\stage
+	str	w10, [x9, #0x14]
+	mvn	w10, w10
+	str	w10, [x9, #0x18]
+	dsb	sy
+	movz	w10, #0x4244
+	movk	w10, #0x4347, lsl #16	// persistent_ram signature "DBGC"
+	str	w10, [x9, #0x00]
+	dsb	sy
+	.endm
+
+/* Draw one large cumulative white block without changing display registers. */
+	.macro	hotdog_fb_stage slot
+	mov	x11, #0x9c000000
+	movz	x12, #0x21, lsl #16
+	add	x12, x12, #0xc, lsl #12	// row 384 at a 5760-byte stride
+	add	x11, x11, x12
+	mov	x17, #(\slot * 640)		// 160 pixels between blocks
+	add	x11, x11, x17
+	movz	w12, #0xffff
+	movk	w12, #0x00ff, lsl #16	// a8r8g8b8 white
+	mov	x13, #112
+.Lhotdog_fb_row\@:
+	mov	x14, #128
+.Lhotdog_fb_pixel\@:
+	str	w12, [x11], #4
+	subs	x14, x14, #1
+	b.ne	.Lhotdog_fb_pixel\@
+	add	x11, x11, #1, lsl #12	// stride - 128 * 4
+	add	x11, x11, #0x480
+	subs	x13, x13, #1
+	b.ne	.Lhotdog_fb_row\@
+	dsb	sy
+	.endm
+
+/*
+ * First-instruction canary for the direct-boot path. ABL is required to enter
+ * with the MMU and D-cache disabled. In that state, stop the inherited APSS
+ * watchdog and paint one webcam-visible block before normal entry continues.
+ * If the boot contract is not met, hold without touching physical MMIO.
+ */
+	.macro	hotdog_entry_canary
+	mov	x11, #0x9c000000
+	movz	x12, #0x21, lsl #16
+	add	x12, x12, #0xc, lsl #12	// row 384 at a 5760-byte stride
+	add	x11, x11, x12
+	add	x11, x11, #0x340		// column 208
+	movz	w12, #0xffff
+	movk	w12, #0x00ff, lsl #16	// a8r8g8b8 white
+	mov	x13, #512
+.Lhotdog_entry_row\@:
+	mov	x14, #1024
+.Lhotdog_entry_pixel\@:
+	str	w12, [x11], #4
+	subs	x14, x14, #1
+	b.ne	.Lhotdog_entry_pixel\@
+	add	x11, x11, #0x680		// stride - 1024 * 4
+	subs	x13, x13, #1
+	b.ne	.Lhotdog_entry_row\@
+	b	.Lhotdog_v9_continue
+	.endm
