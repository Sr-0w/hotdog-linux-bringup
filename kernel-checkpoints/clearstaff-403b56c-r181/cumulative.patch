diff --git a/drivers/media/i2c/hotdog-cam-scan.c b/drivers/media/i2c/hotdog-cam-scan.c
new file mode 100644
index 000000000000..bf67f8bff277
--- /dev/null
+++ b/drivers/media/i2c/hotdog-cam-scan.c
@@ -0,0 +1,482 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Bring-up aid for the OnePlus 7T Pro camera slots.
+ *
+ * The board describes four camera slots but says nothing about which image
+ * sensor sits in which one, nor at which I2C address. A sensor only answers
+ * once its supplies are up, its MCLK is running and reset is released, so it
+ * cannot be found by scanning a cold bus.
+ *
+ * This driver powers one slot exactly as a sensor driver would, then reads
+ * register 0x0000 from every address on that slot's CCI bus. Sony and Samsung
+ * sensors both report their model there, so a single boot identifies every
+ * slot. It is a diagnostic, not a device driver: it never streams and is meant
+ * to be removed once the sensors are described.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/mod_devicetable.h>
+#include <linux/mutex.h>
+#include <linux/module.h>
+#include <linux/property.h>
+#include <linux/regulator/consumer.h>
+
+#define HOTDOG_CAM_SCAN_MCLK_RATE	24000000
+#define HOTDOG_IMX586_MCLK_RATE		19200000
+#define HOTDOG_IMX586_VANA_MIN_UV	3300000
+#define HOTDOG_IMX586_VANA_MAX_UV	3320000
+#define HOTDOG_IMX586_VDIG_LOAD_UA	1100000
+
+/*
+ * Off unless asked for. Powering a slot and driving its bus is intrusive
+ * enough that it must not happen during boot: an earlier revision did, and a
+ * fault while scanning left the handset without a usable userspace. Load with
+ * scan=1 by hand, with the log in view.
+ */
+static int scan = -1;
+module_param(scan, int, 0444);
+MODULE_PARM_DESC(scan,
+		 "I2C bus number of the one slot to power and probe, -1 for none");
+
+/*
+ * How far to take the power-up sequence. The generic path has five stages. The
+ * OxygenOS IMX586 path has six: CUSTOM_GPIO1, VDIG, CUSTOM_GPIO2, VIO, MCLK,
+ * then reset and the model read.
+ */
+static int stage = 6;
+module_param(stage, int, 0444);
+MODULE_PARM_DESC(stage, "Stop the power-up after this step, 1 to 6");
+
+static unsigned int hold_ms;
+module_param(hold_ms, uint, 0444);
+MODULE_PARM_DESC(hold_ms,
+		 "Hold the powered IMX586 sequence before reading, capped at 5000 ms");
+
+/* One slot at a time: the two masters of a CCI block share an interrupt. */
+static DEFINE_MUTEX(hotdog_cam_scan_lock);
+
+/*
+ * Addresses used by the image sensors and companion parts this handset can
+ * carry. Sweeping the whole range gains nothing and means hundreds of
+ * transfers that no device will answer.
+ */
+static const u8 hotdog_cam_scan_addrs[] = {
+	0x10, 0x1a, 0x1f, 0x20, 0x21, 0x2d, 0x34, 0x36, 0x37, 0x5a, 0x6c,
+};
+
+/* Samsung report their model at 0x0000; Sony at 0x0016. */
+static const u16 hotdog_cam_scan_id_regs[] = { 0x0000, 0x0016 };
+
+static void hotdog_cam_scan_bus(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	unsigned int found = 0;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(hotdog_cam_scan_addrs); i++) {
+		u8 addr = hotdog_cam_scan_addrs[i];
+		unsigned int r;
+
+		if (addr == client->addr)
+			continue;
+
+		/*
+		 * Samsung parts report their model at 0x0000, Sony ones at
+		 * 0x0016, so read both rather than assume which vendor a slot
+		 * holds.
+		 */
+		for (r = 0; r < ARRAY_SIZE(hotdog_cam_scan_id_regs); r++) {
+			u16 reg = hotdog_cam_scan_id_regs[r];
+			u8 wbuf[2] = { reg >> 8, reg & 0xff };
+			u8 rbuf[2] = { 0xff, 0xff };
+			struct i2c_msg msgs[2] = {
+				{ .addr = addr, .flags = 0,
+				  .len = sizeof(wbuf), .buf = wbuf },
+				{ .addr = addr, .flags = I2C_M_RD,
+				  .len = sizeof(rbuf), .buf = rbuf },
+			};
+
+			if (i2c_transfer(client->adapter, msgs,
+					 ARRAY_SIZE(msgs)) != 2)
+				continue;
+
+			dev_info(dev,
+				 "address 0x%02x answers, register 0x%04x = 0x%02x%02x\n",
+				 addr, reg, rbuf[0], rbuf[1]);
+			found++;
+
+			/* Give the bus a moment between transfers. */
+			usleep_range(200, 400);
+		}
+	}
+
+	if (!found)
+		dev_info(dev, "no device answered on this bus\n");
+}
+
+static void hotdog_imx586_read_id(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	u8 wbuf[2] = { 0x00, 0x16 };
+	u8 rbuf[2] = { 0xff, 0xff };
+	struct i2c_msg msgs[2] = {
+		{ .addr = 0x1a, .flags = 0, .len = sizeof(wbuf), .buf = wbuf },
+		{ .addr = 0x1a, .flags = I2C_M_RD,
+		  .len = sizeof(rbuf), .buf = rbuf },
+	};
+	int ret;
+
+	ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+	if (ret != 2) {
+		dev_info(dev, "IMX586 did not answer at 0x1a: %d\n", ret);
+		return;
+	}
+
+	dev_info(dev, "IMX586 model register 0x0016 = 0x%02x%02x%s\n",
+		 rbuf[0], rbuf[1],
+		 rbuf[0] == 0x05 && rbuf[1] == 0x86 ? " (matched)" : "");
+}
+
+static int hotdog_imx586_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct gpio_desc *custom1;
+	struct gpio_desc *custom2;
+	struct gpio_desc *reset;
+	struct gpio_desc *vana_enable;
+	struct regulator *vana;
+	struct regulator *vdig;
+	struct regulator *vio;
+	struct clk *mclk;
+	bool custom1_on = false;
+	bool custom2_on = false;
+	bool mclk_on = false;
+	bool reset_up = false;
+	bool vana_on = false;
+	bool vana_voltage_set = false;
+	bool vdig_load_set = false;
+	bool vdig_on = false;
+	bool vio_on = false;
+	int ret = 0;
+
+	custom1 = devm_gpiod_get(dev, "custom1", GPIOD_OUT_LOW);
+	if (IS_ERR(custom1))
+		return dev_err_probe(dev, PTR_ERR(custom1),
+				     "cannot get CUSTOM_GPIO1\n");
+
+	custom2 = devm_gpiod_get(dev, "custom2", GPIOD_OUT_LOW);
+	if (IS_ERR(custom2))
+		return dev_err_probe(dev, PTR_ERR(custom2),
+				     "cannot get CUSTOM_GPIO2\n");
+
+	reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(reset))
+		return dev_err_probe(dev, PTR_ERR(reset),
+				     "cannot get reset GPIO\n");
+
+	vana_enable = devm_gpiod_get(dev, "vana-enable", GPIOD_OUT_LOW);
+	if (IS_ERR(vana_enable))
+		return dev_err_probe(dev, PTR_ERR(vana_enable),
+				     "cannot get VANA enable GPIO\n");
+
+	vana = devm_regulator_get(dev, "vana");
+	if (IS_ERR(vana))
+		return dev_err_probe(dev, PTR_ERR(vana), "cannot get VANA\n");
+
+	vdig = devm_regulator_get(dev, "vdig");
+	if (IS_ERR(vdig))
+		return dev_err_probe(dev, PTR_ERR(vdig), "cannot get VDIG\n");
+
+	vio = devm_regulator_get(dev, "vio");
+	if (IS_ERR(vio))
+		return dev_err_probe(dev, PTR_ERR(vio), "cannot get VIO\n");
+
+	mclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(mclk))
+		return dev_err_probe(dev, PTR_ERR(mclk), "cannot get MCLK\n");
+
+	ret = clk_set_rate(mclk, HOTDOG_IMX586_MCLK_RATE);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot set IMX586 MCLK rate\n");
+
+	/*
+	 * OxygenOS requests 3.3 V from PM8150L BOB and then raises GPIO11
+	 * while probing the EEPROM shared by the rear sensor pair.  Preserve
+	 * that board-level prerequisite while exercising the IMX586 sequence.
+	 */
+	ret = regulator_set_voltage(vana, HOTDOG_IMX586_VANA_MIN_UV,
+				    HOTDOG_IMX586_VANA_MAX_UV);
+	if (ret) {
+		dev_err(dev, "cannot set IMX586 VANA voltage: %d\n", ret);
+		goto power_down;
+	}
+	vana_voltage_set = true;
+
+	ret = regulator_enable(vana);
+	if (ret) {
+		dev_err(dev, "cannot enable IMX586 VANA: %d\n", ret);
+		goto power_down;
+	}
+	vana_on = true;
+	gpiod_set_value_cansleep(vana_enable, 1);
+	usleep_range(1000, 2000);
+	dev_info(dev,
+		 "IMX586 prerequisite: VANA enabled=%d voltage=%d uV, GPIO11 logical=%d\n",
+		 regulator_is_enabled(vana), regulator_get_voltage(vana),
+		 gpiod_get_value_cansleep(vana_enable));
+
+	gpiod_set_value_cansleep(custom1, 1);
+	custom1_on = true;
+	dev_info(dev, "IMX586 stage 1: CUSTOM_GPIO1 asserted, logical=%d\n",
+		 gpiod_get_value_cansleep(custom1));
+	if (stage < 2)
+		goto power_down;
+
+	ret = regulator_set_load(vdig, HOTDOG_IMX586_VDIG_LOAD_UA);
+	if (ret) {
+		dev_err(dev, "cannot set IMX586 VDIG load: %d\n", ret);
+		goto power_down;
+	}
+	vdig_load_set = true;
+
+	ret = regulator_enable(vdig);
+	if (ret) {
+		dev_err(dev, "cannot enable IMX586 VDIG: %d\n", ret);
+		goto power_down;
+	}
+	vdig_on = true;
+	usleep_range(1000, 2000);
+	dev_info(dev,
+		 "IMX586 stage 2: VDIG enabled=%d voltage=%d uV load=%d uA mode=%u\n",
+		 regulator_is_enabled(vdig), regulator_get_voltage(vdig),
+		 HOTDOG_IMX586_VDIG_LOAD_UA, regulator_get_mode(vdig));
+	if (stage < 3)
+		goto power_down;
+
+	gpiod_set_value_cansleep(custom2, 1);
+	custom2_on = true;
+	dev_info(dev, "IMX586 stage 3: CUSTOM_GPIO2 asserted, logical=%d\n",
+		 gpiod_get_value_cansleep(custom2));
+	if (stage < 4)
+		goto power_down;
+
+	ret = regulator_enable(vio);
+	if (ret) {
+		dev_err(dev, "cannot enable IMX586 VIO: %d\n", ret);
+		goto power_down;
+	}
+	vio_on = true;
+	usleep_range(1000, 2000);
+	dev_info(dev,
+		 "IMX586 stage 4: VIO enabled=%d voltage=%d uV\n",
+		 regulator_is_enabled(vio), regulator_get_voltage(vio));
+	if (stage < 5)
+		goto power_down;
+
+	ret = clk_prepare_enable(mclk);
+	if (ret) {
+		dev_err(dev, "cannot enable IMX586 MCLK: %d\n", ret);
+		goto power_down;
+	}
+	mclk_on = true;
+	usleep_range(1000, 2000);
+	dev_info(dev, "IMX586 stage 5: MCLK running at %lu Hz, reset logical=%d\n",
+		 clk_get_rate(mclk), gpiod_get_value_cansleep(reset));
+	if (stage < 6)
+		goto power_down;
+
+	gpiod_set_value_cansleep(reset, 0);
+	reset_up = true;
+	usleep_range(1000, 2000);
+	dev_info(dev, "IMX586 stage 6: reset released, logical=%d\n",
+		 gpiod_get_value_cansleep(reset));
+	if (hold_ms) {
+		unsigned int delay = min(hold_ms, 5000U);
+
+		dev_info(dev, "IMX586 holding powered sequence for %u ms\n",
+			 delay);
+		msleep(delay);
+	}
+	dev_info(dev, "IMX586 reading model\n");
+	hotdog_imx586_read_id(client);
+
+power_down:
+	/* Match the power-down order encoded by every OnePlus IMX586 module. */
+	if (reset_up)
+		gpiod_set_value_cansleep(reset, 1);
+	if (mclk_on)
+		clk_disable_unprepare(mclk);
+	if (vio_on)
+		regulator_disable(vio);
+	if (vdig_on)
+		regulator_disable(vdig);
+	if (vdig_load_set)
+		regulator_set_load(vdig, 0);
+	if (custom2_on)
+		gpiod_set_value_cansleep(custom2, 0);
+	if (custom1_on)
+		gpiod_set_value_cansleep(custom1, 0);
+	if (vana_on) {
+		regulator_disable(vana);
+		gpiod_set_value_cansleep(vana_enable, 0);
+	}
+	if (vana_voltage_set)
+		regulator_set_voltage(vana, 0, 4000000);
+
+	return ret ? ret : -ENODEV;
+}
+
+static int hotdog_cam_scan_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct gpio_desc *reset;
+	struct gpio_descs *vana_enable;
+	struct regulator *vana;
+	struct regulator *vdig;
+	struct regulator *vio;
+	struct clk *mclk;
+	int ret;
+
+	/*
+	 * One slot at a time, named explicitly. Powering all of them together
+	 * resets the handset, and doing them individually is what tells the
+	 * slots apart.
+	 */
+	if (scan < 0 || scan != i2c_adapter_id(client->adapter))
+		return -ENODEV;
+
+	dev_info(dev, "scanning this slot on i2c-%d\n", scan);
+	guard(mutex)(&hotdog_cam_scan_lock);
+
+	if (device_property_read_bool(dev,
+				      "oneplus,imx586-power-sequence"))
+		return hotdog_imx586_probe(client);
+
+	vio = devm_regulator_get(dev, "vio");
+	if (IS_ERR(vio))
+		return dev_err_probe(dev, PTR_ERR(vio), "cannot get VIO\n");
+
+	vana = devm_regulator_get(dev, "vana");
+	if (IS_ERR(vana))
+		return dev_err_probe(dev, PTR_ERR(vana), "cannot get VANA\n");
+
+	vdig = devm_regulator_get(dev, "vdig");
+	if (IS_ERR(vdig))
+		return dev_err_probe(dev, PTR_ERR(vdig), "cannot get VDIG\n");
+
+	/* Held asserted until the rails and the clock are up. */
+	reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(reset))
+		return dev_err_probe(dev, PTR_ERR(reset),
+				     "cannot get reset GPIO\n");
+
+	vana_enable = devm_gpiod_get_array_optional(dev, "vana-enable",
+						    GPIOD_OUT_LOW);
+	if (IS_ERR(vana_enable))
+		return dev_err_probe(dev, PTR_ERR(vana_enable),
+				     "cannot get analogue enable GPIOs\n");
+
+	mclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(mclk))
+		return dev_err_probe(dev, PTR_ERR(mclk), "cannot get MCLK\n");
+
+	ret = clk_set_rate(mclk, HOTDOG_CAM_SCAN_MCLK_RATE);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot set MCLK rate\n");
+
+	ret = regulator_enable(vio);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot enable VIO\n");
+
+	ret = regulator_enable(vana);
+	if (ret) {
+		dev_err(dev, "cannot prepare VANA: %d\n", ret);
+		goto disable_vio;
+	}
+
+	dev_info(dev, "stage 1: VIO and VANA source prepared\n");
+	if (stage < 2)
+		goto disable_vana;
+
+	if (vana_enable) {
+		DECLARE_BITMAP(values, BITS_PER_TYPE(long));
+
+		bitmap_fill(values, vana_enable->ndescs);
+		gpiod_multi_set_value_cansleep(vana_enable, values);
+	}
+	usleep_range(5000, 6000);
+	dev_info(dev, "stage 2: VANA physically enabled\n");
+	if (stage < 3)
+		goto disable_vana_gpio;
+
+	ret = regulator_enable(vdig);
+	if (ret) {
+		dev_err(dev, "cannot enable VDIG: %d\n", ret);
+		goto disable_vana_gpio;
+	}
+	usleep_range(5000, 6000);
+	dev_info(dev, "stage 3: VDIG enabled after VANA\n");
+	if (stage < 4)
+		goto disable_vdig;
+
+	ret = clk_prepare_enable(mclk);
+	if (ret) {
+		dev_err(dev, "cannot enable MCLK: %d\n", ret);
+		goto disable_vdig;
+	}
+	usleep_range(1000, 2000);
+	dev_info(dev, "stage 4: MCLK running\n");
+	if (stage < 5)
+		goto hold_clk;
+
+	gpiod_set_value_cansleep(reset, 0);
+	usleep_range(10000, 11000);
+
+	dev_info(dev, "slot powered, MCLK at %lu Hz, scanning bus\n",
+		 clk_get_rate(mclk));
+	hotdog_cam_scan_bus(client);
+
+	gpiod_set_value_cansleep(reset, 1);
+hold_clk:
+	clk_disable_unprepare(mclk);
+disable_vdig:
+	regulator_disable(vdig);
+disable_vana_gpio:
+	if (vana_enable) {
+		DECLARE_BITMAP(values, BITS_PER_TYPE(long));
+
+		bitmap_zero(values, vana_enable->ndescs);
+		gpiod_multi_set_value_cansleep(vana_enable, values);
+	}
+disable_vana:
+	regulator_disable(vana);
+disable_vio:
+	regulator_disable(vio);
+
+	/*
+	 * Nothing is left bound: the point is the log line above, and leaving
+	 * the address claimed would only get in the way of a real sensor node.
+	 */
+	return ret ? ret : -ENODEV;
+}
+
+static const struct of_device_id hotdog_cam_scan_of_match[] = {
+	{ .compatible = "oneplus,hotdog-camera-scan" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hotdog_cam_scan_of_match);
+
+static struct i2c_driver hotdog_cam_scan_driver = {
+	.driver = {
+		.name = "hotdog-cam-scan",
+		.of_match_table = hotdog_cam_scan_of_match,
+	},
+	.probe = hotdog_cam_scan_probe,
+};
+module_i2c_driver(hotdog_cam_scan_driver);
+
+MODULE_DESCRIPTION("OnePlus 7T Pro camera slot identification aid");
+MODULE_LICENSE("GPL");
