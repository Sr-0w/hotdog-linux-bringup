+	if (start) {
+		start_cmd.port_id = pseudo_port_id;
+		start_cmd.timing = 1;
+		packet = (struct apr_pkt *)&start_cmd;
+		packet_size = sizeof(start_cmd);
+		opcode = AFE_PSEUDOPORT_CMD_START;
+	} else {
+		stop_cmd.port_id = pseudo_port_id;
