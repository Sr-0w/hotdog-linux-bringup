+	ret = regulator_bulk_enable(ARRAY_SIZE(samsung_oneplus_dsc_supplies),
+				    ctx->supplies);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+	msleep(20);
