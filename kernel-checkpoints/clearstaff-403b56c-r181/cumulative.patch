+title: OnePlus hotdog Elliptic ultrasonic proximity engine
+
+maintainers:
+  - Robin Snyders <robin@snyders.xyz>
+
+description:
+  The OnePlus 7T Pro uses an Elliptic Labs engine in the audio DSP for
+  proximity sensing. The AP driver is a child of the Qualcomm Q6 AFE service
+  because it sends vendor AFE parameters and consumes asynchronous AFE events.
+
+properties:
+  compatible:
+    const: oneplus,hotdog-elliptic-ultrasound
+
+required:
+  - compatible
+
+additionalProperties: false
+
+examples:
+  - |
+    apr-service {
+        elliptic-ultrasound {
+            compatible = "oneplus,hotdog-elliptic-ultrasound";
+        };
+    };
