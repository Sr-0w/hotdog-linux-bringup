diff --git a/Documentation/devicetree/bindings/media/oneplus,hotdog-popup-motor.yaml b/Documentation/devicetree/bindings/media/oneplus,hotdog-popup-motor.yaml
new file mode 100644
index 000000000..196bc562c
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/oneplus,hotdog-popup-motor.yaml
@@ -0,0 +1,78 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/oneplus,hotdog-popup-motor.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OnePlus hotdog pop-up camera stepper motor
+
+maintainers:
+  - Sr-0w <Sr-0w@users.noreply.github.com>
+
+description: |
+  The OnePlus 7T Pro uses a DRV8834 stepper controller and two Hall effect
+  sensors to raise and lower its front camera. This binding initially exposes
+  the board-specific resources needed for bounded mechanism bring-up.
+
+properties:
+  compatible:
+    const: oneplus,hotdog-popup-motor
+
+  boost-enable-gpios:
+    maxItems: 1
+
+  direction-gpios:
+    maxItems: 1
+
+  mode1-gpios:
+    maxItems: 1
+
+  sleep-gpios:
+    maxItems: 1
+
+  step-gpios:
+    maxItems: 1
+
+  io-channels:
+    minItems: 2
+    maxItems: 2
+
+  io-channel-names:
+    items:
+      - const: hall-up
+      - const: hall-down
+
+  pinctrl-names:
+    items:
+      - const: default
+
+  pinctrl-0: true
+
+required:
+  - compatible
+  - boost-enable-gpios
+  - direction-gpios
+  - mode1-gpios
+  - sleep-gpios
+  - step-gpios
+  - io-channels
+  - io-channel-names
+  - pinctrl-names
+  - pinctrl-0
+
+additionalProperties: false
+
+examples:
+  - |
+    camera-popup {
+        compatible = "oneplus,hotdog-popup-motor";
+        boost-enable-gpios = <&pmic_gpio 12 0>;
+        direction-gpios = <&pmic_gpio 11 0>;
+        mode1-gpios = <&pmic_gpio 8 0>;
+        sleep-gpios = <&pmic_gpio 10 0>;
+        step-gpios = <&pmic_gpio 10 0>;
+        io-channels = <&hall_up>, <&hall_down>;
+        io-channel-names = "hall-up", "hall-down";
+        pinctrl-names = "default";
+        pinctrl-0 = <&motor_default>;
+    };
diff --git a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
index 77a4b0438..dbb7cdc88 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
@@ -75,6 +75,21 @@ volume-down {
 		};
 	};
 
+	camera_popup: camera-popup {
+		compatible = "oneplus,hotdog-popup-motor";
+		boost-enable-gpios = <&pm8150b_gpios 12 GPIO_ACTIVE_HIGH>;
+		direction-gpios = <&pm8150l_gpios 11 GPIO_ACTIVE_HIGH>;
+		mode1-gpios = <&pm8150l_gpios 8 GPIO_ACTIVE_HIGH>;
+		sleep-gpios = <&pm8150_gpios 10 GPIO_ACTIVE_HIGH>;
+		step-gpios = <&pm8150l_gpios 10 GPIO_ACTIVE_HIGH>;
+		io-channels = <&hall_up>, <&hall_down>;
+		io-channel-names = "hall-up", "hall-down";
+		pinctrl-names = "default";
+		pinctrl-0 = <&motor_sleep_default>, <&motor_mode1_default>,
+			    <&motor_direction_default>, <&motor_step_default>,
+			    <&motor_mode0_high_z>, <&motor_boost_default>;
+	};
+
 	memory@80000000 {
 		reg = <0 0x80000000 0 0x3bb00000>;
 	};
@@ -204,6 +219,14 @@ __symbols__ {
 };
 
 &pm8150_gpios {
+	motor_sleep_default: motor-sleep-default-state {
+		pins = "gpio10";
+		function = "normal";
+		power-source = <0>;
+		output-low;
+		input-disable;
+	};
+
 	volume_up_state: volume-up-state {
 		pins = "gpio6";
 		function = "normal";
@@ -223,6 +246,23 @@ volume_down_state: volume-down-state {
 	};
 };
 
+&pm8150b_gpios {
+	motor_mode0_high_z: motor-mode0-high-z-state {
+		pins = "gpio5";
+		function = "normal";
+		power-source = <0>;
+		bias-high-impedance;
+	};
+
+	motor_boost_default: motor-boost-default-state {
+		pins = "gpio12";
+		function = "normal";
+		power-source = <0>;
+		output-low;
+		input-disable;
+	};
+};
+
 &pm8150l_gpios {
 	cam0_custom2_default: cam0-custom2-default-state {
 		pins = "gpio1";
@@ -231,6 +271,30 @@ cam0_custom2_default: cam0-custom2-default-state {
 		output-low;
 		input-disable;
 	};
+
+	motor_mode1_default: motor-mode1-default-state {
+		pins = "gpio8";
+		function = "normal";
+		power-source = <0>;
+		output-low;
+		input-disable;
+	};
+
+	motor_step_default: motor-step-default-state {
+		pins = "gpio10";
+		function = "normal";
+		power-source = <0>;
+		output-low;
+		input-disable;
+	};
+
+	motor_direction_default: motor-direction-default-state {
+		pins = "gpio11";
+		function = "normal";
+		power-source = <0>;
+		output-low;
+		input-disable;
+	};
 };
 
 &tlmm {
@@ -409,6 +473,7 @@ &i2c1 {
 	hall_up: magnetometer@c {
 		compatible = "magnachip,mxm1120";
 		reg = <0x0c>;
+		#io-channel-cells = <0>;
 		label = "camera-popup-up";
 		vdd-supply = <&vreg_l7c_3p0>;
 		vio-supply = <&vreg_l8c_1p8>;
@@ -417,6 +482,7 @@ hall_up: magnetometer@c {
 	hall_down: magnetometer@d {
 		compatible = "magnachip,mxm1120";
 		reg = <0x0d>;
+		#io-channel-cells = <0>;
 		label = "camera-popup-down";
 		vdd-supply = <&vreg_l7c_3p0>;
 		vio-supply = <&vreg_l8c_1p8>;
diff --git a/drivers/media/platform/qcom/Kconfig b/drivers/media/platform/qcom/Kconfig
index 4f4d3a68e..a0e2170d6 100644
--- a/drivers/media/platform/qcom/Kconfig
+++ b/drivers/media/platform/qcom/Kconfig
@@ -2,6 +2,14 @@
 
 comment "Qualcomm media platform drivers"
 
+config VIDEO_QCOM_HOTDOG_POPUP
+	tristate "OnePlus hotdog pop-up camera motor bring-up"
+	depends on IIO && GPIOLIB
+	help
+	  Enable the bounded bring-up driver for the OnePlus 7T Pro pop-up
