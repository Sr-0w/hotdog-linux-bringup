From 6986f11ebf856a146b1766087e7a8870a5f9cb61 Mon Sep 17 00:00:00 2001
From: Sr-0w <Sr-0w@users.noreply.github.com>
Date: Sun, 9 Aug 2026 17:54:41 +0200
Subject: [PATCH] media: i2c: add Sony IMX586 main camera

---
 .../boot/dts/qcom/sm8150-oneplus-hotdog.dts   |   31 +-
 drivers/media/i2c/Kconfig                     |   11 +
 drivers/media/i2c/Makefile                    |    1 +
 drivers/media/i2c/imx586.c                    | 1419 +++++++++++++++++
 4 files changed, 1457 insertions(+), 5 deletions(-)
 create mode 100644 drivers/media/i2c/imx586.c

diff --git a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
index f667a623c214..9e4ba7edbb0f 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
@@ -12,6 +12,7 @@
 #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
+#include <dt-bindings/media/video-interfaces.h>
 #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
 #include <dt-bindings/sound/qcom,q6afe.h>
 #include <dt-bindings/sound/qcom,q6asm.h>
@@ -931,9 +932,12 @@ s5k3m5_ep: endpoint {
 };
 
 &cci0_i2c1 {
-	camera-scan@7f {
-		compatible = "oneplus,hotdog-camera-scan";
-		reg = <0x7f>;
+	/* Main 48 MP rear camera, identified on hardware as Sony IMX586. */
+	camera@1a {
+		compatible = "sony,imx586";
+		reg = <0x1a>;
+		orientation = <1>;
+		rotation = <90>;
 
 		clocks = <&camcc CAM_CC_MCLK1_CLK>;
 		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
@@ -947,14 +951,21 @@ camera-scan@7f {
 		vana-enable-gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>;
 		custom1-gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
 		custom2-gpios = <&pm8150l_gpios 1 GPIO_ACTIVE_HIGH>;
-		oneplus,imx586-power-sequence;
-
 		pinctrl-names = "default";
 		pinctrl-0 = <&cam_mclk1_default>,
 			    <&cam0_vana_default>,
 			    <&cam0_custom1_default>,
 			    <&cam0_custom2_default>,
 			    <&cam0_reset_default>;
+
+		port {
+			imx586_ep: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+				data-lanes = <0 1 2>;
+				link-frequencies = /bits/ 64 <698395833>;
+				remote-endpoint = <&csiphy1_ep>;
+			};
+		};
 	};
 };
 
@@ -1022,6 +1033,16 @@ csiphy0_ep: endpoint {
 				remote-endpoint = <&s5k3m5_ep>;
 			};
 		};
+
+		port@1 {
+			reg = <1>;
+
+			csiphy1_ep: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+				data-lanes = <0 1 2>;
+				remote-endpoint = <&imx586_ep>;
+			};
+		};
 	};
 };
 
diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 4afe704d7f17..97ae3edf21fc 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -255,6 +255,17 @@ config VIDEO_IMX412
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx412.
 
+config VIDEO_IMX586
+	tristate "Sony IMX586 sensor support"
+	depends on OF_GPIO
+	help
+	  This is a Video4Linux2 sensor driver for the Sony IMX586
+	  48 megapixel camera sensor. It supports raw Bayer capture,
+	  exposure and analogue gain controls over a MIPI C-PHY link.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx586.
+
 config VIDEO_IMX415
 	tristate "Sony IMX415 sensor support"
 	depends on OF_GPIO
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index a0f0a7904e2a..2e65209f0e6c 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -58,6 +58,7 @@ obj-$(CONFIG_VIDEO_IMX334) += imx334.o
 obj-$(CONFIG_VIDEO_IMX335) += imx335.o
 obj-$(CONFIG_VIDEO_IMX355) += imx355.o
 obj-$(CONFIG_VIDEO_IMX412) += imx412.o
+obj-$(CONFIG_VIDEO_IMX586) += imx586.o
 obj-$(CONFIG_VIDEO_IMX415) += imx415.o
 obj-$(CONFIG_VIDEO_IR_I2C) += ir-kbd-i2c.o
 obj-$(CONFIG_VIDEO_ISL7998X) += isl7998x.o
