+/**
+ * imx586_power_on() - Sensor power on sequence
+ * @dev: pointer to i2c device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx586 *imx586 = to_imx586(sd);
+	int ret;
+
+	ret = regulator_set_voltage(imx586->vana, IMX586_VANA_MIN_UV,
+				    IMX586_VANA_MAX_UV);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set VANA voltage\n");
+
+	ret = regulator_enable(imx586->vana);
+	if (ret)
+		goto error_vana_voltage;
+
+	gpiod_set_value_cansleep(imx586->vana_enable_gpio, 1);
+	usleep_range(1000, 2000);
+
+	gpiod_set_value_cansleep(imx586->custom1_gpio, 1);
+
+	ret = regulator_set_load(imx586->vdig, IMX586_VDIG_LOAD_UA);
+	if (ret)
+		goto error_custom1;
+
+	ret = regulator_enable(imx586->vdig);
+	if (ret)
+		goto error_vdig_load;
+	usleep_range(1000, 2000);
+
+	gpiod_set_value_cansleep(imx586->custom2_gpio, 1);
+
+	ret = regulator_enable(imx586->vio);
+	if (ret)
+		goto error_custom2;
+	usleep_range(1000, 2000);
+
+	ret = clk_prepare_enable(imx586->inclk);
+	if (ret) {
+		dev_err(imx586->dev, "failed to enable input clock\n");
+		goto error_vio;
+	}
+
+	usleep_range(1000, 1200);
+	gpiod_set_value_cansleep(imx586->reset_gpio, 0);
+	usleep_range(1000, 2000);
+
+	return 0;
+
+error_vio:
+	regulator_disable(imx586->vio);
+error_custom2:
+	gpiod_set_value_cansleep(imx586->custom2_gpio, 0);
+	regulator_disable(imx586->vdig);
+error_vdig_load:
+	regulator_set_load(imx586->vdig, 0);
+error_custom1:
+	gpiod_set_value_cansleep(imx586->custom1_gpio, 0);
+	gpiod_set_value_cansleep(imx586->vana_enable_gpio, 0);
+	regulator_disable(imx586->vana);
+error_vana_voltage:
+	regulator_set_voltage(imx586->vana, 0, IMX586_VANA_MAX_UV);
+
+	return ret;
+}
+
+/**
+ * imx586_power_off() - Sensor power off sequence
+ * @dev: pointer to i2c device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx586 *imx586 = to_imx586(sd);
+
+	gpiod_set_value_cansleep(imx586->reset_gpio, 1);
+	clk_disable_unprepare(imx586->inclk);
+	regulator_disable(imx586->vio);
+	gpiod_set_value_cansleep(imx586->custom2_gpio, 0);
+	regulator_disable(imx586->vdig);
+	regulator_set_load(imx586->vdig, 0);
+	gpiod_set_value_cansleep(imx586->custom1_gpio, 0);
+	gpiod_set_value_cansleep(imx586->vana_enable_gpio, 0);
+	regulator_disable(imx586->vana);
+	regulator_set_voltage(imx586->vana, 0, IMX586_VANA_MAX_UV);
+
+	return 0;
+}
+
+/**
+ * imx586_init_controls() - Initialize sensor subdevice controls
+ * @imx586: pointer to imx586 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_init_controls(struct imx586 *imx586)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &imx586->ctrl_handler;
+	const struct imx586_mode *mode = imx586->cur_mode;
+	u32 lpfr;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 6);
+	if (ret)
+		return ret;
+
+	/* Serialize controls with sensor device */
+	ctrl_hdlr->lock = &imx586->mutex;
+
+	/* Initialize exposure and gain */
+	lpfr = mode->vblank + mode->height;
+	imx586->exp_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					     &imx586_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX586_EXPOSURE_MIN,
+					     lpfr - IMX586_EXPOSURE_OFFSET,
+					     IMX586_EXPOSURE_STEP,
+					     IMX586_EXPOSURE_DEFAULT);
+
+	imx586->again_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					       &imx586_ctrl_ops,
+					       V4L2_CID_ANALOGUE_GAIN,
+					       IMX586_AGAIN_MIN,
+					       IMX586_AGAIN_MAX,
+					       IMX586_AGAIN_STEP,
+					       IMX586_AGAIN_DEFAULT);
+
+	v4l2_ctrl_cluster(2, &imx586->exp_ctrl);
+
+	imx586->vblank_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+						&imx586_ctrl_ops,
+						V4L2_CID_VBLANK,
+						mode->vblank_min,
+						mode->vblank_max,
+						1, mode->vblank);
+
+	/* Read only controls */
+	imx586->pclk_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					      &imx586_ctrl_ops,
+					      V4L2_CID_PIXEL_RATE,
+					      mode->pclk, mode->pclk,
+					      1, mode->pclk);
+
+	imx586->link_freq_ctrl = v4l2_ctrl_new_int_menu(ctrl_hdlr,
+							&imx586_ctrl_ops,
+							V4L2_CID_LINK_FREQ,
+							ARRAY_SIZE(link_freq) -
+							1,
+							mode->link_freq_idx,
+							link_freq);
+	if (imx586->link_freq_ctrl)
+		imx586->link_freq_ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx586->hblank_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+						&imx586_ctrl_ops,
+						V4L2_CID_HBLANK,
+						IMX586_REG_MIN,
+						IMX586_REG_MAX,
+						1, mode->hblank);
+	if (imx586->hblank_ctrl)
+		imx586->hblank_ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	if (ctrl_hdlr->error) {
+		dev_err(imx586->dev, "control init failed: %d\n",
+			ctrl_hdlr->error);
+		v4l2_ctrl_handler_free(ctrl_hdlr);
+		return ctrl_hdlr->error;
+	}
+
+	imx586->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+}
+
+/**
+ * imx586_probe() - I2C client device binding
+ * @client: pointer to i2c client device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_probe(struct i2c_client *client)
+{
+	struct imx586 *imx586;
+	const char *name;
+	int ret;
+
+	imx586 = devm_kzalloc(&client->dev, sizeof(*imx586), GFP_KERNEL);
+	if (!imx586)
+		return -ENOMEM;
+
+	imx586->dev = &client->dev;
+	name = device_get_match_data(&client->dev);
+	if (!name)
+		return -ENODEV;
+
+	/* Initialize subdev */
+	v4l2_i2c_subdev_init(&imx586->sd, client, &imx586_subdev_ops);
+	imx586->sd.internal_ops = &imx586_internal_ops;
+
+	ret = imx586_parse_hw_config(imx586);
+	if (ret) {
+		dev_err(imx586->dev, "HW configuration is not supported\n");
+		return ret;
+	}
+
+	mutex_init(&imx586->mutex);
+
+	ret = imx586_power_on(imx586->dev);
+	if (ret) {
+		dev_err(imx586->dev, "failed to power-on the sensor\n");
+		goto error_mutex_destroy;
+	}
+
+	/* Check module identity */
+	ret = imx586_detect(imx586);
+	if (ret) {
+		dev_err(imx586->dev, "failed to find sensor: %d\n", ret);
+		goto error_power_off;
+	}
+
+	/* Set default mode to max resolution */
+	imx586->cur_mode = &supported_mode;
+	imx586->vblank = imx586->cur_mode->vblank;
+
+	ret = imx586_init_controls(imx586);
+	if (ret) {
+		dev_err(imx586->dev, "failed to init controls: %d\n", ret);
+		goto error_power_off;
+	}
+
+	/* Initialize subdev */
+	imx586->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx586->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	v4l2_i2c_subdev_set_name(&imx586->sd, client, name, NULL);
+
+	/* Initialize source pad */
+	imx586->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&imx586->sd.entity, 1, &imx586->pad);
+	if (ret) {
+		dev_err(imx586->dev, "failed to init entity pads: %d\n", ret);
+		goto error_handler_free;
+	}
+
+	ret = v4l2_async_register_subdev_sensor(&imx586->sd);
+	if (ret < 0) {
+		dev_err(imx586->dev,
+			"failed to register async subdev: %d\n", ret);
+		goto error_media_entity;
+	}
+
+	pm_runtime_set_active(imx586->dev);
+	pm_runtime_enable(imx586->dev);
+	pm_runtime_idle(imx586->dev);
+
+	return 0;
+
+error_media_entity:
+	media_entity_cleanup(&imx586->sd.entity);
+error_handler_free:
+	v4l2_ctrl_handler_free(imx586->sd.ctrl_handler);
+error_power_off:
+	imx586_power_off(imx586->dev);
+error_mutex_destroy:
+	mutex_destroy(&imx586->mutex);
+
+	return ret;
+}
+
+/**
+ * imx586_remove() - I2C client device unbinding
+ * @client: pointer to I2C client device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static void imx586_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx586 *imx586 = to_imx586(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		imx586_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+
+	mutex_destroy(&imx586->mutex);
+}
+
+static const struct dev_pm_ops imx586_pm_ops = {
+	SET_RUNTIME_PM_OPS(imx586_power_off, imx586_power_on, NULL)
+};
+
+static const struct of_device_id imx586_of_match[] = {
+	{ .compatible = "sony,imx586", .data = "imx586" },
+	{ }
+};
+
+MODULE_DEVICE_TABLE(of, imx586_of_match);
+
+static struct i2c_driver imx586_driver = {
+	.probe = imx586_probe,
+	.remove = imx586_remove,
+	.driver = {
+		.name = "imx586",
+		.pm = &imx586_pm_ops,
+		.of_match_table = imx586_of_match,
+	},
+};
+
+module_i2c_driver(imx586_driver);
+
+MODULE_DESCRIPTION("Sony IMX586 sensor driver");
+MODULE_LICENSE("GPL");
