+/* Supported sensor mode configurations */
+static const struct imx586_mode supported_mode = {
+	.width = 4000,
+	.height = 3000,
+	.hblank = 3872,
+	.vblank = 66,
+	.vblank_min = 57,
+	.vblank_max = 62535,
+	.pclk = 478900000,
+	.link_freq_idx = 0,
+	.code = MEDIA_BUS_FMT_SRGGB10_1X10,
+	.reg_list = {
+		.num_of_regs = ARRAY_SIZE(mode_4000x3000_regs),
+		.regs = mode_4000x3000_regs,
+	},
+};
+
+/**
+ * to_imx586() - imx586 V4L2 sub-device to imx586 device.
+ * @subdev: pointer to imx586 V4L2 sub-device
+ *
+ * Return: pointer to imx586 device
+ */
+static inline struct imx586 *to_imx586(struct v4l2_subdev *subdev)
+{
+	return container_of(subdev, struct imx586, sd);
+}
+
+/**
+ * imx586_read_reg() - Read registers.
+ * @imx586: pointer to imx586 device
+ * @reg: register address
+ * @len: length of bytes to read. Max supported bytes is 4
+ * @val: pointer to register value to be filled.
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_read_reg(struct imx586 *imx586, u16 reg, u32 len, u32 *val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&imx586->sd);
+	struct i2c_msg msgs[2] = {0};
+	u8 addr_buf[2] = {0};
+	u8 data_buf[4] = {0};
+	int ret;
+
+	if (WARN_ON(len > 4))
+		return -EINVAL;
+
+	put_unaligned_be16(reg, addr_buf);
+
+	/* Write register address */
+	msgs[0].addr = client->addr;
+	msgs[0].flags = 0;
+	msgs[0].len = ARRAY_SIZE(addr_buf);
+	msgs[0].buf = addr_buf;
+
+	/* Read data from register */
+	msgs[1].addr = client->addr;
+	msgs[1].flags = I2C_M_RD;
+	msgs[1].len = len;
+	msgs[1].buf = &data_buf[4 - len];
+
+	ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+	if (ret != ARRAY_SIZE(msgs))
+		return -EIO;
+
+	*val = get_unaligned_be32(data_buf);
+
+	return 0;
+}
+
+/**
+ * imx586_write_reg() - Write register
+ * @imx586: pointer to imx586 device
+ * @reg: register address
+ * @len: length of bytes. Max supported bytes is 4
+ * @val: register value
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_write_reg(struct imx586 *imx586, u16 reg, u32 len, u32 val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&imx586->sd);
+	u8 buf[6] = {0};
+
+	if (WARN_ON(len > 4))
+		return -EINVAL;
+
+	put_unaligned_be16(reg, buf);
+	put_unaligned_be32(val << (8 * (4 - len)), buf + 2);
+	if (i2c_master_send(client, buf, len + 2) != len + 2)
+		return -EIO;
+
+	return 0;
+}
+
+/**
+ * imx586_write_regs() - Write a list of registers
+ * @imx586: pointer to imx586 device
+ * @regs: list of registers to be written
+ * @len: length of registers array
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_write_regs(struct imx586 *imx586,
+			     const struct imx586_reg *regs, u32 len)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < len; i++) {
+		ret = imx586_write_reg(imx586, regs[i].address, 1, regs[i].val);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/**
+ * imx586_update_controls() - Update control ranges based on streaming mode
+ * @imx586: pointer to imx586 device
+ * @mode: pointer to imx586_mode sensor mode
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_update_controls(struct imx586 *imx586,
+				  const struct imx586_mode *mode)
+{
+	int ret;
+
+	ret = __v4l2_ctrl_s_ctrl(imx586->link_freq_ctrl, mode->link_freq_idx);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl(imx586->hblank_ctrl, mode->hblank);
+	if (ret)
+		return ret;
+
+	return __v4l2_ctrl_modify_range(imx586->vblank_ctrl, mode->vblank_min,
+					mode->vblank_max, 1, mode->vblank);
+}
+
+/**
+ * imx586_update_exp_gain() - Set updated exposure and gain
+ * @imx586: pointer to imx586 device
+ * @exposure: updated exposure value
+ * @gain: updated analog gain value
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_update_exp_gain(struct imx586 *imx586, u32 exposure, u32 gain)
+{
+	u32 lpfr;
+	int ret;
+
+	lpfr = imx586->vblank + imx586->cur_mode->height;
+
+	dev_dbg(imx586->dev, "Set exp %u, analog gain %u, lpfr %u\n",
+		exposure, gain, lpfr);
+
+	ret = imx586_write_reg(imx586, IMX586_REG_HOLD, 1, 1);
+	if (ret)
+		return ret;
+
+	ret = imx586_write_reg(imx586, IMX586_REG_LPFR, 2, lpfr);
+	if (ret)
+		goto error_release_group_hold;
+
+	ret = imx586_write_reg(imx586, IMX586_REG_EXPOSURE_CIT, 2, exposure);
+	if (ret)
+		goto error_release_group_hold;
+
+	ret = imx586_write_reg(imx586, IMX586_REG_AGAIN, 2, gain);
+
+error_release_group_hold:
+	imx586_write_reg(imx586, IMX586_REG_HOLD, 1, 0);
+
+	return ret;
+}
+
+/**
+ * imx586_set_ctrl() - Set subdevice control
+ * @ctrl: pointer to v4l2_ctrl structure
+ *
+ * Supported controls:
+ * - V4L2_CID_VBLANK
+ * - cluster controls:
+ *   - V4L2_CID_ANALOGUE_GAIN
+ *   - V4L2_CID_EXPOSURE
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx586 *imx586 =
+		container_of(ctrl->handler, struct imx586, ctrl_handler);
+	u32 analog_gain;
+	u32 exposure;
+	int ret;
+
+	switch (ctrl->id) {
+	case V4L2_CID_VBLANK:
+		imx586->vblank = imx586->vblank_ctrl->val;
+
+		dev_dbg(imx586->dev, "Received vblank %u, new lpfr %u\n",
+			imx586->vblank,
+			imx586->vblank + imx586->cur_mode->height);
+
+		ret = __v4l2_ctrl_modify_range(imx586->exp_ctrl,
+					       IMX586_EXPOSURE_MIN,
+					       imx586->vblank +
+					       imx586->cur_mode->height -
+					       IMX586_EXPOSURE_OFFSET,
+					       1, IMX586_EXPOSURE_DEFAULT);
+		break;
+	case V4L2_CID_EXPOSURE:
+		/* Set controls only if sensor is in power on state */
+		if (!pm_runtime_get_if_in_use(imx586->dev))
+			return 0;
+
+		exposure = ctrl->val;
+		analog_gain = imx586->again_ctrl->val;
+
+		dev_dbg(imx586->dev, "Received exp %u, analog gain %u\n",
+			exposure, analog_gain);
+
+		ret = imx586_update_exp_gain(imx586, exposure, analog_gain);
+
+		pm_runtime_put(imx586->dev);
+
+		break;
+	default:
+		dev_err(imx586->dev, "Invalid control %d\n", ctrl->id);
+		ret = -EINVAL;
+	}
+
+	return ret;
+}
+
+/* V4l2 subdevice control ops*/
+static const struct v4l2_ctrl_ops imx586_ctrl_ops = {
+	.s_ctrl = imx586_set_ctrl,
+};
+
+/**
+ * imx586_enum_mbus_code() - Enumerate V4L2 sub-device mbus codes
+ * @sd: pointer to imx586 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @code: V4L2 sub-device code enumeration need to be filled
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = supported_mode.code;
+
+	return 0;
+}
+
+/**
+ * imx586_enum_frame_size() - Enumerate V4L2 sub-device frame sizes
+ * @sd: pointer to imx586 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @fsize: V4L2 sub-device size enumeration need to be filled
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fsize)
+{
+	if (fsize->index > 0)
+		return -EINVAL;
+
+	if (fsize->code != supported_mode.code)
+		return -EINVAL;
+
+	fsize->min_width = supported_mode.width;
+	fsize->max_width = fsize->min_width;
+	fsize->min_height = supported_mode.height;
+	fsize->max_height = fsize->min_height;
+
+	return 0;
+}
+
+/**
+ * imx586_fill_pad_format() - Fill subdevice pad format
+ *                            from selected sensor mode
+ * @imx586: pointer to imx586 device
+ * @mode: pointer to imx586_mode sensor mode
+ * @fmt: V4L2 sub-device format need to be filled
+ */
+static void imx586_fill_pad_format(struct imx586 *imx586,
+				   const struct imx586_mode *mode,
+				   struct v4l2_subdev_format *fmt)
+{
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.code = mode->code;
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.colorspace = V4L2_COLORSPACE_RAW;
+	fmt->format.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->format.quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->format.xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+/**
+ * imx586_get_pad_format() - Get subdevice pad format
+ * @sd: pointer to imx586 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @fmt: V4L2 sub-device format need to be set
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_get_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx586 *imx586 = to_imx586(sd);
+
+	mutex_lock(&imx586->mutex);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		struct v4l2_mbus_framefmt *framefmt;
+
+		framefmt = v4l2_subdev_state_get_format(sd_state, fmt->pad);
+		fmt->format = *framefmt;
+	} else {
+		imx586_fill_pad_format(imx586, imx586->cur_mode, fmt);
+	}
+
+	mutex_unlock(&imx586->mutex);
+
+	return 0;
+}
+
+/**
+ * imx586_set_pad_format() - Set subdevice pad format
+ * @sd: pointer to imx586 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @fmt: V4L2 sub-device format need to be set
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx586 *imx586 = to_imx586(sd);
+	const struct imx586_mode *mode;
+	int ret = 0;
+
+	mutex_lock(&imx586->mutex);
+
+	mode = &supported_mode;
+	imx586_fill_pad_format(imx586, mode, fmt);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		struct v4l2_mbus_framefmt *framefmt;
+
+		framefmt = v4l2_subdev_state_get_format(sd_state, fmt->pad);
+		*framefmt = fmt->format;
+	} else {
+		ret = imx586_update_controls(imx586, mode);
+		if (!ret)
+			imx586->cur_mode = mode;
+	}
+
+	mutex_unlock(&imx586->mutex);
+
+	return ret;
+}
+
+/**
+ * imx586_init_state() - Initialize sub-device state
+ * @sd: pointer to imx586 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *sd_state)
+{
+	struct imx586 *imx586 = to_imx586(sd);
+	struct v4l2_subdev_format fmt = { 0 };
+
+	fmt.which = sd_state ? V4L2_SUBDEV_FORMAT_TRY : V4L2_SUBDEV_FORMAT_ACTIVE;
+	imx586_fill_pad_format(imx586, &supported_mode, &fmt);
+
+	return imx586_set_pad_format(sd, sd_state, &fmt);
+}
+
+/**
+ * imx586_start_streaming() - Start sensor stream
+ * @imx586: pointer to imx586 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_start_streaming(struct imx586 *imx586)
+{
+	const struct imx586_reg_list *reg_list;
+	int ret;
+
+	ret = imx586_write_regs(imx586, imx586_init_regs,
+				ARRAY_SIZE(imx586_init_regs));
+	if (ret) {
+		dev_err(imx586->dev, "failed to write global registers\n");
+		return ret;
+	}
+
+	/* Write sensor mode registers */
+	reg_list = &imx586->cur_mode->reg_list;
+	ret = imx586_write_regs(imx586, reg_list->regs,
+				reg_list->num_of_regs);
+	if (ret) {
+		dev_err(imx586->dev, "failed to write mode registers\n");
+		return ret;
+	}
+
+	/* Setup handler will write actual exposure and gain */
+	ret =  __v4l2_ctrl_handler_setup(imx586->sd.ctrl_handler);
+	if (ret) {
+		dev_err(imx586->dev, "fail to setup handler\n");
+		return ret;
+	}
+
+	/* Start streaming */
+	ret = imx586_write_reg(imx586, IMX586_REG_MODE_SELECT,
+			       1, IMX586_MODE_STREAMING);
+	if (ret) {
+		dev_err(imx586->dev, "failed to start streaming\n");
+		return ret;
+	}
+
+	dev_info(imx586->dev, "streaming 4000x3000 RAW10 over three-trio C-PHY\n");
+
+	return 0;
+}
+
+/**
+ * imx586_stop_streaming() - Stop sensor stream
+ * @imx586: pointer to imx586 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_stop_streaming(struct imx586 *imx586)
+{
+	return imx586_write_reg(imx586, IMX586_REG_MODE_SELECT,
+				1, IMX586_MODE_STANDBY);
+}
+
+/**
+ * imx586_set_stream() - Enable sensor streaming
+ * @sd: pointer to imx586 subdevice
+ * @enable: set to enable sensor streaming
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_set_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct imx586 *imx586 = to_imx586(sd);
+	int ret;
+
+	mutex_lock(&imx586->mutex);
+
+	if (enable) {
+		ret = pm_runtime_resume_and_get(imx586->dev);
+		if (ret)
+			goto error_unlock;
+
+		ret = imx586_start_streaming(imx586);
+		if (ret)
+			goto error_power_off;
+	} else {
+		imx586_stop_streaming(imx586);
+		pm_runtime_put(imx586->dev);
+	}
+
+	mutex_unlock(&imx586->mutex);
+
+	return 0;
+
+error_power_off:
+	pm_runtime_put(imx586->dev);
+error_unlock:
+	mutex_unlock(&imx586->mutex);
+
+	return ret;
+}
+
+/**
+ * imx586_detect() - Detect imx586 sensor
+ * @imx586: pointer to imx586 device
+ *
+ * Return: 0 if successful, -EIO if sensor id does not match
+ */
+static int imx586_detect(struct imx586 *imx586)
+{
+	int ret;
+	u32 val;
+
+	ret = imx586_read_reg(imx586, IMX586_REG_ID, 2, &val);
+	if (ret)
+		return ret;
+
+	if (val != IMX586_ID) {
+		dev_err(imx586->dev, "chip id mismatch: %x!=%x\n",
+			IMX586_ID, val);
+		return -ENXIO;
+	}
+
+	return 0;
+}
+
+/**
+ * imx586_parse_hw_config() - Parse HW configuration and check if supported
+ * @imx586: pointer to imx586 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_parse_hw_config(struct imx586 *imx586)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(imx586->dev);
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_CPHY
+	};
+	struct fwnode_handle *ep;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	if (!fwnode)
+		return -ENXIO;
+
+	/* The GPIO values are logical; reset is active low in the DT. */
+	imx586->reset_gpio = devm_gpiod_get(imx586->dev, "reset",
+					    GPIOD_OUT_HIGH);
+	if (IS_ERR(imx586->reset_gpio)) {
+		dev_err(imx586->dev, "failed to get reset gpio %ld\n",
+			PTR_ERR(imx586->reset_gpio));
+		return PTR_ERR(imx586->reset_gpio);
+	}
+
+	imx586->vana_enable_gpio = devm_gpiod_get(imx586->dev, "vana-enable",
+						  GPIOD_OUT_LOW);
+	if (IS_ERR(imx586->vana_enable_gpio))
+		return dev_err_probe(imx586->dev,
+				     PTR_ERR(imx586->vana_enable_gpio),
+				     "failed to get VANA enable GPIO\n");
+
+	imx586->custom1_gpio = devm_gpiod_get(imx586->dev, "custom1",
+					      GPIOD_OUT_LOW);
+	if (IS_ERR(imx586->custom1_gpio))
+		return dev_err_probe(imx586->dev, PTR_ERR(imx586->custom1_gpio),
+				     "failed to get CUSTOM_GPIO1\n");
+
+	imx586->custom2_gpio = devm_gpiod_get(imx586->dev, "custom2",
+					      GPIOD_OUT_LOW);
+	if (IS_ERR(imx586->custom2_gpio))
+		return dev_err_probe(imx586->dev, PTR_ERR(imx586->custom2_gpio),
+				     "failed to get CUSTOM_GPIO2\n");
+
+	/* Get sensor input clock */
+	imx586->inclk = devm_clk_get(imx586->dev, NULL);
+	if (IS_ERR(imx586->inclk)) {
+		dev_err(imx586->dev, "could not get inclk\n");
+		return PTR_ERR(imx586->inclk);
+	}
+
+	ret = clk_set_rate(imx586->inclk, IMX586_INCLK_RATE);
+	if (ret)
+		return dev_err_probe(imx586->dev, ret,
+				     "could not set 19.2 MHz input clock\n");
+
+	rate = clk_get_rate(imx586->inclk);
+	if (rate != IMX586_INCLK_RATE) {
+		dev_err(imx586->dev, "inclk frequency mismatch\n");
+		return -EINVAL;
+	}
+
+	imx586->vana = devm_regulator_get(imx586->dev, "vana");
+	if (IS_ERR(imx586->vana))
+		return dev_err_probe(imx586->dev, PTR_ERR(imx586->vana),
+				     "failed to get VANA\n");
+
+	imx586->vdig = devm_regulator_get(imx586->dev, "vdig");
+	if (IS_ERR(imx586->vdig))
+		return dev_err_probe(imx586->dev, PTR_ERR(imx586->vdig),
+				     "failed to get VDIG\n");
+
+	imx586->vio = devm_regulator_get(imx586->dev, "vio");
+	if (IS_ERR(imx586->vio))
+		return dev_err_probe(imx586->dev, PTR_ERR(imx586->vio),
+				     "failed to get VIO\n");
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -ENXIO;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus_type != V4L2_MBUS_CSI2_CPHY) {
+		dev_err(imx586->dev, "endpoint must use C-PHY\n");
+		ret = -EINVAL;
+		goto done_endpoint_free;
+	}
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != IMX586_NUM_DATA_LANES) {
+		dev_err(imx586->dev,
+			"number of CSI2 data lanes %d is not supported\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto done_endpoint_free;
+	}
+
+	if (!bus_cfg.nr_of_link_frequencies) {
+		dev_err(imx586->dev, "no link frequencies defined\n");
+		ret = -EINVAL;
+		goto done_endpoint_free;
+	}
+
+	for (i = 0; i < bus_cfg.nr_of_link_frequencies; i++)
+		if (bus_cfg.link_frequencies[i] == IMX586_LINK_FREQ)
+			goto done_endpoint_free;
+
+	ret = -EINVAL;
+
+done_endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+/* V4l2 subdevice ops */
+static const struct v4l2_subdev_video_ops imx586_video_ops = {
+	.s_stream = imx586_set_stream,
+};
+
+static const struct v4l2_subdev_pad_ops imx586_pad_ops = {
+	.enum_mbus_code = imx586_enum_mbus_code,
+	.enum_frame_size = imx586_enum_frame_size,
+	.get_fmt = imx586_get_pad_format,
+	.set_fmt = imx586_set_pad_format,
+};
+
+static const struct v4l2_subdev_ops imx586_subdev_ops = {
+	.video = &imx586_video_ops,
+	.pad = &imx586_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx586_internal_ops = {
+	.init_state = imx586_init_state,
+};
