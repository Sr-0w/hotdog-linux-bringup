--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -43,34 +43,59 @@
 #endif
 
 /*
- * Persist early direct-entry checkpoints in the unused final page of the
- * hotdog ramoops reservation. Each 32-byte record is independent, and its
- * magic is committed last so a torn write cannot masquerade as a checkpoint.
+ * Commit one guarded checkpoint as a native persistent_ram pmsg record.
+ * R6 imports this zone into /sys/fs/pstore before reusing it. The boot
+ * protocol requires the MMU and D-cache to be off at primary entry; the first
+ * call is additionally guarded by explicit SCTLR checks.
  */
-	.macro	hotdog_ram_stage offset, stage, tag_lo, tag_hi
-	movz	x9, #0xf000
+	.macro	hotdog_pmsg_stage stage
+	movz	x9, #0xeff0
 	movk	x9, #0xa9bf, lsl #16
-	add	x9, x9, #\offset
-	str	wzr, [x9, #0x00]
-	movz	w10, #0x0001
-	movk	w10, #0x0006, lsl #16	// instrumentation build 6.1
-	str	w10, [x9, #0x04]
-	mov	w10, #\stage
-	str	w10, [x9, #0x08]
-	mvn	w10, w10
+	str	wzr, [x9, #0x00]		// invalidate header while updating
+	mov	w10, #16
+	str	w10, [x9, #0x04]		// next write position
+	str	w10, [x9, #0x08]		// valid payload size
+	movz	w10, #0x4448
+	movk	w10, #0x4d50, lsl #16	// little-endian ASCII "HDPM"
 	str	w10, [x9, #0x0c]
-	movz	w10, #\tag_lo
-	movk	w10, #\tag_hi, lsl #16
+	movz	w10, #0x0001
+	movk	w10, #0x0008, lsl #16	// instrumentation build 8.1
 	str	w10, [x9, #0x10]
-	mvn	w10, w10
+	mov	w10, #\stage
 	str	w10, [x9, #0x14]
+	mvn	w10, w10
+	str	w10, [x9, #0x18]
 	dsb	sy
-	movz	w10, #0x5343
-	movk	w10, #0x3631, lsl #16	// little-endian ASCII "CS16"
+	movz	w10, #0x4244
+	movk	w10, #0x4347, lsl #16	// persistent_ram signature "DBGC"
 	str	w10, [x9, #0x00]
 	dsb	sy
 	.endm
 
+/* Draw one large cumulative white block without changing display registers. */
+	.macro	hotdog_fb_stage slot
+	mov	x11, #0x9c000000
+	movz	x12, #0x21, lsl #16
+	add	x12, x12, #0xc, lsl #12	// row 384 at a 5760-byte stride
+	add	x11, x11, x12
+	mov	x17, #(\slot * 640)		// 160 pixels between blocks
+	add	x11, x11, x17
+	movz	w12, #0xffff
+	movk	w12, #0x00ff, lsl #16	// a8r8g8b8 white
+	mov	x13, #112
+.Lhotdog_fb_row\@:
+	mov	x14, #128
+.Lhotdog_fb_pixel\@:
+	str	w12, [x11], #4
+	subs	x14, x14, #1
+	b.ne	.Lhotdog_fb_pixel\@
+	add	x11, x11, #1, lsl #12	// stride - 128 * 4
+	add	x11, x11, #0x480
+	subs	x13, x13, #1
+	b.ne	.Lhotdog_fb_row\@
+	dsb	sy
+	.endm
+
 /*
  * Kernel startup entry point.
  * ---------------------------
@@ -117,8 +142,32 @@
 	 *  x21        primary_entry() .. start_kernel()        FDT pointer passed at boot in x0
 	 */
 SYM_CODE_START(primary_entry)
+	/* Record entry only when the bootloader honored the MMU/cache contract. */
+	mrs	x11, CurrentEL
+	cmp	x11, #CurrentEL_EL2
+	mrs	x12, sctlr_el1
+	b.ne	0f
+	mrs	x12, sctlr_el2
+0:	tbnz	x12, #0, 1f			// SCTLR_ELx.M
+	tbnz	x12, #2, 1f			// SCTLR_ELx.C
+	cmp	x11, #CurrentEL_EL2
+	b.eq	2f
+	hotdog_pmsg_stage 0x11			// entered at EL1
+	hotdog_fb_stage 0
+	b	1f
+2:	hotdog_pmsg_stage 0x12			// entered at EL2
+	hotdog_fb_stage 0
+1:
 	bl	record_mmu_state
+	cbnz	x19, 3f
+	hotdog_pmsg_stage 0x20			// MMU/cache state recorded
+	hotdog_fb_stage 1
+3:
 	bl	preserve_boot_args
+	cbnz	x19, 4f
+	hotdog_pmsg_stage 0x30			// boot arguments preserved
+	hotdog_fb_stage 2
+4:
 
 	adrp	x1, early_init_stack
 	mov	sp, x1
@@ -126,6 +175,10 @@
 	adrp	x0, __pi_init_idmap_pg_dir
 	mov	x1, xzr
 	bl	__pi_create_init_idmap
+	cbnz	x19, 5f
+	hotdog_pmsg_stage 0x40			// initial identity map built
+	hotdog_fb_stage 3
+5:
 
 	/*
 	 * If the page tables have been populated with non-cacheable
@@ -151,10 +204,14 @@
 	blr	x2
 
 1:	mov	x0, x19
+	cbnz	x19, 6f
+	hotdog_pmsg_stage 0x50			// entering init_kernel_el
+	hotdog_fb_stage 4
+6:
 	bl	init_kernel_el			// w0=cpu_boot_mode
 	mov	x20, x0
-	/* init_kernel_el() has established an MMU-off physical access context. */
-	hotdog_ram_stage 0x00, 0x10, 0x4c45, 0x3031	// "EL10"
+	hotdog_pmsg_stage 0x60			// init_kernel_el returned
+	hotdog_fb_stage 5
 
 	/*
 	 * The following calls CPU setup code, see arch/arm64/mm/proc.S for
@@ -163,7 +220,8 @@
 	 * the TCR will have been set.
 	 */
 	bl	__cpu_setup			// initialise processor
-	hotdog_ram_stage 0x20, 0x20, 0x5043, 0x3255	// "CPU2"
+	hotdog_pmsg_stage 0x70			// CPU setup returned
+	hotdog_fb_stage 6
 	b	__primary_switch
 SYM_CODE_END(primary_entry)
 
@@ -543,7 +601,8 @@
 SYM_FUNC_END(__no_granule_support)
 
 SYM_FUNC_START_LOCAL(__primary_switch)
-	hotdog_ram_stage 0x40, 0x30, 0x4d4d, 0x3355	// "MMU3"
