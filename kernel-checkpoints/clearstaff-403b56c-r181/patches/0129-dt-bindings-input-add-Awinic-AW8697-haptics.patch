From 4c2adc8444678c6cdb245042392e5dc61b7530b8 Mon Sep 17 00:00:00 2001
From: Sr-0w <Sr-0w@users.noreply.github.com>
Date: Tue, 11 Aug 2026 07:44:38 +0200
Subject: [PATCH 1/2] dt-bindings: input: add Awinic AW8697 haptics

---
 .../bindings/input/awinic,aw8697.yaml         | 47 +++++++++++++++++++
 1 file changed, 47 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/awinic,aw8697.yaml

diff --git a/Documentation/devicetree/bindings/input/awinic,aw8697.yaml b/Documentation/devicetree/bindings/input/awinic,aw8697.yaml
new file mode 100644
index 000000000..ea70e9ab1
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/awinic,aw8697.yaml
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/awinic,aw8697.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Awinic AW8697 LRA haptics controller
+
+maintainers:
+  - Sr-0w <Sr-0w@users.noreply.github.com>
+
+properties:
+  compatible:
+    const: awinic,aw8697
+
+  reg:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - reset-gpios
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        haptics@5a {
+            compatible = "awinic,aw8697";
+            reg = <0x5a>;
+            interrupts-extended = <&tlmm 24 IRQ_TYPE_EDGE_FALLING>;
+            reset-gpios = <&tlmm 116 GPIO_ACTIVE_LOW>;
+        };
+    };
-- 
