From 89bce65fc22c6ce9833397f406366d0e2d761c9f Mon Sep 17 00:00:00 2001
From: Sr-0w <Sr-0w@users.noreply.github.com>
Date: Wed, 5 Aug 2026 20:20:00 +0200
Subject: [PATCH] ASoC: tfa9874: add read-only silicon probe

The HD1913 production device tree and live I2C reads identify two NXP
TFA9874 amplifiers at 0x34 and 0x35, both reporting full revision 0x0c74.
The existing TFA989x driver targets the incompatible TFA1 register family,
while TFA9874 protection and calibration are handled by the external
Qualcomm ADSP.

Add a separate, deliberately read-only identification driver. Restrict its
regmap to the revision register, declare every register non-writable, accept
only the hardware-validated revision and register no DAI. This establishes a
safe mainline ownership boundary without enabling either amplifier.

Describe both devices without reset GPIOs. The bootloader already leaves the
amplifiers responsive, and the lower amplifier reset is shared with the
active-low FSA4480 enable on GPIO 100. Reset and output control therefore
remain deferred until their coordination and protection path are available.

Signed-off-by: Sr-0w <Sr-0w@users.noreply.github.com>
---
 .../bindings/sound/nxp,tfa9874.yaml           | 47 ++++++++++
 .../boot/dts/qcom/sm8150-oneplus-hotdog.dts   | 12 +++
 sound/soc/codecs/Kconfig                      |  9 ++
 sound/soc/codecs/Makefile                     |  2 +
 sound/soc/codecs/tfa9874.c                    | 96 ++++++++++++++++++++
 5 files changed, 166 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/nxp,tfa9874.yaml
 create mode 100644 sound/soc/codecs/tfa9874.c

diff --git a/Documentation/devicetree/bindings/sound/nxp,tfa9874.yaml b/Documentation/devicetree/bindings/sound/nxp,tfa9874.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/nxp,tfa9874.yaml
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/nxp,tfa9874.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: NXP TFA9874 class-D audio amplifier
+
+maintainers:
+  - Sr-0w <Sr-0w@users.noreply.github.com>
+
+description: |
+  The TFA9874 is a smart class-D speaker amplifier without an internal audio
+  DSP. Speaker protection and calibration can be provided by an external DSP.
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: nxp,tfa9874
+
+  reg:
+    maxItems: 1
+
+  '#sound-dai-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - '#sound-dai-cells'
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        audio-codec@34 {
+            compatible = "nxp,tfa9874";
+            reg = <0x34>;
+            #sound-dai-cells = <0>;
+        };
+    };
diff --git a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
--- a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
@@ -283,6 +283,18 @@ &i2c4 {
 	clock-frequency = <100000>;
 	status = "okay";
 
+	speaker_top: audio-codec@34 {
+		compatible = "nxp,tfa9874";
+		reg = <0x34>;
+		#sound-dai-cells = <0>;
+	};
+
+	speaker_bottom: audio-codec@35 {
+		compatible = "nxp,tfa9874";
+		reg = <0x35>;
+		#sound-dai-cells = <0>;
+	};
+
 	typec-mux@42 {
 		compatible = "fcs,fsa4480";
 		reg = <0x42>;
diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -2091,6 +2091,15 @@ config SND_SOC_TDA7419
 	depends on I2C
 	select REGMAP_I2C
 
+config SND_SOC_TFA9874
+	tristate "NXP TFA9874 amplifier identification"
+	depends on I2C
+	select REGMAP_I2C
+	help
+	  Enable read-only identification of NXP TFA9874 speaker amplifiers.
+	  Output remains disabled until external speaker-protection support is
+	  available.
+
 config SND_SOC_TFA9879
 	tristate "NXP Semiconductors TFA9879 amplifier"
 	depends on I2C
diff --git a/sound/soc/codecs/Makefile b/sound/soc/codecs/Makefile
--- a/sound/soc/codecs/Makefile
+++ b/sound/soc/codecs/Makefile
@@ -313,6 +313,7 @@ snd-soc-tas2781-comlib-y := tas2781-comlib.o
 snd-soc-tas2781-comlib-i2c-y := tas2781-comlib-i2c.o
 snd-soc-tas2781-fmwlib-y := tas2781-fmwlib.o
 snd-soc-tas2781-i2c-y := tas2781-i2c.o
+snd-soc-tfa9874-y := tfa9874.o
 snd-soc-tfa9879-y := tfa9879.o
 snd-soc-tfa989x-y := tfa989x.o
 snd-soc-tlv320adc3xxx-y := tlv320adc3xxx.o
@@ -734,6 +735,7 @@ obj-$(CONFIG_SND_SOC_TAS5805M)	+= snd-soc-tas5805m.o
 obj-$(CONFIG_SND_SOC_TAS6424)	+= snd-soc-tas6424.o
 obj-$(CONFIG_SND_SOC_TDA7419)	+= snd-soc-tda7419.o
 obj-$(CONFIG_SND_SOC_TAS2770) += snd-soc-tas2770.o
+obj-$(CONFIG_SND_SOC_TFA9874)	+= snd-soc-tfa9874.o
 obj-$(CONFIG_SND_SOC_TFA9879)	+= snd-soc-tfa9879.o
 obj-$(CONFIG_SND_SOC_TFA989X)	+= snd-soc-tfa989x.o
 obj-$(CONFIG_SND_SOC_TLV320ADC3XXX)	+= snd-soc-tlv320adc3xxx.o
diff --git a/sound/soc/codecs/tfa9874.c b/sound/soc/codecs/tfa9874.c
new file mode 100644
--- /dev/null
+++ b/sound/soc/codecs/tfa9874.c
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Read-only identification support for the NXP TFA9874 amplifier.
+ *
+ * Output control remains deliberately absent until the external protection
+ * profile and shared reset-line handling are implemented.
+ */
+
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <sound/soc.h>
+
+#define TFA9874_REVISION_REG	0x03
+#define TFA9874_REVISION_0C74	0x0c74
+
+static bool tfa9874_readable_reg(struct device *dev, unsigned int reg)
+{
+	return reg == TFA9874_REVISION_REG;
+}
+
+static bool tfa9874_writeable_reg(struct device *dev, unsigned int reg)
+{
+	return false;
+}
+
+static const struct regmap_config tfa9874_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 16,
+	.val_format_endian = REGMAP_ENDIAN_BIG,
+	.max_register = TFA9874_REVISION_REG,
+	.readable_reg = tfa9874_readable_reg,
+	.writeable_reg = tfa9874_writeable_reg,
+	.cache_type = REGCACHE_NONE,
+};
+
+static const struct snd_soc_component_driver tfa9874_component_driver = {
+	.name = "tfa9874",
+};
+
+static int tfa9874_i2c_probe(struct i2c_client *client)
+{
+	struct regmap *regmap;
+	unsigned int revision;
+	int ret;
+
+	regmap = devm_regmap_init_i2c(client, &tfa9874_regmap_config);
+	if (IS_ERR(regmap))
+		return dev_err_probe(&client->dev, PTR_ERR(regmap),
+				     "failed to allocate register map\n");
+
+	ret = regmap_read(regmap, TFA9874_REVISION_REG, &revision);
+	if (ret)
+		return dev_err_probe(&client->dev, ret,
+				     "failed to read silicon revision\n");
+
+	if (revision != TFA9874_REVISION_0C74) {
+		dev_err(&client->dev, "unsupported silicon revision 0x%04x\n",
+			revision);
+		return -ENODEV;
+	}
+
+	dev_info(&client->dev,
+		 "TFA9874 revision 0x%04x detected; amplifier remains disabled\n",
+		 revision);
+
+	return devm_snd_soc_register_component(&client->dev,
+					       &tfa9874_component_driver,
+					       NULL, 0);
+}
+
+static const struct of_device_id tfa9874_of_match[] = {
+	{ .compatible = "nxp,tfa9874" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, tfa9874_of_match);
+
+static const struct i2c_device_id tfa9874_i2c_id[] = {
+	{ "tfa9874" },
+	{}
+};
+MODULE_DEVICE_TABLE(i2c, tfa9874_i2c_id);
+
+static struct i2c_driver tfa9874_i2c_driver = {
+	.driver = {
+		.name = "tfa9874",
+		.of_match_table = tfa9874_of_match,
+	},
+	.probe = tfa9874_i2c_probe,
+	.id_table = tfa9874_i2c_id,
+};
+module_i2c_driver(tfa9874_i2c_driver);
+
+MODULE_DESCRIPTION("Read-only NXP TFA9874 amplifier identification driver");
+MODULE_AUTHOR("Sr-0w <Sr-0w@users.noreply.github.com>");
+MODULE_LICENSE("GPL");
-- 
