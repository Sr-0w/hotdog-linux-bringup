From 41973bb5c009c263fbd22d7ee623641e0c94c192 Mon Sep 17 00:00:00 2001
From: Sr-0w <Sr-0w@users.noreply.github.com>
Date: Sun, 9 Aug 2026 12:34:00 +0200
Subject: [PATCH] media: s5k3m5 report camera geometry and orientation

---
 arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts |  2 ++
 drivers/media/i2c/s5k3m5.c                         | 14 +++++++++-----
 2 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
index 3cc4fee70e9d..50d7b5bde5da 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
@@ -871,6 +871,8 @@ s5k3m5_vcm: lens@74 {
 	camera@10 {
 		compatible = "samsung,s5k3m5";
 		reg = <0x10>;
+		orientation = <1>;
+		rotation = <90>;
 
 		clocks = <&camcc CAM_CC_MCLK0_CLK>;
 		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
diff --git a/drivers/media/i2c/s5k3m5.c b/drivers/media/i2c/s5k3m5.c
index 565bdca59ed1..6c51f6131cb1 100644
--- a/drivers/media/i2c/s5k3m5.c
+++ b/drivers/media/i2c/s5k3m5.c
@@ -73,6 +73,7 @@ struct s5k3m5_reg_list {
 struct s5k3m5_mode {
 	u32 width;			/* Frame width in pixels */
 	u32 height;			/* Frame height in pixels */
+	struct v4l2_rect crop;		/* Analogue crop before binning */
 	u32 hts;			/* Horizontal timing size */
 	u32 vts;			/* Default vertical timing size */
 	u32 exposure;			/* Default exposure value */
@@ -694,6 +695,7 @@ static const struct s5k3m5_mode s5k3m5_supported_modes[] = {
 	{
 		.width = 4208,
 		.height = 3120,
+		.crop = { 0, 0, 4208, 3120 },
 		.hts = 4848,
 		.vts = 3314,
 		.exposure = 256,
@@ -705,6 +707,7 @@ static const struct s5k3m5_mode s5k3m5_supported_modes[] = {
 	{
 		.width = 2104,
 		.height = 1184,
+		.crop = { 0, 376, 4208, 2368 },
 		.hts = 4928,
 		.vts = 1624,
 		.exposure = 256,
@@ -1047,12 +1050,13 @@ static int s5k3m5_get_selection(struct v4l2_subdev *sd,
 		return -EINVAL;
 
 	switch (sel->target) {
-	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
 	case V4L2_SEL_TGT_CROP_BOUNDS:
-		sel->r.left = 0;
-		sel->r.top = 0;
-		sel->r.width = s5k3m5->mode->width;
-		sel->r.height = s5k3m5->mode->width;
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r = (struct v4l2_rect) { 0, 0, 4208, 3120 };
+		return 0;
+	case V4L2_SEL_TGT_CROP:
+		sel->r = s5k3m5->mode->crop;
 		return 0;
 	default:
 		return -EINVAL;
-- 
2.54.0
