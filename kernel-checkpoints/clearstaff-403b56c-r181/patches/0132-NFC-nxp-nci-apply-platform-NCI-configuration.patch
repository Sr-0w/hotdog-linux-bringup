From dcefccff6475202838ccd0b8651ccee0c34f7a46 Mon Sep 17 00:00:00 2001
From: Robin Snyders <robin@snyders.xyz>
Date: Tue, 11 Aug 2026 23:58:37 +0200
Subject: [PATCH 2/2] NFC: nxp-nci: apply platform NCI configuration

Some NXP controllers require their proprietary extensions to be activated
before board-specific RF and transmitter settings can be applied. Load the
activation and CORE_SET_CONFIG commands from platform firmware.

Signed-off-by: Robin Snyders <robin@snyders.xyz>
---
 drivers/nfc/nxp-nci/core.c    | 79 +++++++++++++++++++++++++++++++++++
 drivers/nfc/nxp-nci/nxp-nci.h |  1 +
 2 files changed, 80 insertions(+)

diff --git a/drivers/nfc/nxp-nci/core.c b/drivers/nfc/nxp-nci/core.c
index 66b1986..36c162e 100644
--- a/drivers/nfc/nxp-nci/core.c
+++ b/drivers/nfc/nxp-nci/core.c
@@ -13,6 +13,7 @@
 #include <linux/delay.h>
 #include <linux/module.h>
 #include <linux/nfc.h>
+#include <linux/property.h>
 
 #include <net/nfc/nci_core.h>
 
@@ -20,6 +21,8 @@
 
 #define NXP_NCI_HDR_LEN	4
 
+#define NXP_NCI_CONFIG_MAX_SIZE	4096
+
 #define NXP_NCI_NFC_PROTOCOLS (NFC_PROTO_JEWEL_MASK | \
 			       NFC_PROTO_MIFARE_MASK | \
 			       NFC_PROTO_FELICA_MASK | \
@@ -122,10 +125,85 @@ static const struct nci_driver_ops nxp_nci_core_ops[] = {
 	},
 };
 
+static int nxp_nci_apply_config(struct nci_dev *ndev)
+{
+	struct nxp_nci_info *info = nci_get_drvdata(ndev);
+	const struct firmware *config;
+	const u8 *frame;
+	size_t remaining;
+	int r;
+
+	if (!info->config_name)
+		return 0;
+
+	r = request_firmware(&config, info->config_name, info->pdev);
+	if (r) {
+		dev_err(info->pdev, "failed to load NCI configuration %s: %d\n",
+			info->config_name, r);
+		return r;
+	}
+
+	if (!config->size || config->size > NXP_NCI_CONFIG_MAX_SIZE) {
+		dev_err(info->pdev, "invalid NCI configuration size: %zu\n",
+			config->size);
+		r = -EINVAL;
+		goto release_config;
+	}
+
+	frame = config->data;
+	remaining = config->size;
+	while (remaining) {
+		size_t frame_size;
+		u16 opcode;
+
+		if (remaining < NCI_CTRL_HDR_SIZE) {
+			r = -EINVAL;
+			goto invalid_config;
+		}
+
+		frame_size = NCI_CTRL_HDR_SIZE + nci_plen(frame);
+		if (frame_size > remaining || nci_mt(frame) != NCI_MT_CMD_PKT ||
+		    nci_pbf(frame) != NCI_PBF_LAST) {
+			r = -EINVAL;
+			goto invalid_config;
+		}
+
+		opcode = nci_opcode(frame);
+		if (opcode != NCI_OP_CORE_SET_CONFIG_CMD && opcode != 0x0f02) {
+			r = -EINVAL;
+			goto invalid_config;
+		}
+
+		r = nci_core_cmd(ndev, opcode, nci_plen(frame),
+				 frame + NCI_CTRL_HDR_SIZE);
+		if (r) {
+			dev_err(info->pdev,
+				"NCI configuration command failed at offset %zu: %d\n",
+				config->size - remaining, r);
+			goto release_config;
+		}
+
+		frame += frame_size;
+		remaining -= frame_size;
+	}
+
+	dev_info(info->pdev, "applied NCI configuration %s\n",
+		 info->config_name);
+	goto release_config;
+
+invalid_config:
+	dev_err(info->pdev, "invalid NCI configuration at offset %zu\n",
+		config->size - remaining);
+release_config:
+	release_firmware(config);
+	return r;
+}
+
 static const struct nci_ops nxp_nci_ops = {
 	.open = nxp_nci_open,
 	.close = nxp_nci_close,
 	.send = nxp_nci_send,
+	.post_setup = nxp_nci_apply_config,
 	.fw_download = nxp_nci_fw_download,
 	.core_ops = nxp_nci_core_ops,
 	.n_core_ops = ARRAY_SIZE(nxp_nci_core_ops),
@@ -147,6 +225,7 @@ int nxp_nci_probe(void *phy_id, struct device *pdev,
 	info->pdev = pdev;
 	info->phy_ops = phy_ops;
 	info->max_payload = max_payload;
+	device_property_read_string(pdev, "firmware-name", &info->config_name);
 	INIT_WORK(&info->fw_info.work, nxp_nci_fw_work);
 	init_completion(&info->fw_info.cmd_completion);
 	mutex_init(&info->info_lock);
diff --git a/drivers/nfc/nxp-nci/nxp-nci.h b/drivers/nfc/nxp-nci/nxp-nci.h
index ae3fb27..af9f025 100644
--- a/drivers/nfc/nxp-nci/nxp-nci.h
+++ b/drivers/nfc/nxp-nci/nxp-nci.h
@@ -53,6 +53,7 @@ struct nxp_nci_info {
 	struct nci_dev *ndev;
 	void *phy_id;
 	struct device *pdev;
+	const char *config_name;
 
 	enum nxp_nci_mode mode;
 
