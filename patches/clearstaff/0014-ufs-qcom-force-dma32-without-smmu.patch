From 0000000000000000000000000000000000000014 Mon Sep 17 00:00:00 2001
From: Robin Snyders <robin@snyders.xyz>
Date: Mon, 3 Aug 2026 18:25:00 +0200
Subject: [PATCH] ufs: qcom: constrain SM8150 bypass DMA to 32 bits

The temporary hotdog bring-up DT removes the UFS iommus property while the
Apps SMMU description is being repaired. Direct boot exposes memory above
4 GiB, where the UFS controller consumed the doorbell but left OCS at 0xf and
never wrote a response UPIU. Keep coherent request lists in the 32-bit physical
aperture only for the SM8150 host using that explicit bypass configuration.

This is a bring-up workaround, not a replacement for restoring the SMMU link.

---
 drivers/ufs/host/ufs-qcom.c | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/drivers/ufs/host/ufs-qcom.c b/drivers/ufs/host/ufs-qcom.c
index 18a978452001..785bd2c4ee51 100644
--- a/drivers/ufs/host/ufs-qcom.c
+++ b/drivers/ufs/host/ufs-qcom.c
@@ -8,6 +8,7 @@
 #include <linux/cleanup.h>
 #include <linux/delay.h>
 #include <linux/devfreq.h>
+#include <linux/dma-mapping.h>
 #include <linux/gpio/consumer.h>
 #include <linux/interconnect.h>
 #include <linux/module.h>
@@ -2191,6 +2192,29 @@ static u32 ufs_qcom_freq_to_gear_speed(struct ufs_hba *hba, unsigned long freq)
 	return min_t(u32, gear, hba->max_pwr_info.info.gear_rx);
 }
 
+static int ufs_qcom_set_dma_mask(struct ufs_hba *hba)
+{
+	struct device_node *np = hba->dev->of_node;
+
+	/*
+	 * The temporary SM8150 bring-up DT runs UFS without the Apps SMMU.
+	 * Keep its coherent request lists in the 32-bit physical aperture until
+	 * the SMMU provider is ready to replace this bypass configuration.
+	 */
+	if (of_device_is_compatible(np, "qcom,sm8150-ufshc") &&
+	    !of_find_property(np, "iommus", NULL)) {
+		dev_info(hba->dev,
+			 "V33 UFS DMA mask forced to 32-bit (SM8150 SMMU bypass)\n");
+		return dma_set_mask_and_coherent(hba->dev, DMA_BIT_MASK(32));
+	}
+
+	if (hba->capabilities & MASK_64_ADDRESSING_SUPPORT &&
+	    !dma_set_mask_and_coherent(hba->dev, DMA_BIT_MASK(64)))
+		return 0;
+
+	return dma_set_mask_and_coherent(hba->dev, DMA_BIT_MASK(32));
+}
+
 /*
  * struct ufs_hba_qcom_vops - UFS QCOM specific variant operations
  *
@@ -2199,6 +2223,7 @@ static u32 ufs_qcom_freq_to_gear_speed(struct ufs_hba *hba, unsigned long freq)
  */
 static const struct ufs_hba_variant_ops ufs_hba_qcom_vops = {
 	.name                   = "qcom",
+	.set_dma_mask		= ufs_qcom_set_dma_mask,
 	.init                   = ufs_qcom_init,
 	.exit                   = ufs_qcom_exit,
 	.get_ufs_hci_version	= ufs_qcom_get_ufs_hci_version,
-- 
2.50.1
