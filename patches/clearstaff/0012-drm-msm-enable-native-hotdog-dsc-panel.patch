From c5b312b51527f4773df2801e7f565c315bda3d03 Mon Sep 17 00:00:00 2001
From: Sr-0w <Sr-0w@users.noreply.github.com>
Date: Mon, 3 Aug 2026 17:24:13 +0200
Subject: [PATCH 2/2] drm: msm: enable the native OnePlus hotdog DSC panel

---
 .../boot/dts/qcom/sm8150-oneplus-hotdog.dts   |  29 ++
 arch/arm64/configs/sm8150.config              |   7 +-
 drivers/gpu/drm/msm/dsi/dsi_host.c            |  24 +-
 drivers/gpu/drm/panel/Kconfig                 |   2 +-
 .../gpu/drm/panel/panel-samsung-oneplus-dsc.c | 351 ++++++++++++++++++
 include/drm/display/drm_dsc.h                 |   6 +
 6 files changed, 401 insertions(+), 18 deletions(-)
 create mode 100644 drivers/gpu/drm/panel/panel-samsung-oneplus-dsc.c

diff --git a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
index 9fbee4ea93fc..1c4f34e36f46 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
@@ -139,6 +139,17 @@ vph_pwr: vph-pwr-regulator {
 		regulator-max-microvolt = <3700000>;
 	};
 
+	panel_avdd_1p8: panel-avdd-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_avdd_1p8";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&tlmm 130 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-0 = <&panel_avdd_default>;
+		pinctrl-names = "default";
+	};
+
 	/*
 	 * Apparently RPMh does not provide support for PM8150 S4 because it
 	 * is always-on; model it as a fixed regulator.
@@ -160,6 +171,20 @@ vreg_s4a_1p8: pm8150-s4 {
 &tlmm {
 	gpio-reserved-ranges = <4 2>, <83 2>, <126 4>;
 
+	panel_avdd_default: panel-avdd-default-state {
+		pins = "gpio130";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	panel_te_default: panel-te-default-state {
+		pins = "gpio8";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
 	ts_reset_default: ts-reset-default-state {
 		pins = "gpio54";
 		function = "gpio";
@@ -607,8 +632,11 @@ display_panel: panel@0 {
 		compatible = "samsung,oneplus-dsc";
 		reg = <0>;
 		vddio-supply = <&vreg_l14a_1p8>;
+		avdd-supply = <&panel_avdd_1p8>;
 
 		reset-gpios = <&tlmm 6 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&panel_te_default>;
+		pinctrl-names = "default";
 
 		status = "okay";
 
@@ -623,6 +651,7 @@ panel_in: endpoint {
 &mdss_dsi0_out {
 	data-lanes = <0 1 2 3>;
 	remote-endpoint = <&panel_in>;
+	status = "okay";
 };
 
 &mdss_dsi0_phy {
