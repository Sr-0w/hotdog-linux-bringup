diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c b/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c
--- a/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c
@@ -1789,22 +1789,56 @@ static int qmp_ufs_phy_calibrate(struct phy *phy)
 	const struct qmp_phy_cfg *cfg = qmp->cfg;
 	void __iomem *pcs = qmp->pcs;
 	void __iomem *status;
+	bool sm8150_pcs_reset_sequence;
+	u32 pcs_sw_reset_before;
+	u32 pcs_sw_reset_calibrated;
 	unsigned int val;
 	int ret;
 
+	sm8150_pcs_reset_sequence = cfg == &sm8150_ufsphy_cfg &&
+					!cfg->no_pcs_sw_reset;
+
 	ret = reset_control_assert(qmp->ufs_reset);
 	if (ret)
 		return ret;
 
+	/*
+	 * The downstream SM8150 PHY keeps PCS in software reset while writing
+	 * calibration data, then releases PCS before the host PHY reset. Match
+	 * that cold-boot ordering for this controller.
+	 */
+	if (sm8150_pcs_reset_sequence) {
+		pcs_sw_reset_before = readl(pcs + cfg->regs[QPHY_SW_RESET]);
+		qphy_setbits(pcs, cfg->regs[QPHY_SW_RESET], SW_RESET);
+		dev_info(qmp->dev,
+			 "HOTDOG_UFS_PCS_SW_RESET before=%#x asserted=%#x\n",
+			 pcs_sw_reset_before,
+			 readl(pcs + cfg->regs[QPHY_SW_RESET]));
+	}
+
 	qmp_ufs_init_registers(qmp, cfg);
 
+	if (sm8150_pcs_reset_sequence) {
+		pcs_sw_reset_calibrated = readl(pcs + cfg->regs[QPHY_SW_RESET]);
+		qphy_clrbits(pcs, cfg->regs[QPHY_SW_RESET], SW_RESET);
+		dev_info(qmp->dev,
+			 "HOTDOG_UFS_PCS_SW_RESET calibrated=%#x deasserted=%#x\n",
+			 pcs_sw_reset_calibrated,
+			 readl(pcs + cfg->regs[QPHY_SW_RESET]));
+	}
+
 	ret = reset_control_deassert(qmp->ufs_reset);
 	if (ret)
 		return ret;
 
 	/* Pull PHY out of reset state */
-	if (!cfg->no_pcs_sw_reset)
+	if (!cfg->no_pcs_sw_reset && !sm8150_pcs_reset_sequence)
 		qphy_clrbits(pcs, cfg->regs[QPHY_SW_RESET], SW_RESET);
 
+	if (sm8150_pcs_reset_sequence)
+		dev_info(qmp->dev,
+			 "HOTDOG_UFS_PCS_SW_RESET host_deasserted=%#x\n",
+			 readl(pcs + cfg->regs[QPHY_SW_RESET]));
+
 	/* start SerDes */
 	qphy_setbits(pcs, cfg->regs[QPHY_START_CTRL], SERDES_START);
