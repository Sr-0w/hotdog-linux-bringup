 }
 
+static int ufs_qcom_hotdog_after_host_reset_device_reset(struct ufs_hba *hba)
+{
+	struct ufs_qcom_host *host = ufshcd_get_variant(hba);
+
+	if (!of_device_is_compatible(hba->dev->of_node, "qcom,sm8150-ufshc"))
+		return 0;
+
+	if (!host->device_reset) {
+		dev_err(hba->dev,
+			"HOTDOG_UFS_AFTER_HOST_RESET missing reset GPIO\n");
+		return -ENODEV;
+	}
+
+	dev_info(hba->dev,
+		 "HOTDOG_UFS_AFTER_HOST_RESET begin cfg1=%#x hcs=%#x reset=%d\n",
+		 ufshcd_readl(hba, REG_UFS_CFG1),
+		 ufshcd_readl(hba, REG_CONTROLLER_STATUS),
+		 gpiod_get_value_cansleep(host->device_reset));
+
+	ufs_qcom_device_reset_ctrl(hba, true);
+	usleep_range(10, 15);
+	ufs_qcom_device_reset_ctrl(hba, false);
+	usleep_range(10, 15);
+
+	dev_info(hba->dev,
+		 "HOTDOG_UFS_AFTER_HOST_RESET done cfg1=%#x hcs=%#x reset=%d\n",
+		 ufshcd_readl(hba, REG_UFS_CFG1),
+		 ufshcd_readl(hba, REG_CONTROLLER_STATUS),
+		 gpiod_get_value_cansleep(host->device_reset));
+
+	return 0;
+}
