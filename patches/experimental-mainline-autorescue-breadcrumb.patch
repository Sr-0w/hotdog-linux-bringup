+void __no_sanitize_address
+hotdog_fb_el0_syscall(unsigned int scno, long result, unsigned int phase)
+{
+	unsigned int count = READ_ONCE(hotdog_fb_el0_syscall_count);
+
+	if (!phase) {
+		if (!count) {
+			hotdog_fb_el0_syscall_reset();
+			WRITE_ONCE(hotdog_fb_el0_first_scno, scno);
+			hotdog_fb_el0_syscall_step(0);
+			if (scno == HOTDOG_NR_OPENAT)
+				hotdog_fb_el0_syscall_step(2);
+		}
+
+		count++;
+		WRITE_ONCE(hotdog_fb_el0_syscall_count, count);
+		if (count == 2) {
+			hotdog_fb_el0_syscall_step(4);
+			if (scno == HOTDOG_NR_LSEEK || scno == HOTDOG_NR_WRITE)
+				hotdog_fb_el0_syscall_step(5);
+			if (scno == HOTDOG_NR_EXECVE)
+				hotdog_fb_el0_syscall_step(6);
+		}
+		if (count >= 16)
+			hotdog_fb_el0_syscall_step(7);
+		return;
+	}
+
+	if (count == 1) {
+		hotdog_fb_el0_syscall_step(1);
+		if (READ_ONCE(hotdog_fb_el0_first_scno) == HOTDOG_NR_OPENAT &&
+		    result >= 0)
+			hotdog_fb_el0_syscall_step(3);
+	}
+}
