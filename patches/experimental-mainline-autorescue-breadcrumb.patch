+extern struct hotdog_early_breadcrumb hotdog_early_breadcrumb;
+
+static __always_inline void hotdog_mark_diagnostic_stage(u32 stage, u32 detail,
+						  u32 level, u64 address)
+{
+	struct hotdog_early_breadcrumb *breadcrumb =
+		&hotdog_early_breadcrumb;
+
+	WRITE_ONCE(breadcrumb->magic, HOTDOG_EARLY_BREADCRUMB_MAGIC);
+	WRITE_ONCE(breadcrumb->version, 3);
+	WRITE_ONCE(breadcrumb->stage, stage);
+	WRITE_ONCE(breadcrumb->stage_inverse, ~stage);
+	WRITE_ONCE(breadcrumb->detail, detail);
+	WRITE_ONCE(breadcrumb->detail_inverse, ~detail);
+	WRITE_ONCE(breadcrumb->level, level);
+	WRITE_ONCE(breadcrumb->level_inverse, ~level);
+	WRITE_ONCE(breadcrumb->address_low, lower_32_bits(address));
+	WRITE_ONCE(breadcrumb->address_high, upper_32_bits(address));
+	WRITE_ONCE(breadcrumb->address_low_inverse,
+		   ~lower_32_bits(address));
+	WRITE_ONCE(breadcrumb->address_high_inverse,
+		   ~upper_32_bits(address));
+	dcache_clean_poc((unsigned long)breadcrumb,
+			 (unsigned long)breadcrumb + sizeof(*breadcrumb));
+}
+
+static __always_inline void hotdog_mark_start_kernel_stage(u32 stage,
+						    u32 detail)
+{
+	hotdog_mark_diagnostic_stage(stage, detail, U32_MAX, 0);
