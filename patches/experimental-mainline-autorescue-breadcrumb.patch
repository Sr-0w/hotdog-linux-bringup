+struct hotdog_early_breadcrumb {
+	u32 magic;
+	u32 version;
+	u32 stage;
+	u32 stage_inverse;
+	u32 detail;
+	u32 detail_inverse;
+	u32 level;
+	u32 level_inverse;
+	u32 address_low;
+	u32 address_high;
