+void __no_sanitize_address
+hotdog_fb_async_pending(unsigned long function, unsigned long cookie,
+			unsigned int count)
+{
+	unsigned int bit, y, x;
+	void *map = READ_ONCE(hotdog_fb_diag_map);
+
+	if (!map)
+		return;
+
+	/*
+	 * Replace the completed kernel-init milestones with the low 16 bits of
+	 * the first globally pending async callback. A one is a full-height
+	 * block and a zero is a short baseline, making the code camera-readable
+	 * without relying on color fidelity.
+	 */
+	for (y = 0; y < HOTDOG_FB_MILESTONE_HEIGHT; y++) {
+		volatile u32 *row = map + y * HOTDOG_FB_DIAG_STRIDE;
+
+		for (x = 0; x < HOTDOG_FB_DIAG_FRAME_WIDTH; x++)
+			WRITE_ONCE(row[x], 0x00000000);
+
+		for (bit = 0; bit < HOTDOG_FB_ASYNC_BITS; bit++) {
+			unsigned int left = bit *
+				HOTDOG_FB_ASYNC_SLOT_PITCH / sizeof(*row);
+			bool set = function & BIT(HOTDOG_FB_ASYNC_BITS - 1 - bit);
+
+			if (!set && y < HOTDOG_FB_MILESTONE_HEIGHT -
+					 HOTDOG_FB_ASYNC_ZERO_HEIGHT)
+				continue;
+			for (x = 0; x < HOTDOG_FB_ASYNC_WIDTH; x++)
+				WRITE_ONCE(row[left + x], 0x00ffffff);
+		}
+
+		dcache_clean_poc((unsigned long)row,
+				 (unsigned long)(row +
+				 HOTDOG_FB_DIAG_FRAME_WIDTH));
+	}
+	wmb();
+}
