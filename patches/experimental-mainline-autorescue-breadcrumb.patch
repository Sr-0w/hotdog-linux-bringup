+void noinstr __no_sanitize_address
+hotdog_fb_user_transition(unsigned int stage)
+{
+	unsigned int mask, y, x;
+	unsigned long offset;
+	void *map = READ_ONCE(hotdog_fb_diag_map);
+
+	if (!map || stage >= 3)
+		return;
+
+	mask = READ_ONCE(hotdog_fb_user_transition_mask);
+	if (mask & BIT(stage))
+		return;
+	WRITE_ONCE(hotdog_fb_user_transition_mask, mask | BIT(stage));
+
+	offset = (HOTDOG_FB_USER_TRANSITION_FIRST_ROW +
+		  stage * HOTDOG_FB_USER_TRANSITION_ROW_PITCH) *
+		 HOTDOG_FB_DIAG_STRIDE;
+	for (y = 0; y < HOTDOG_FB_USER_TRANSITION_HEIGHT; y++) {
+		volatile u32 *row = map + offset +
+			y * HOTDOG_FB_DIAG_STRIDE;
+
+		for (x = 0; x < HOTDOG_FB_DIAG_FRAME_WIDTH; x++)
+			WRITE_ONCE(row[x], HOTDOG_FB_USER_TRANSITION_COLOR);
+		dcache_clean_poc((unsigned long)row,
+				 (unsigned long)(row +
+				 HOTDOG_FB_DIAG_FRAME_WIDTH));
+	}
+	wmb();
+}
