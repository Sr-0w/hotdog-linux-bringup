+bool async_synchronize_full_timeout(unsigned long timeout,
+				    async_cookie_t *pending_cookie,
+				    unsigned long *pending_func,
+				    unsigned int *pending_count)
+{
+	struct async_entry *entry = NULL;
+	unsigned long flags;
+	unsigned int count = 0;
+	bool complete;
+
+	if (wait_event_timeout(async_done,
+			       lowest_in_progress(NULL) >= ASYNC_COOKIE_MAX,
+			       timeout))
+		return true;
+
+	spin_lock_irqsave(&async_lock, flags);
+	complete = list_empty(&async_global_pending);
+	if (!complete) {
+		struct async_entry *iter;
+
+		entry = list_first_entry(&async_global_pending,
+					 struct async_entry, global_list);
+		list_for_each_entry(iter, &async_global_pending, global_list)
+			count++;
+		if (pending_cookie)
+			*pending_cookie = entry->cookie;
+		if (pending_func)
+			*pending_func = (unsigned long)entry->func;
+	}
+	if (pending_count)
+		*pending_count = count;
+	spin_unlock_irqrestore(&async_lock, flags);
+
+	return complete;
+}
