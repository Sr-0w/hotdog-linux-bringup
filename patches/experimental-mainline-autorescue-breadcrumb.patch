+static bool hotdog_fb_init_stage_reset_done;
+
+void __init __no_sanitize_address hotdog_fb_stage_c(unsigned int slot)
+{
+	unsigned int column, phase, y, x;
+	unsigned long offset;
+	u32 color;
+
+	/*
+	 * The bootloader preserves the splash framebuffer across reboots. Clear
+	 * every diagnostic row covered by the initial 2 MiB identity map before
+	 * drawing slot 0, so an old candidate can never impersonate this boot.
+	 */
+	if (slot == 0 && hotdog_fb_idmap_live && !hotdog_fb_diag_map) {
+		for (y = 0; y < HOTDOG_FB_DIAG_CLEAR_ROWS; y++) {
+			volatile u32 *row =
+				(volatile u32 *)(HOTDOG_FB_DIAG_PHYS +
+				y * HOTDOG_FB_DIAG_STRIDE);
+
+			for (x = 0; x < HOTDOG_FB_DIAG_FRAME_WIDTH; x++)
+				WRITE_ONCE(row[x], 0x00000000);
+			dcache_clean_poc((unsigned long)row,
+					 (unsigned long)(row +
+					 HOTDOG_FB_DIAG_FRAME_WIDTH));
+		}
+		wmb();
+	}
+
+	if (slot >= 33 || (!hotdog_fb_diag_map && !hotdog_fb_idmap_live))
+		return;
+
+	column = slot % HOTDOG_FB_DIAG_COLUMNS;
+	phase = slot / HOTDOG_FB_DIAG_COLUMNS;
+	color = phase == 0 ? HOTDOG_FB_DIAG_PHASE0_COLOR :
+		(phase == 1 ? HOTDOG_FB_DIAG_PHASE1_COLOR :
+		 HOTDOG_FB_DIAG_PHASE2_COLOR);
+	offset = column * HOTDOG_FB_DIAG_SLOT_PITCH;
+
+	for (y = 0; y < HOTDOG_FB_DIAG_HEIGHT; y++) {
+		unsigned long row_offset = offset +
+			y * HOTDOG_FB_DIAG_STRIDE;
+		volatile u32 *row = hotdog_fb_diag_map ?
+			hotdog_fb_diag_map + row_offset :
+			(volatile u32 *)(HOTDOG_FB_DIAG_PHYS + row_offset);
+
+		for (x = 0; x < HOTDOG_FB_DIAG_WIDTH; x++)
+			WRITE_ONCE(row[x], color);
+		dcache_clean_poc((unsigned long)row,
+				 (unsigned long)(row +
+				 HOTDOG_FB_DIAG_WIDTH));
+	}
+	wmb();
+}
+
+void noinstr __no_sanitize_address
+hotdog_fb_exception_capture(unsigned int kind, unsigned long esr,
+			    unsigned long far, unsigned long pc)
+{
+	unsigned int value_index, bit, y, x;
+	unsigned long offset, value;
+	u32 barcode_color;
+	void *map;
+
+	if (kind == 3) {
+		if (!READ_ONCE(hotdog_fb_el0_exception_armed))
+			return;
+		WRITE_ONCE(hotdog_fb_el0_exception_armed, false);
+	} else {
+		if (!READ_ONCE(hotdog_fb_exception_armed))
+			return;
+		WRITE_ONCE(hotdog_fb_exception_armed, false);
+	}
+
+	map = READ_ONCE(hotdog_fb_diag_map);
+	if (!map)
+		return;
+
+	barcode_color = kind == 2 ? 0x00ff00ff : 0x00ff0000;
+
+	/*
+	 * Three 64-bit barcodes, MSB first: ESR_EL1, FAR_EL1, and ELR/PC.
+	 * A set bit uses the exception color and a clear bit is black. Each bit
+	 * is 12 pixels wide with a four-pixel gap. The solid block at the right
+	 * is red for synchronous exceptions and magenta for SErrors.
+	 */
+	for (value_index = 0; value_index < 3; value_index++) {
+		value = value_index == 0 ? esr :
+			(value_index == 1 ? far : pc);
+		offset = (HOTDOG_FB_DIAG_BARCODE_FIRST_ROW + value_index) *
+			 HOTDOG_FB_DIAG_ROW_PITCH *
+			 HOTDOG_FB_DIAG_STRIDE;
+
+		for (y = 0; y < HOTDOG_FB_DIAG_HEIGHT; y++) {
+			volatile u32 *row = map + offset;
+
+			row += y * HOTDOG_FB_DIAG_STRIDE / sizeof(*row);
+			for (x = 0; x < HOTDOG_FB_DIAG_FRAME_WIDTH; x++)
+				WRITE_ONCE(row[x], 0x00000000);
+			for (bit = 0; bit < 64; bit++) {
+				u32 color = value & BIT_ULL(63 - bit) ?
+					barcode_color : 0x00000000;
+
+				for (x = 0; x < HOTDOG_FB_DIAG_BARCODE_BIT_PITCH;
+				     x++)
+					WRITE_ONCE(row[bit *
+						HOTDOG_FB_DIAG_BARCODE_BIT_PITCH +
+						x],
+						   x < HOTDOG_FB_DIAG_BARCODE_BIT_WIDTH ?
+						   color : 0x00000000);
+			}
+			for (x = 1088; x < 1184; x++)
+				WRITE_ONCE(row[x], barcode_color);
+			dcache_clean_poc((unsigned long)row,
+					 (unsigned long)(row +
+					 HOTDOG_FB_DIAG_FRAME_WIDTH));
+		}
+	}
+	wmb();
+}
+
+void __init hotdog_fb_show_initcall(unsigned int index)
+{
+	unsigned int bit, y, x;
+	unsigned long base_offset;
+
+	if (!hotdog_fb_diag_map)
+		return;
+
+	base_offset = 2 * HOTDOG_FB_DIAG_ROW_PITCH *
+		      HOTDOG_FB_DIAG_STRIDE;
+	base_offset += 10 * HOTDOG_FB_DIAG_SLOT_PITCH;
+
+	for (y = 0; y < HOTDOG_FB_DIAG_HEIGHT; y++) {
+		volatile u32 *row = hotdog_fb_diag_map + base_offset +
+			y * HOTDOG_FB_DIAG_STRIDE;
+
+		for (bit = 0; bit < 10; bit++) {
+			u32 color = index & BIT(9 - bit) ?
+				0x00ffffff : 0x00000000;
+
+			for (x = 0; x < 7; x++)
+				WRITE_ONCE(row[bit * 9 + x], color);
+		}
+		for (x = 90; x < HOTDOG_FB_DIAG_WIDTH; x++)
+			WRITE_ONCE(row[x], 0x0000ffff);
+		dcache_clean_poc((unsigned long)row,
+				 (unsigned long)(row +
+				 HOTDOG_FB_DIAG_WIDTH));
+	}
+	wmb();
+}
