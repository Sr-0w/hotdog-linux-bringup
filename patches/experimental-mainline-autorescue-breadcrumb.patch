+#define HOTDOG_FB_USER_TRANSITION_FIRST_ROW	120
+#define HOTDOG_FB_USER_TRANSITION_ROW_PITCH	20
+#define HOTDOG_FB_USER_TRANSITION_HEIGHT	12
+#define HOTDOG_FB_USER_TRANSITION_COLOR	0x00ffffff
+#define HOTDOG_FB_EL0_SYSCALL_FIRST_ROW	200
+#define HOTDOG_FB_EL0_SYSCALL_HEIGHT	96
+#define HOTDOG_FB_EL0_SYSCALL_COLUMNS	8
+#define HOTDOG_FB_EL0_SYSCALL_SLOT_PITCH	640
+#define HOTDOG_FB_EL0_SYSCALL_WIDTH	128
+#define HOTDOG_FB_EL0_SYSCALL_BORDER	8
+#define HOTDOG_FB_INIT_STAGE_FIRST_ROW	320
+#define HOTDOG_FB_INIT_STAGE_HEIGHT	112
+#define HOTDOG_FB_INIT_STAGE_COLUMNS	11
+#define HOTDOG_FB_INIT_STAGE_SLOT_PITCH	512
+#define HOTDOG_FB_INIT_STAGE_WIDTH	112
+#define HOTDOG_FB_INIT_STAGE_BORDER	10
+#define HOTDOG_NR_PRCTL			167
+#define HOTDOG_USER_STAGE_MAGIC		0x48444731UL
+#define HOTDOG_NR_OPENAT		56
+#define HOTDOG_NR_LSEEK			62
+#define HOTDOG_NR_WRITE			64
+#define HOTDOG_NR_EXECVE		221
+
+static void *hotdog_fb_diag_map;
+static bool hotdog_fb_idmap_live __initdata = true;
+static bool hotdog_fb_exception_armed;
+static bool hotdog_fb_el0_exception_armed;
+static unsigned int hotdog_fb_user_transition_mask;
+static unsigned int hotdog_fb_el0_syscall_count;
