+#define HOTDOG_FB_DIAG_PHYS		0x9c1c2000ULL
+#define HOTDOG_FB_DIAG_STRIDE		5760
+#define HOTDOG_FB_DIAG_HEIGHT		12
+#define HOTDOG_FB_DIAG_ROW_PITCH	15
+#define HOTDOG_FB_DIAG_COLUMNS		11
+#define HOTDOG_FB_DIAG_SLOT_PITCH	512
+#define HOTDOG_FB_DIAG_WIDTH		96
+#define HOTDOG_FB_DIAG_MAP_SIZE		SZ_256K
+
+static void __iomem *hotdog_fb_diag_map __initdata;
+static bool hotdog_fb_idmap_live __initdata = true;
+
+void __init __no_sanitize_address hotdog_fb_stage_c(unsigned int slot)
+{
+	unsigned int column, row_group, y, x;
+	unsigned long offset;
+
+	if (slot >= 33 || (!hotdog_fb_diag_map && !hotdog_fb_idmap_live))
+		return;
+
+	column = slot % HOTDOG_FB_DIAG_COLUMNS;
+	row_group = slot / HOTDOG_FB_DIAG_COLUMNS;
+	offset = row_group * HOTDOG_FB_DIAG_ROW_PITCH *
+		 HOTDOG_FB_DIAG_STRIDE;
+	offset += column * HOTDOG_FB_DIAG_SLOT_PITCH;
+
+	for (y = 0; y < HOTDOG_FB_DIAG_HEIGHT; y++) {
+		unsigned long row_offset = offset +
+			y * HOTDOG_FB_DIAG_STRIDE;
+
+		if (hotdog_fb_diag_map) {
+			void __iomem *row = hotdog_fb_diag_map + row_offset;
+
+			for (x = 0; x < HOTDOG_FB_DIAG_WIDTH; x++)
+				writel_relaxed(0x00ffffff, row + x * 4);
+		} else {
+			volatile u32 *row = (volatile u32 *)
+				(HOTDOG_FB_DIAG_PHYS + row_offset);
+
+			for (x = 0; x < HOTDOG_FB_DIAG_WIDTH; x++)
+				WRITE_ONCE(row[x], 0x00ffffff);
+			dcache_clean_poc((unsigned long)row,
+					 (unsigned long)(row +
+					 HOTDOG_FB_DIAG_WIDTH));
+		}
+	}
+	wmb();
+}
+
+void __init hotdog_fb_show_initcall(unsigned int index)
+{
+	unsigned int bit, y, x;
+	unsigned long base_offset;
+
+	if (!hotdog_fb_diag_map)
+		return;
+
+	base_offset = 2 * HOTDOG_FB_DIAG_ROW_PITCH *
+		      HOTDOG_FB_DIAG_STRIDE;
+	base_offset += 10 * HOTDOG_FB_DIAG_SLOT_PITCH;
+
+	for (y = 0; y < HOTDOG_FB_DIAG_HEIGHT; y++) {
+		void __iomem *row = hotdog_fb_diag_map + base_offset +
+			y * HOTDOG_FB_DIAG_STRIDE;
+
+		for (bit = 0; bit < 10; bit++) {
+			u32 color = index & BIT(9 - bit) ?
+				0x00ffffff : 0x00000000;
+
+			for (x = 0; x < 7; x++)
+				writel_relaxed(color,
+					      row + (bit * 9 + x) * 4);
+		}
+		for (x = 90; x < HOTDOG_FB_DIAG_WIDTH; x++)
+			writel_relaxed(0x0000ffff, row + x * 4);
+	}
+	wmb();
+}
+
