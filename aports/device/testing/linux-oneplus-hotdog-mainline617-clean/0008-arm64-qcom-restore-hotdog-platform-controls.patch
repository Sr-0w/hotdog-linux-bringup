@@ -26,6 +26,16 @@ properties:
   firmware-gpios:
     description: Output GPIO pin used to enter firmware download mode
 
+  firmware-name:
+    description:
+      Name of a firmware file containing a sequence of complete, unfragmented
+      NCI configuration command packets. The commands are applied after the
+      controller completes CORE_INIT and before RF discovery is configured.
+
+  clocks:
+    maxItems: 1
+    description: Optional controller reference clock
+
   interrupts:
     maxItems: 1
 
@@ -59,5 +69,6 @@ examples:
 
             enable-gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;
             firmware-gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
+            firmware-name = "nxp/pn553-example.nci";
         };
     };
