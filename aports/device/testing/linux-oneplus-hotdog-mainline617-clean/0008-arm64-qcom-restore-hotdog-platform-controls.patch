+static int nxp_nci_apply_config(struct nci_dev *ndev)
+{
+	struct nxp_nci_info *info = nci_get_drvdata(ndev);
+	const struct firmware *config;
+	const u8 *frame;
+	size_t remaining;
+	int r;
+
+	if (!info->config_name)
+		return 0;
+
+	r = request_firmware(&config, info->config_name, info->pdev);
+	if (r) {
+		dev_err(info->pdev, "failed to load NCI configuration %s: %d\n",
+			info->config_name, r);
+		return r;
+	}
+
+	if (!config->size || config->size > NXP_NCI_CONFIG_MAX_SIZE) {
+		dev_err(info->pdev, "invalid NCI configuration size: %zu\n",
+			config->size);
+		r = -EINVAL;
+		goto release_config;
+	}
+
+	dev_info(info->pdev,
+		 "NCI limits: max ctrl packet payload %u\n",
+		 ndev->max_ctrl_pkt_payload_len);
+
+	frame = config->data;
+	remaining = config->size;
+	while (remaining) {
+		size_t frame_size;
+		u16 opcode;
+
+		if (remaining < NCI_CTRL_HDR_SIZE) {
+			r = -EINVAL;
+			goto invalid_config;
+		}
+
+		frame_size = NCI_CTRL_HDR_SIZE + nci_plen(frame);
+		if (frame_size > remaining || nci_mt(frame) != NCI_MT_CMD_PKT ||
+		    nci_pbf(frame) != NCI_PBF_LAST) {
+			r = -EINVAL;
+			goto invalid_config;
+		}
+
+		opcode = nci_opcode(frame);
+		if (opcode != NCI_OP_CORE_SET_CONFIG_CMD &&
+		    opcode != NXP_NCI_SET_MODE_CMD) {
+			r = -EINVAL;
+			goto invalid_config;
+		}
+
+		r = nci_core_cmd(ndev, opcode, nci_plen(frame),
+				 frame + NCI_CTRL_HDR_SIZE);
+		if (r) {
+			dev_err(info->pdev,
+				"NCI configuration command failed at offset %zu: %d\n",
+				config->size - remaining, r);
+			goto release_config;
+		}
+
+		frame += frame_size;
+		remaining -= frame_size;
+	}
+
+	dev_info(info->pdev, "applied NCI configuration %s\n",
+		 info->config_name);
+	goto release_config;
+
+invalid_config:
+	dev_err(info->pdev, "invalid NCI configuration at offset %zu\n",
+		config->size - remaining);
+release_config:
+	release_firmware(config);
+	return r;
+}
