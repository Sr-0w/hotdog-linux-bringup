diff --git a/Documentation/devicetree/bindings/iio/magnetometer/magnachip,mxm1120.yaml b/Documentation/devicetree/bindings/iio/magnetometer/magnachip,mxm1120.yaml
new file mode 100644
index 000000000000..e2962ab2e8b0
--- /dev/null
+++ b/Documentation/devicetree/bindings/iio/magnetometer/magnachip,mxm1120.yaml
@@ -0,0 +1,53 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iio/magnetometer/magnachip,mxm1120.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MagnaChip MXM1120 Hall effect magnetic position sensor
+
+maintainers:
+  - Robin Snyders <robin@snyders.xyz>
+
+properties:
+  compatible:
+    const: magnachip,mxm1120
+
+  reg:
+    maxItems: 1
+
+  label:
+    description: Human-readable sensor position
+
+  "#io-channel-cells":
+    const: 0
+
+  vdd-supply:
+    description: Analog sensor supply
+
+  vio-supply:
+    description: I/O supply
+
+required:
+  - compatible
+  - reg
+  - vdd-supply
+  - vio-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        magnetometer@c {
+            compatible = "magnachip,mxm1120";
+            reg = <0x0c>;
+            #io-channel-cells = <0>;
+            label = "camera-popup-up";
+            vdd-supply = <&vreg_hall_3p0>;
+            vio-supply = <&vreg_hall_1p8>;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/media/oneplus,hotdog-popup-motor.yaml b/Documentation/devicetree/bindings/media/oneplus,hotdog-popup-motor.yaml
new file mode 100644
index 000000000000..1dfdd24f862e
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/oneplus,hotdog-popup-motor.yaml
@@ -0,0 +1,99 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/oneplus,hotdog-popup-motor.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OnePlus hotdog pop-up camera stepper motor
+
+maintainers:
+  - Robin Snyders <robin@snyders.xyz>
+
+description: |
+  The OnePlus 7T Pro uses a DRV8834 stepper controller and two Hall effect
+  sensors to raise and lower its front camera. This binding exposes the
+  board-specific resources and a power domain consumed by the front camera
+  sensor. Runtime power transitions raise and lower the mechanism.
+
+properties:
+  compatible:
+    const: oneplus,hotdog-popup-motor
+
+  '#power-domain-cells':
+    const: 0
+
+  boost-enable-gpios:
+    maxItems: 1
+
+  direction-gpios:
+    maxItems: 1
+
+  mode1-gpios:
+    maxItems: 1
+
+  sleep-gpios:
+    maxItems: 1
+
+  step-gpios:
+    maxItems: 1
+
+  pwms:
+    maxItems: 1
+
+  pwm-names:
+    const: step
+
+  io-channels:
+    minItems: 2
+    maxItems: 2
+
+  io-channel-names:
+    items:
+      - const: hall-up
+      - const: hall-down
+
+  pinctrl-names:
+    items:
+      - const: default
+      - const: pwm
+
+  pinctrl-0: true
+
+  pinctrl-1: true
+
+required:
+  - compatible
+  - '#power-domain-cells'
+  - boost-enable-gpios
+  - direction-gpios
+  - mode1-gpios
+  - sleep-gpios
+  - step-gpios
+  - pwms
+  - pwm-names
+  - io-channels
+  - io-channel-names
+  - pinctrl-names
+  - pinctrl-0
+  - pinctrl-1
+
+additionalProperties: false
+
+examples:
+  - |
+    camera-popup {
+        compatible = "oneplus,hotdog-popup-motor";
+        #power-domain-cells = <0>;
+        boost-enable-gpios = <&pmic_gpio 12 0>;
+        direction-gpios = <&pmic_gpio 11 0>;
+        mode1-gpios = <&pmic_gpio 8 0>;
+        sleep-gpios = <&pmic_gpio 10 0>;
+        step-gpios = <&pmic_gpio 10 0>;
+        pwms = <&pmic_pwm 3 104166>;
+        pwm-names = "step";
+        io-channels = <&hall_up>, <&hall_down>;
+        io-channel-names = "hall-up", "hall-down";
+        pinctrl-names = "default", "pwm";
+        pinctrl-0 = <&motor_default>;
+        pinctrl-1 = <&motor_pwm>;
+    };
