From 3bda90e0c24f086554d8b30ed0a7fa3434dbe367 Mon Sep 17 00:00:00 2001
From: Robin Snyders <robin@snyders.xyz>
Date: Tue, 25 Aug 2026 22:53:09 +0200
Subject: [PATCH 1/7] arm64: add bounded hotdog direct-boot contract

Signed-off-by: Robin Snyders <robin@snyders.xyz>

diff --git a/arch/arm64/Kconfig.platforms b/arch/arm64/Kconfig.platforms
index a88f5ad9328c..7ff45e5a1b07 100644
--- a/arch/arm64/Kconfig.platforms
+++ b/arch/arm64/Kconfig.platforms
@@ -289,6 +289,15 @@ config ARCH_QCOM
 	help
 	  This enables support for the ARMv8 based Qualcomm chipsets.
 
+config ONEPLUS_HOTDOG_EARLY_BOOT
+	bool "OnePlus 7T Pro early boot compatibility"
+	depends on ARCH_QCOM
+	help
+	  Preserve the arm64 Image header and inherited APSS watchdog contract
+	  required when the OnePlus 7T Pro bootloader starts Linux directly.
+	  This is a board bring-up compatibility option and should only be enabled
+	  by kernels intended to boot on that device.
+
 config ARCH_REALTEK
 	bool "Realtek Platforms"
 	select RESET_CONTROLLER
diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index ca04b338cb0d..5ae954bcc6cb 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -60,8 +60,13 @@
 	 */
 	efi_signature_nop			// special NOP to identity as PE/COFF executable
 	b	primary_entry			// branch to kernel start, magic
+#ifdef CONFIG_ONEPLUS_HOTDOG_EARLY_BOOT
+	.quad	0x00080000			// load offset expected by the ABL handoff
+	.quad	0x01ad0000			// hardware-validated linked Image window
+#else
 	.quad	0				// Image load offset from start of RAM, little-endian
 	le64sym	_kernel_size_le			// Effective size of kernel image, little-endian
+#endif
 	le64sym	_kernel_flags_le		// Informative flags, little-endian
 	.quad	0				// reserved
 	.quad	0				// reserved
@@ -83,6 +88,21 @@
 	 *  x21        primary_entry() .. start_kernel()        FDT pointer passed at boot in x0
 	 */
 SYM_CODE_START(primary_entry)
+#ifdef CONFIG_ONEPLUS_HOTDOG_EARLY_BOOT
+	/* ABL can leave its APSS watchdog armed across the kernel handoff. */
+	mrs	x9, CurrentEL
+	cmp	x9, #CurrentEL_EL2
+	mrs	x10, sctlr_el1
+	b.ne	.Lhotdog_boot_state_ready
+	mrs	x10, sctlr_el2
+.Lhotdog_boot_state_ready:
+	tbnz	x10, #0, .Lhotdog_watchdog_done	// SCTLR_ELx.M
+	tbnz	x10, #2, .Lhotdog_watchdog_done	// SCTLR_ELx.C
+	movz	x9, #0x17c1, lsl #16		// APSS WDT: 0x17c10000
+	str	wzr, [x9, #0x08]		// WDT0_EN = 0
+	dsb	sy
+.Lhotdog_watchdog_done:
+#endif
 	bl	record_mmu_state
 	bl	preserve_boot_args
 
-- 
