+/*
+ * SM8150 CAMNOC quality-of-service.
+ *
+ * The vendor stack programs per-port priority, danger and safe tables at CPAS
+ * start; mainline models no CPAS and writes none of them. Read on hardware,
+ * every IFE entry is zero, and the write master completes transfers without
+ * issuing a single memory write. These are the values the vendor writes for
+ * this SoC revision, from cpastop_v175_101.h.
+ */
+#define CAMNOC_BASE			0x0ac42000
+#define CAMNOC_SIZE			0x5000
+
+static const struct {
+	u32 offset;
+	u32 value;
+} camnoc_qos_8150[] = {
+	{ 0x0430, 0x66666543 },	/* IFE02 priority LUT low */
+	{ 0x0434, 0x66666666 },	/* IFE02 priority LUT high */
+	{ 0x0440, 0xffffff00 },	/* IFE02 danger LUT low */
+	{ 0x0448, 0x00000001 },	/* IFE02 safe LUT low */
+	{ 0x0830, 0x66666543 },	/* IFE13 priority LUT low */
+	{ 0x0834, 0x66666666 },	/* IFE13 priority LUT high */
+	{ 0x0840, 0xffffff00 },	/* IFE13 danger LUT low */
+	{ 0x0848, 0x00000001 },	/* IFE13 safe LUT low */
+};
+
+static void vfe_camnoc_qos_init(struct vfe_device *vfe)
+{
+	void __iomem *camnoc;
+	unsigned int i;
+
+	camnoc = ioremap(CAMNOC_BASE, CAMNOC_SIZE);
+	if (!camnoc) {
+		dev_warn(vfe->camss->dev, "cannot map CAMNOC\n");
+		return;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(camnoc_qos_8150); i++)
+		writel_relaxed(camnoc_qos_8150[i].value,
+			       camnoc + camnoc_qos_8150[i].offset);
+
+	/* Ordering against the write master configuration that follows. */
+	wmb();
+	iounmap(camnoc);
+
+	dev_info(vfe->camss->dev, "CAMNOC quality-of-service programmed\n");
+}
