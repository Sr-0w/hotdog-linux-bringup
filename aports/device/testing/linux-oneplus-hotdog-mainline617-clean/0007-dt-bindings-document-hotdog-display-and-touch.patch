diff --git a/Documentation/devicetree/bindings/display/panel/samsung,oneplus-dsc.yaml b/Documentation/devicetree/bindings/display/panel/samsung,oneplus-dsc.yaml
new file mode 100644
index 000000000000..6c4ac74e92ea
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/samsung,oneplus-dsc.yaml
@@ -0,0 +1,68 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/samsung,oneplus-dsc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung 1440x3120 DSC panel for the OnePlus 7T Pro
+
+maintainers:
+  - Robin Snyders <robin@snyders.xyz>
+
+description:
+  Command-mode AMOLED panel used by the OnePlus 7T Pro. The panel carries two
+  720-pixel DSC slices in each DSI packet and supports 60 Hz and 90 Hz modes.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: samsung,oneplus-dsc
+
+  reg:
+    maxItems: 1
+
+  vddio-supply:
+    description: I/O voltage rail
+
+  avdd-supply:
+    description: Panel analogue voltage rail
+
+  reset-gpios: true
+  port: true
+
+required:
+  - compatible
+  - reg
+  - vddio-supply
+  - avdd-supply
+  - reset-gpios
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "samsung,oneplus-dsc";
+            reg = <0>;
+            vddio-supply = <&vreg_panel_io>;
+            avdd-supply = <&vreg_panel_ana>;
+            reset-gpios = <&tlmm 6 GPIO_ACTIVE_LOW>;
+
+            port {
+                panel_in: endpoint {
+                    remote-endpoint = <&dsi_out>;
+                };
+            };
+        };
+    };
+
+...
