From ee7bf4e0fc2e98ff37bd325bd58187caa0f7ee95 Mon Sep 17 00:00:00 2001
From: Robin Snyders <robin@snyders.xyz>
Date: Tue, 25 Aug 2026 22:55:41 +0200
Subject: [PATCH 02/17] arm64: dts: qcom: add hotdog boot foundation

Signed-off-by: Robin Snyders <robin@snyders.xyz>
---
 arch/arm64/boot/dts/qcom/Makefile             |   1 +
 .../boot/dts/qcom/sm8150-oneplus-hotdog.dts   | 344 ++++++++++++++++++
 2 files changed, 345 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 01bc586700da..fa13fa398406 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -278,6 +278,7 @@ dtb-$(CONFIG_ARCH_QCOM)	+= sm8150-xiaomi-cepheus.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8150-xiaomi-nabu.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-hdk.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8150-oneplus-guacamole.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= sm8150-oneplus-hotdog.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8150-oneplus-hotdogb.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-mtp.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-sony-xperia-edo-pdx203.dtb
diff --git a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
new file mode 100644
index 000000000000..a9f19820c3a7
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
@@ -0,0 +1,344 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * OnePlus 7T Pro (hotdog / HD191x) minimal mainline foundation.
+ *
+ * Keep this first migration stage limited to contracts required for direct
+ * boot, storage, USB recovery, display, GPU and input. The complete 6.16
+ * bring-up remains the oracle for later subsystem ports.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include "sm8150-oneplus-common.dtsi"
+
+/delete-node/ &rmtfs_mem;
+
+/ {
+	model = "OnePlus 7T Pro";
+	compatible = "oneplus,hotdog", "oneplus,oneplus7", "qcom,sm8150";
+	chassis-type = "handset";
+
+	qcom,msm-id = <339 0x20000>;
+	qcom,board-id = <8 0>;
+	oplus,dtsi_no = <19801>;
+	oplus,pcb_range = <0 55>;
+
+	memory@80000000 {
+		reg = <0 0x80000000 0 0x3bb00000>;
+	};
+
+	aliases {
+		display0 = &framebuffer0;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		stdout-path = "display0";
+
+		framebuffer0: framebuffer@9c000000 {
+			compatible = "simple-framebuffer";
+			reg = <0 0x9c000000 0 (1440 * 3120 * 4)>;
+			width = <1440>;
+			height = <3120>;
+			stride = <(1440 * 4)>;
+			format = "a8r8g8b8";
+			status = "okay";
+		};
+	};
+
+	reserved-memory {
+		/* Complete the stock-owned XBL/AOP interval. */
+		xbl_aop_gap: memory@85e40000 {
+			reg = <0 0x85e40000 0 0xc0000>;
+			no-map;
+		};
+
+		stock_removed_gap: memory@89b00000 {
+			reg = <0 0x89b00000 0 0x200000>;
+			no-map;
+		};
+
+		hotdog_removed_gap: memory@89d00000 {
+			reg = <0 0x89d00000 0 0x1a00000>;
+			no-map;
+		};
+
+		stock_cdsp_gap: memory@99517000 {
+			reg = <0 0x99517000 0 0xe9000>;
+			no-map;
+		};
+
+		cont_splash_region: memory@9c000000 {
+			reg = <0 0x9c000000 0 0x2400000>;
+			no-map;
+		};
+
+		cdsp_sec_regions: memory@a4c00000 {
+			compatible = "removed-dma-pool";
+			reg = <0 0xa4c00000 0 0x3c00000>;
+			no-map;
+		};
+
+		ramoops: ramoops@a9800000 {
+			compatible = "ramoops";
+			reg = <0 0xa9800000 0 0x400000>;
+			record-size = <0x40000>;
+			console-size = <0x1000>;
+			ftrace-size = <0x1000>;
+			pmsg-size = <0x1000>;
+			ecc-size = <0>;
+		};
+
+		param_mem: memory@ac200000 {
+			reg = <0 0xac200000 0 0x100000>;
+			no-map;
+		};
+
+		mtp_mem: memory@ac300000 {
+			reg = <0 0xac300000 0 0xb00000>;
+			no-map;
+		};
+
+		rmtfs_mem: memory@fc201000 {
+			compatible = "qcom,rmtfs-mem";
+			reg = <0 0xfc201000 0 0x200000>;
+			no-map;
+			qcom,client-id = <1>;
+			qcom,vmid = <15>;
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&volume_up_state>, <&volume_down_state>;
+
+		key-volume-up {
+			label = "Volume Up";
+			gpios = <&pm8150_gpios 6 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;
+			wakeup-source;
+			debounce-interval = <15>;
+		};
+
+		key-volume-down {
+			label = "Volume Down";
+			gpios = <&pm8150_gpios 7 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEDOWN>;
+			wakeup-source;
+			debounce-interval = <15>;
+		};
+	};
+
+	panel_avdd_1p8: panel-avdd-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_avdd_1p8";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&tlmm 130 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&panel_avdd_default>;
+	};
+
+	/* Symbol retained for the validated HD1913 bootloader overlay contract. */
+	ufs_phy_gdsc: ufs-phy-gdsc-supply {
+		compatible = "regulator-fixed";
+		regulator-name = "ufs-phy-gdsc-bridge";
+		regulator-min-microvolt = <1>;
+		regulator-max-microvolt = <1>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	__symbols__ {
+		ufsphy_mem = "/soc@0/phy@1d87000";
+		ufshc_mem = "/soc@0/ufshc@1d84000";
+		pm8150_l5 = "/soc@0/rsc@18200000/pm8150-rpmh-regulators/ldo5";
+		pm8150l_l3 = "/soc@0/rsc@18200000/pm8150l-rpmh-regulators/ldo3";
+		pm8150_l10 = "/soc@0/rsc@18200000/pm8150-rpmh-regulators/ldo10";
+		pm8150_l9 = "/soc@0/rsc@18200000/pm8150-rpmh-regulators/ldo9";
+		pm8150_s4 = "/pm8150-s4";
+		pm8150l_s8 = "/soc@0/rsc@18200000/pm8150l-rpmh-regulators/smps8";
+	};
+};
+
+&adsp_mem {
+	reg = <0 0x8be00000 0 0x1e00000>;
+};
+
+&mpss_mem {
+	reg = <0 0x8dc00000 0 0xa000000>;
+};
+
+&venus_mem {
+	reg = <0 0x97c00000 0 0x500000>;
+};
+
+&slpi_mem {
+	reg = <0 0x98100000 0 0x1400000>;
+};
+
+&ipa_fw_mem {
+	reg = <0 0x99500000 0 0x10000>;
+};
+
+&ipa_gsi_mem {
+	reg = <0 0x99510000 0 0x5000>;
+};
+
+&gpu_mem {
+	reg = <0 0x99515000 0 0x2000>;
+};
+
+&spss_mem {
+	reg = <0 0x99600000 0 0x100000>;
+};
+
+&cdsp_mem {
+	reg = <0 0x99700000 0 0x1400000>;
+};
+
+&pm8150_gpios {
+	volume_up_state: volume-up-state {
+		pins = "gpio6";
+		function = "normal";
+		input-enable;
+		bias-pull-up;
+		power-source = <1>;
+	};
+
+	volume_down_state: volume-down-state {
+		pins = "gpio7";
+		function = "normal";
+		input-enable;
+		bias-pull-up;
+		power-source = <1>;
+	};
+};
+
+&tlmm {
+	panel_avdd_default: panel-avdd-default-state {
+		pins = "gpio130";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	panel_te_default: panel-te-default-state {
+		pins = "gpio8";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	ts_reset_default: ts-reset-default-state {
+		pins = "gpio54";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-high;
+	};
+
+	ts_int_default: ts-int-default-state {
+		pins = "gpio122";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+};
+
+&qupv3_id_2 {
+	status = "okay";
+};
+
+&gpi_dma2 {
+	status = "okay";
+};
+
+&i2c17 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	touchscreen@48 {
+		compatible = "samsung,s6sy761";
+		reg = <0x48>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <122 IRQ_TYPE_LEVEL_LOW>;
+		vdd-supply = <&vreg_l1c_1p8>;
+		avdd-supply = <&vreg_l10c_3p3>;
+		reset-gpios = <&tlmm 54 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&ts_reset_default>, <&ts_int_default>;
+	};
+};
+
+&gmu {
+	status = "okay";
+};
+
+&gpu {
+	status = "okay";
+
+	zap-shader {
+		firmware-name = "qcom/sm8150/oneplus/hotdog/a640_zap.mbn";
+	};
+};
+
+&ufs_mem_hc {
+	iommus = <&apps_smmu 0x300 0>;
+};
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_mdp {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	vdda-supply = <&vreg_l3c_1p2>;
+	status = "okay";
+
+	display_panel: panel@0 {
+		compatible = "samsung,oneplus-dsc";
+		reg = <0>;
+		vddio-supply = <&vreg_l14a_1p8>;
+		avdd-supply = <&panel_avdd_1p8>;
+		reset-gpios = <&tlmm 6 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&panel_te_default>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&panel_in>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l5a_0p875>;
+	status = "okay";
+};
+
+&pon_pwrkey {
+	status = "okay";
+};
+
+&pon_resin {
+	status = "disabled";
+};
