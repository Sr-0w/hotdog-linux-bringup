--- a/drivers/net/wireless/ath/ath10k/qmi.c
+++ b/drivers/net/wireless/ath/ath10k/qmi.c
@@ -69,16 +69,33 @@ static int ath10k_qmi_unmap_msa_permission(struct ath10k_qmi *qmi,
 	u64 src_perms;
 	int ret;
 
-	src_perms = BIT(QCOM_SCM_VMID_MSS_MSA) | BIT(QCOM_SCM_VMID_WLAN);
+	u64 wlan_perms = BIT(QCOM_SCM_VMID_WLAN);
 
 	if (!mem_info->secure)
-		src_perms |= BIT(QCOM_SCM_VMID_WLAN_CE);
+		wlan_perms |= BIT(QCOM_SCM_VMID_WLAN_CE);
 
 	dst_perms.vmid = QCOM_SCM_VMID_HLOS;
 	dst_perms.perm = QCOM_SCM_PERM_RW;
 
+	/* The hypervisor checks the source set against who actually owns the
+	 * region, so it has to be exact. Tearing the modem down revokes its
+	 * MSS_MSA share without telling us, and the symmetric reclaim below
+	 * is then rejected with -EINVAL, which is what leaves Wi-Fi down
+	 * after a modem crash. Fall back to the set that survives.
+	 */
+	src_perms = BIT(QCOM_SCM_VMID_MSS_MSA) | wlan_perms;
+
+	ret = qcom_scm_assign_mem(mem_info->addr, mem_info->size,
+				  &src_perms, &dst_perms, 1);
+	if (ret != -EINVAL)
+		goto out;
+
+	src_perms = wlan_perms;
+
 	ret = qcom_scm_assign_mem(mem_info->addr, mem_info->size,
 				  &src_perms, &dst_perms, 1);
+
+out:
 	if (ret < 0)
 		ath10k_err(ar, "failed to unmap msa permissions: %d\n", ret);
 
@@ -99,6 +116,8 @@ static int ath10k_qmi_setup_msa_permissions(struct ath10k_qmi *qmi)
 			goto err_unmap;
 	}
 
+	qmi->msa_perm_granted = true;
+
 	return 0;
 
 err_unmap:
@@ -114,8 +133,43 @@ static void ath10k_qmi_remove_msa_permission(struct ath10k_qmi *qmi)
 	if (qmi->msa_fixed_perm)
 		return;
 
+	/* Reclaiming regions we do not hold is rejected by the hypervisor and
+	 * only produces noise, so track whether the assignment is ours. This
+	 * also makes the call idempotent, which it has to be: it is reached
+	 * both from the QMI service going away and from the modem's subsystem
+	 * restart notifier, in whichever order those happen to arrive.
+	 */
+	if (!qmi->msa_perm_granted)
+		return;
+
 	for (i = 0; i < qmi->nr_mem_region; i++)
 		ath10k_qmi_unmap_msa_permission(qmi, &qmi->mem_region[i]);
+
+	qmi->msa_perm_granted = false;
+}
+
+/**
+ * ath10k_qmi_reclaim_msa() - hand the MSA regions back to HLOS
+ * @ar: the ath10k device
+ *
+ * Called from the modem's subsystem restart notifier once the modem has
+ * stopped. A crashing modem does not always produce the QMI service removal
+ * that would otherwise trigger the reclaim, and without it the regions stay
+ * assigned to MSS_MSA: the next assignment is then rejected with -EINVAL
+ * because HLOS no longer owns them, and WLAN never comes back.
+ *
+ * This must only run while the modem is down. Taking the regions away from a
+ * running modem strips it of its own memory and kills it outright.
+ */
+void ath10k_qmi_reclaim_msa(struct ath10k *ar)
+{
+	struct ath10k_snoc *ar_snoc = ath10k_snoc_priv(ar);
+	struct ath10k_qmi *qmi = ar_snoc->qmi;
+
+	if (!qmi)
+		return;
+
+	ath10k_qmi_remove_msa_permission(qmi);
 }
 
 static int ath10k_qmi_msa_mem_info_send_sync_msg(struct ath10k_qmi *qmi)
@@ -499,7 +553,15 @@ ath10k_qmi_cfg_send_sync_msg(struct ath10k *ar,
 
 	if (resp.resp.result != QMI_RESULT_SUCCESS_V01) {
 		ath10k_err(ar, "config request rejected: %d\n", resp.resp.error);
-		ret = -EINVAL;
+		/* Report the one rejection the caller can do something about
+		 * separately: the firmware refuses to be configured while it
+		 * still believes WLAN is enabled, and turning it off first
+		 * clears that. Everything else is not recoverable here.
+		 */
+		if (resp.resp.error == QMI_ERR_INCOMPATIBLE_STATE_V01)
+			ret = -EBUSY;
+		else
+			ret = -EINVAL;
 		goto out;
 	}
 
@@ -523,6 +585,18 @@ int ath10k_qmi_wlan_enable(struct ath10k *ar,
 		   mode, config);
 
 	ret = ath10k_qmi_cfg_send_sync_msg(ar, config, version);
+	if (ret == -EBUSY) {
+		/* WLAN was left enabled in the firmware. That happens when the
+		 * teardown could not complete, for instance when a WMI command
+		 * times out while the interface is being brought down for
+		 * suspend, and it is otherwise permanent: every later attempt
+		 * to bring WLAN up is rejected the same way and the interface
+		 * never returns. Turn it off and configure it again.
+		 */
+		ath10k_warn(ar, "wlan left enabled in firmware, turning it off\n");
+		ath10k_qmi_wlan_disable(ar);
+		ret = ath10k_qmi_cfg_send_sync_msg(ar, config, version);
+	}
 	if (ret) {
 		ath10k_err(ar, "failed to send qmi config: %d\n", ret);
 		return ret;
