# Clean migration baseline for the OnePlus 7T Pro mainline port.

pkgname=linux-oneplus-hotdog-mainline617-clean
pkgver=6.17.0
pkgrel=2
pkgdesc="Clean SM8150 6.17 migration kernel for OnePlus 7T Pro"
maintainer="Sr-0w <Sr-0w@users.noreply.github.com>"
arch="aarch64"
_carch="arm64"
_flavor="oneplus-hotdog-mainline617-clean"
url="https://gitlab.com/sm8150-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-nftables
	"
makedepends="
	bash
	bc
	bison
	clang
	dtc
	findutils
	flex
	kmod
	lld
	llvm
	openssl-dev
	perl
	python3
	zstd
"

_commit="379d8fe35c7ca685a650bd82fd023af0ea3f0de0"
export SOURCE_DATE_EPOCH=1761609785
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::$url/-/archive/$_commit/linux-$_commit.tar.gz
	$_config
	0001-arm64-add-bounded-hotdog-direct-boot-contract.patch
	0002-arm64-dts-qcom-add-hotdog-boot-foundation.patch
	0003-Input-s6sy761-restore-hotdog-reset-and-resume.patch
	0004-drm-restore-hotdog-DSC-panel-pipeline.patch
	0005-ufs-qcom-retain-SM8150-32-bit-DMA-aperture.patch
	0006-input-touchscreen-fts_touch-fix-compilation-with-LLV.patch
	0007-dt-bindings-document-hotdog-display-and-touch.patch
	0008-arm64-qcom-restore-hotdog-platform-controls.patch
	0009-arm64-dts-preserve-hotdog-overlay-symbols.patch
	validate-mainline617-clean-build.sh
"
builddir="$srcdir/linux-$_commit"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
	make ARCH="$_carch" LLVM=1 LLVM_IAS=1 olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 LLVM_IAS=1 \
		SOURCE_DATE_EPOCH="$SOURCE_DATE_EPOCH" \
		KBUILD_BUILD_TIMESTAMP="2025-10-28 00:03:05 UTC" \
		KBUILD_BUILD_USER="postmarketOS" \
		KBUILD_BUILD_HOST="pmaports" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor" \
		Image modules qcom/sm8150-oneplus-hotdog.dtb

	sh "$srcdir/validate-mainline617-clean-build.sh" \
		arch/$_carch/boot/Image .config \
		arch/$_carch/boot/dts/qcom/sm8150-oneplus-hotdog.dtb
}

package() {
	mkdir -p "$pkgdir/boot/dtbs/qcom"

	install -Dm644 "$builddir/arch/$_carch/boot/Image" \
		"$pkgdir/boot/vmlinuz"
	install -Dm644 \
		"$builddir/arch/$_carch/boot/dts/qcom/sm8150-oneplus-hotdog.dtb" \
		"$pkgdir/boot/dtbs/qcom/sm8150-oneplus-hotdog.dtb"

	make modules_install \
		ARCH="$_carch" LLVM=1 LLVM_IAS=1 \
		INSTALL_MOD_PATH="$pkgdir" INSTALL_MOD_STRIP=1
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"

	sh "$srcdir/validate-mainline617-clean-build.sh" \
		"$pkgdir/boot/vmlinuz" "$builddir/.config" \
		"$pkgdir/boot/dtbs/qcom/sm8150-oneplus-hotdog.dtb" \
		"$pkgdir/lib/modules/$(cat "$builddir/include/config/kernel.release")"
}

