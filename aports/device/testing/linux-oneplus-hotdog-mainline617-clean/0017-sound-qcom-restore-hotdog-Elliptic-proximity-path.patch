diff --git a/sound/soc/qcom/qdsp6/q6afe.c b/sound/soc/qcom/qdsp6/q6afe.c
index 7b59d514b432..9707cd891ddb 100644
--- a/sound/soc/qcom/qdsp6/q6afe.c
+++ b/sound/soc/qcom/qdsp6/q6afe.c
@@ -28,6 +28,8 @@
 #define AFE_PORT_CMD_DEVICE_START	0x000100E5
 #define AFE_PORT_CMD_DEVICE_STOP	0x000100E6
 #define AFE_PORT_CMD_SET_PARAM_V2	0x000100EF
+#define AFE_PSEUDOPORT_CMD_START	0x000100CF
+#define AFE_PSEUDOPORT_CMD_STOP		0x000100D0
 #define AFE_SVC_CMD_SET_PARAM		0x000100f3
 #define AFE_PORT_CMDRSP_GET_PARAM_V2	0x00010106
 #define AFE_PARAM_ID_HDMI_CONFIG	0x00010210
@@ -641,8 +643,25 @@ struct q6afe_port {
 	struct q6afe *afe;
 	struct kref refcount;
 	struct list_head node;
+	/* Serializes handler replacement against event delivery. */
+	struct mutex event_lock;
+	u32 event_opcode;
+	q6afe_event_cb_t event_callback;
+	void *event_priv;
 };
 
+struct afe_pseudoport_start_command {
+	struct apr_hdr hdr;
+	u16 port_id;
+	u16 timing;
+} __packed;
+
+struct afe_pseudoport_stop_command {
+	struct apr_hdr hdr;
+	u16 port_id;
+	u16 reserved;
+} __packed;
+
 struct afe_cmd_remote_lpass_core_hw_vote_request {
 	uint32_t  hw_block_id;
 	char client_name[8];
@@ -960,12 +979,33 @@ static struct q6afe_port *q6afe_find_port(struct q6afe *afe, int token)
 	return ret;
 }
 
+static struct q6afe_port *q6afe_find_event_port(struct q6afe *afe, u32 opcode)
+{
+	struct q6afe_port *port;
+	struct q6afe_port *found = NULL;
+	unsigned long flags;
+
+	spin_lock_irqsave(&afe->port_list_lock, flags);
+	list_for_each_entry(port, &afe->port_list, node) {
+		if (READ_ONCE(port->event_callback) &&
+		    READ_ONCE(port->event_opcode) == opcode) {
+			found = port;
+			kref_get(&found->refcount);
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&afe->port_list_lock, flags);
+
+	return found;
+}
+
 static int q6afe_callback(struct apr_device *adev, struct apr_resp_pkt *data)
 {
 	struct q6afe *afe = dev_get_drvdata(&adev->dev);
 	struct aprv2_ibasic_rsp_result_t *res;
 	struct apr_hdr *hdr = &data->hdr;
 	struct q6afe_port *port;
+	q6afe_event_cb_t callback;
 
 	if (!data->payload_size)
 		return 0;
@@ -981,6 +1021,8 @@ static int q6afe_callback(struct apr_device *adev, struct apr_resp_pkt *data)
 		case AFE_PORT_CMD_SET_PARAM_V2:
 		case AFE_PORT_CMD_DEVICE_STOP:
 		case AFE_PORT_CMD_DEVICE_START:
+		case AFE_PSEUDOPORT_CMD_START:
+		case AFE_PSEUDOPORT_CMD_STOP:
 		case AFE_SVC_CMD_SET_PARAM:
 			port = q6afe_find_port(afe, hdr->token);
 			if (port) {
@@ -1004,6 +1046,16 @@ static int q6afe_callback(struct apr_device *adev, struct apr_resp_pkt *data)
 		wake_up(&afe->wait);
 		break;
 	default:
+		port = q6afe_find_event_port(afe, hdr->opcode);
+		if (port) {
+			mutex_lock(&port->event_lock);
+			callback = READ_ONCE(port->event_callback);
+			if (callback && READ_ONCE(port->event_opcode) == hdr->opcode)
+				callback(data->payload, data->payload_size,
+					 READ_ONCE(port->event_priv));
+			mutex_unlock(&port->event_lock);
+			kref_put(&port->refcount, q6afe_port_free);
+		}
 		break;
 	}
 
@@ -1059,7 +1111,7 @@ static int afe_apr_send_pkt(struct q6afe *afe, struct apr_pkt *pkt,
 	} else if (result->status > 0) {
 		dev_err(afe->dev, "DSP returned error[%x]\n",
 			result->status);
-		ret = -EINVAL;
+		ret = result->status == ADSP_EALREADY ? -EALREADY : -EINVAL;
 	} else {
 		ret = 0;
 	}
@@ -1172,6 +1224,98 @@ static int q6afe_port_set_param_v2(struct q6afe_port *port, void *data,
 	return ret;
 }
 
+int q6afe_port_set_vendor_param(struct q6afe_port *port, const void *data,
+				int param_id, int module_id, size_t size)
+{
+	if (!port || !data || !size || size > INT_MAX)
+		return -EINVAL;
+
+	return q6afe_port_set_param_v2(port, (void *)data, param_id,
+					 module_id, size);
+}
+EXPORT_SYMBOL_GPL(q6afe_port_set_vendor_param);
+
+int q6afe_port_set_event_handler(struct q6afe_port *port, u32 opcode,
+				 q6afe_event_cb_t callback, void *priv)
+{
+	int ret = 0;
+
+	if (!port || !opcode || !callback)
+		return -EINVAL;
+
+	mutex_lock(&port->event_lock);
+	if (port->event_callback) {
+		ret = -EBUSY;
+	} else {
+		WRITE_ONCE(port->event_opcode, opcode);
+		WRITE_ONCE(port->event_priv, priv);
+		WRITE_ONCE(port->event_callback, callback);
+	}
+	mutex_unlock(&port->event_lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6afe_port_set_event_handler);
+
+void q6afe_port_clear_event_handler(struct q6afe_port *port)
+{
+	if (!port)
+		return;
+
+	mutex_lock(&port->event_lock);
+	WRITE_ONCE(port->event_callback, NULL);
+	WRITE_ONCE(port->event_priv, NULL);
+	WRITE_ONCE(port->event_opcode, 0);
+	mutex_unlock(&port->event_lock);
+}
+EXPORT_SYMBOL_GPL(q6afe_port_clear_event_handler);
+
+static int q6afe_pseudo_port_command(struct q6afe_port *port,
+				     u16 pseudo_port_id, bool start)
+{
+	struct afe_pseudoport_start_command start_cmd = { };
+	struct afe_pseudoport_stop_command stop_cmd = { };
+	struct apr_pkt *packet;
+	size_t packet_size;
+	u32 opcode;
+
+	if (!port || pseudo_port_id < 0x8001 || pseudo_port_id > 0x8005)
+		return -EINVAL;
+
+	if (start) {
+		start_cmd.port_id = pseudo_port_id;
+		start_cmd.timing = 1;
+		packet = (struct apr_pkt *)&start_cmd;
+		packet_size = sizeof(start_cmd);
+		opcode = AFE_PSEUDOPORT_CMD_START;
+	} else {
+		stop_cmd.port_id = pseudo_port_id;
+		packet = (struct apr_pkt *)&stop_cmd;
+		packet_size = sizeof(stop_cmd);
+		opcode = AFE_PSEUDOPORT_CMD_STOP;
+	}
+
+	packet->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+					      APR_HDR_LEN(APR_HDR_SIZE), APR_PKT_VER);
+	packet->hdr.pkt_size = packet_size;
+	packet->hdr.token = port->token;
+	packet->hdr.opcode = opcode;
+
+	return afe_apr_send_pkt(port->afe, packet, port, opcode);
+}
+
+int q6afe_pseudo_port_start(struct q6afe_port *port, u16 pseudo_port_id)
+{
+	return q6afe_pseudo_port_command(port, pseudo_port_id, true);
+}
+EXPORT_SYMBOL_GPL(q6afe_pseudo_port_start);
+
+int q6afe_pseudo_port_stop(struct q6afe_port *port, u16 pseudo_port_id)
+{
+	return q6afe_pseudo_port_command(port, pseudo_port_id, false);
+}
+EXPORT_SYMBOL_GPL(q6afe_pseudo_port_stop);
+
 static int q6afe_port_set_lpass_clock(struct q6afe_port *port,
 				 struct afe_clk_cfg *cfg)
 {
@@ -1674,13 +1818,17 @@ int q6afe_port_start(struct q6afe_port *port)
 	struct q6afe *afe = port->afe;
 	int port_id = port->id;
 	int ret, param_id = port->cfg_type;
+	bool recovered = false;
 	struct apr_pkt *pkt;
 	int pkt_size;
 	void *p;
 
+retry:
 	ret  = q6afe_port_set_param_v2(port, &port->port_cfg, param_id,
 				       AFE_MODULE_AUDIO_DEV_INTERFACE,
 				       sizeof(port->port_cfg));
+	if (ret == -EALREADY && !recovered)
+		goto recover;
 	if (ret) {
 		dev_err(afe->dev, "AFE enable for port 0x%x failed %d\n",
 			port_id, ret);
@@ -1718,12 +1866,26 @@ int q6afe_port_start(struct q6afe_port *port)
 	start->port_id = port_id;
 
 	ret = afe_apr_send_pkt(afe, pkt, port, AFE_PORT_CMD_DEVICE_START);
+	if (ret == -EALREADY && !recovered) {
+		kfree(pkt);
+		goto recover;
+	}
 	if (ret)
 		dev_err(afe->dev, "AFE enable for port 0x%x failed %d\n",
 			port_id, ret);
 
 	kfree(pkt);
 	return ret;
+
+recover:
+	/* Recover after a card unbind lost the local started state. */
+	dev_warn(afe->dev, "recovering already active AFE port 0x%x\n",
+		 port_id);
+	ret = q6afe_port_stop(port);
+	if (ret)
+		return ret;
+	recovered = true;
+	goto retry;
 }
 EXPORT_SYMBOL_GPL(q6afe_port_start);
 
@@ -1811,6 +1973,7 @@ struct q6afe_port *q6afe_port_get_from_id(struct device *dev, int id)
 		return ERR_PTR(-ENOMEM);
 
 	init_waitqueue_head(&port->wait);
+	mutex_init(&port->event_lock);
 
 	port->token = id;
 	port->id = port_id;
