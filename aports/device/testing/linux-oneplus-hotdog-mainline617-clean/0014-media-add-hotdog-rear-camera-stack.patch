diff --git a/Documentation/devicetree/bindings/media/i2c/onnn,lc898217xc.yaml b/Documentation/devicetree/bindings/media/i2c/onnn,lc898217xc.yaml
new file mode 100644
index 000000000000..1b38fcfe79bc
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/onnn,lc898217xc.yaml
@@ -0,0 +1,68 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/onnn,lc898217xc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: ON Semiconductor LC898217XC voice coil lens actuator
+
+maintainers:
+  - Robin Snyders <robin@snyders.xyz>
+
+description:
+  The LC898217XC is a 10-bit voice coil motor camera lens actuator
+  controlled over I2C.
+
+properties:
+  compatible:
+    const: onnn,lc898217xc
+
+  reg:
+    maxItems: 1
+
+  vdd-supply:
+    description: VCM power supply
+
+  vio-supply:
+    description: I/O pull-up supply
+
+  onnn,max-focus-position:
+    description:
+      Maximum calibrated focus position for the lens module. The actuator's
+      full 10-bit range is used when this property is absent.
+    minimum: 1
+    maximum: 1023
+    default: 1023
+
+  onnn,default-focus-position:
+    description: Focus position selected when the actuator is powered up.
+    minimum: 0
+    maximum: 1023
+    default: 50
+
+required:
+  - compatible
+  - reg
+  - vdd-supply
+  - vio-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        lens@74 {
+            compatible = "onnn,lc898217xc";
+            reg = <0x74>;
+
+            vdd-supply = <&vreg_l23a_3p3>;
+            vio-supply = <&vreg_l1c_1p8>;
+            onnn,max-focus-position = <400>;
+            onnn,default-focus-position = <50>;
+        };
+    };
+
+...
diff --git a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
index 1d87d9366b64..17d60c7698fd 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
@@ -13,6 +13,8 @@
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/media/video-interfaces.h>
 #include <dt-bindings/sound/qcom,q6afe.h>
 #include <dt-bindings/sound/qcom,q6asm.h>
 #include <dt-bindings/sound/qcom,wcd934x.h>
@@ -279,6 +281,16 @@ volume_down_state: volume-down-state {
 	};
 };
 
+&pm8150l_gpios {
+	cam0_custom2_default: cam0-custom2-default-state {
+		pins = "gpio1";
+		function = "normal";
+		power-source = <0>;
+		output-low;
+		input-disable;
+	};
+};
+
 &qupv3_id_0 {
 	/delete-property/ iommus;
 	status = "okay";
@@ -327,6 +339,76 @@ fsa_usbc_ana_en: fsa-usbc-ana-en-state {
 		output-low;
 	};
 
+	cam0_vana_default: cam0-vana-default-state {
+		pins = "gpio11";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam0_custom1_default: cam0-custom1-default-state {
+		pins = "gpio29";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam0_reset_default: cam0-reset-default-state {
+		pins = "gpio30";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam0_vaf_default: cam0-vaf-default-state {
+		pins = "gpio25";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam1_vaf_default: cam1-vaf-default-state {
+		pins = "gpio35";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam1_vana_default: cam1-vana-default-state {
+		pins = "gpio148";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mclk0_default: cam-mclk0-default-state {
+		pins = "gpio13";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mclk1_default: cam-mclk1-default-state {
+		pins = "gpio14";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mclk2_default: cam-mclk2-default-state {
+		pins = "gpio15";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mclk3_default: cam-mclk3-default-state {
+		pins = "gpio16";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	quat_mi2s_active: quat-mi2s-active-state {
 		pins = "gpio137", "gpio138";
 		function = "qua_mi2s";
@@ -853,3 +935,227 @@ &pm8150b_fg {
 	/delete-property/ power-supplies;
 	status = "disabled";
 };
+
+/ {
+	vreg_cam0_vaf: regulator-cam0-vaf {
+		compatible = "regulator-fixed";
+		regulator-name = "cam0_vaf";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&tlmm 25 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vreg_bob>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam0_vaf_default>;
+	};
+
+	vreg_cam1_vana: regulator-cam1-vana {
+		compatible = "regulator-fixed";
+		regulator-name = "cam1_vana";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&tlmm 148 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vreg_bob>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam1_vana_default>;
+	};
+
+	vreg_cam1_vaf: regulator-cam1-vaf {
+		compatible = "regulator-fixed";
+		regulator-name = "cam1_vaf";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&tlmm 35 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vreg_bob>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam1_vaf_default>;
+	};
+};
+
+&cci0 {
+	status = "okay";
+};
+
+&cci0_i2c0 {
+	s5k3m5_vcm: lens@74 {
+		compatible = "onnn,lc898217xc";
+		reg = <0x74>;
+		vdd-supply = <&vreg_cam1_vaf>;
+		vio-supply = <&vreg_l1c_1p8>;
+		onnn,max-focus-position = <400>;
+		onnn,default-focus-position = <50>;
+	};
+
+	camera@10 {
+		compatible = "samsung,s5k3m5";
+		reg = <0x10>;
+		orientation = <1>;
+		rotation = <90>;
+		clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clock-rates = <24000000>;
+		afvdd-supply = <&vreg_bob>;
+		vdda-supply = <&vreg_cam1_vana>;
+		vddd-supply = <&vreg_l2f_1p2>;
+		vddio-supply = <&vreg_l1c_1p8>;
+		reset-gpios = <&tlmm 28 GPIO_ACTIVE_LOW>;
+		lens-focus = <&s5k3m5_vcm>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_mclk0_default>;
+
+		port {
+			s5k3m5_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				link-frequencies = /bits/ 64 <602500000>;
+				remote-endpoint = <&csiphy0_ep>;
+			};
+		};
+	};
+};
+
+&cci0_i2c1 {
+	clock-frequency = <400000>;
+
+	imx586_vcm: lens@72 {
+		compatible = "onnn,lc898217xc";
+		reg = <0x72>;
+		vdd-supply = <&vreg_cam0_vaf>;
+		vio-supply = <&vreg_l1c_1p8>;
+		onnn,max-focus-position = <400>;
+		onnn,default-focus-position = <400>;
+	};
+
+	camera@1a {
+		compatible = "sony,imx586";
+		reg = <0x1a>;
+		orientation = <1>;
+		rotation = <90>;
+		clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clock-rates = <19200000>;
+		vio-supply = <&vreg_l1c_1p8>;
+		vana-supply = <&vreg_bob>;
+		vdig-supply = <&vreg_l1f_1p1>;
+		reset-gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;
+		vana-enable-gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>;
+		custom1-gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
+		custom2-gpios = <&pm8150l_gpios 1 GPIO_ACTIVE_HIGH>;
+		lens-focus = <&imx586_vcm>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_mclk1_default>, <&cam0_vana_default>,
+			    <&cam0_custom1_default>, <&cam0_custom2_default>,
+			    <&cam0_reset_default>;
+
+		port {
+			imx586_ep: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+				data-lanes = <0 1 2>;
+				link-frequencies = /bits/ 64 <698395833>;
+				remote-endpoint = <&csiphy1_ep>;
+			};
+		};
+	};
+};
+
+&cci1 {
+	status = "okay";
+};
+
+&vreg_l1f_1p1 {
+	regulator-allow-set-load;
+	regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
+				   RPMH_REGULATOR_MODE_HPM>;
+};
+
+&vreg_l4f_1p05 {
+	regulator-allow-set-load;
+	regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
+				   RPMH_REGULATOR_MODE_HPM>;
+};
+
+&cci1_i2c1 {
+	camera@1a {
+		compatible = "sony,imx481";
+		reg = <0x1a>;
+		orientation = <1>;
+		rotation = <90>;
+		clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		assigned-clock-rates = <19200000>;
+		vio-supply = <&vreg_l1c_1p8>;
+		vana-supply = <&vreg_bob>;
+		vdig-supply = <&vreg_l4f_1p05>;
+		reset-gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
+		vana-enable-gpios = <&pm8150l_gpios 2 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_mclk3_default>;
+
+		port {
+			imx481_ep: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				data-lanes = <0 1 2 3>;
+				link-frequencies = /bits/ 64 <654075000>;
+				remote-endpoint = <&csiphy3_ep>;
+			};
+		};
+	};
+};
+
+&camss {
+	status = "okay";
+
+	ports {
+		port@0 {
+			reg = <0>;
+
+			csiphy0_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&s5k3m5_ep>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+
+			csiphy1_ep: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+				data-lanes = <0 1 2>;
+				remote-endpoint = <&imx586_ep>;
+			};
+		};
+
+		port@3 {
+			reg = <3>;
+
+			csiphy3_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&imx481_ep>;
+			};
+		};
+	};
+};
+
+&pm8150l_flash {
+	status = "okay";
+
+	led-0 {
+		function = LED_FUNCTION_TORCH;
+		color = <LED_COLOR_ID_WHITE>;
+		led-sources = <1>;
+		led-max-microamp = <300000>;
+		flash-max-microamp = <1000000>;
+		flash-max-timeout-us = <1280000>;
+	};
+
+	led-1 {
+		function = LED_FUNCTION_FLASH;
+		color = <LED_COLOR_ID_WHITE>;
+		led-sources = <2>;
+		led-max-microamp = <300000>;
+		flash-max-microamp = <1000000>;
+		flash-max-timeout-us = <1280000>;
+		function-enumerator = <1>;
+	};
+};
diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 6237fe804a5c..6d2e321b422b 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -256,6 +256,39 @@ config VIDEO_IMX412
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx412.
 
+config VIDEO_IMX586
+	tristate "Sony IMX586 sensor support"
+	depends on OF_GPIO
+	help
+	  This is a Video4Linux2 sensor driver for the Sony IMX586
+	  48 megapixel camera sensor. It supports raw Bayer capture,
+	  exposure and analogue gain controls over a MIPI C-PHY link.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx586.
+
+config VIDEO_IMX481
+	tristate "Sony IMX481 sensor support"
+	depends on OF_GPIO
+	help
+	  This is a Video4Linux2 sensor driver for the Sony IMX481
+	  16 megapixel camera sensor. It supports raw Bayer capture,
+	  exposure and analogue gain controls over a MIPI D-PHY link.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx481.
+
+config VIDEO_IMX471
+	tristate "Sony IMX471 sensor support"
+	depends on OF_GPIO
+	help
+	  This is a Video4Linux2 sensor driver for the Sony IMX471
+	  front camera sensor. It supports raw Bayer capture, exposure
+	  and analogue gain controls over a four-lane MIPI D-PHY link.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx471.
+
 config VIDEO_IMX415
 	tristate "Sony IMX415 sensor support"
 	depends on OF_GPIO
@@ -701,6 +734,16 @@ config VIDEO_S5C73M3
 	  This is a V4L2 sensor driver for Samsung S5C73M3
 	  8 Mpixel camera.
 
+config VIDEO_S5K3M5
+	tristate "Samsung S5K3M5 sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a V4L2 sensor driver for Samsung S5K3M5 13MP raw
+	  camera sensor.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called s5k3m5.
+
 config VIDEO_S5K5BAF
 	tristate "Samsung S5K5BAF sensor support"
 	help
@@ -784,12 +827,11 @@ config VIDEO_AD5820
 	  It is used for example in Nokia N900 (RX-51).
 
 config VIDEO_AK7375
-	tristate "AK7375 lens voice coil support"
+	tristate "AK73xx lens voice coil support"
 	help
-	  This is a driver for the AK7375 camera lens voice coil.
-	  AK7375 is a 12 bit DAC with 120mA output current sink
-	  capability. This is designed for linear control of
-	  voice coil motors, controlled via I2C serial interface.
+	  This is a driver for the AK7345, AK7374 and AK7375 camera lens
+	  voice coils. These devices are designed for linear control of
+	  voice coil motors over an I2C serial interface.
 
 config VIDEO_DW9714
 	tristate "DW9714 lens voice coil support"
@@ -824,6 +866,16 @@ config VIDEO_DW9807_VCM
 	  capability. This is designed for linear control of
 	  voice coil motors, controlled via I2C serial interface.
 
+config VIDEO_LC898217XC
+	tristate "LC898217XC lens voice coil support"
+	depends on I2C && VIDEO_DEV
+	select MEDIA_CONTROLLER
+	select VIDEO_V4L2_SUBDEV_API
+	select V4L2_ASYNC
+	help
+	  This is a driver for the ON Semiconductor LC898217XC 10-bit
+	  camera lens voice coil actuator controlled over I2C.
+
 endif
 
 menu "Flash devices"
