diff --git a/drivers/media/i2c/ak7375.c b/drivers/media/i2c/ak7375.c
index 9a2432cea3ff..52371de8528c 100644
--- a/drivers/media/i2c/ak7375.c
+++ b/drivers/media/i2c/ak7375.c
@@ -10,6 +10,11 @@
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
 
+struct ak73xx_reg8 {
+	u8 addr;
+	u8 value;
+};
+
 struct ak73xx_chipdef {
 	u8 reg_position;
 	u8 reg_cont;
@@ -36,6 +41,14 @@ struct ak73xx_chipdef {
 	 * I2C messages.
 	 */
 	u16 power_delay_us;
+	const struct ak73xx_reg8 *startup_regs;
+	u8 num_startup_regs;
+	u16 startup_reg_delay_us;
