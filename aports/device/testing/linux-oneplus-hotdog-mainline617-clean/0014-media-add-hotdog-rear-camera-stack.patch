+/**
+ * imx586_enum_mbus_code() - Enumerate V4L2 sub-device mbus codes
+ * @sd: pointer to imx586 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @code: V4L2 sub-device code enumeration need to be filled
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = supported_mode.code;
+
+	return 0;
+}
+
+/**
+ * imx586_enum_frame_size() - Enumerate V4L2 sub-device frame sizes
+ * @sd: pointer to imx586 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @fsize: V4L2 sub-device size enumeration need to be filled
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fsize)
+{
+	if (fsize->index > 0)
+		return -EINVAL;
+
+	if (fsize->code != supported_mode.code)
+		return -EINVAL;
+
+	fsize->min_width = supported_mode.width;
+	fsize->max_width = fsize->min_width;
+	fsize->min_height = supported_mode.height;
+	fsize->max_height = fsize->min_height;
+
+	return 0;
+}
+
+/**
+ * imx586_fill_pad_format() - Fill subdevice pad format
+ *                            from selected sensor mode
+ * @imx586: pointer to imx586 device
+ * @mode: pointer to imx586_mode sensor mode
+ * @fmt: V4L2 sub-device format need to be filled
+ */
+static void imx586_fill_pad_format(struct imx586 *imx586,
+				   const struct imx586_mode *mode,
+				   struct v4l2_subdev_format *fmt)
+{
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.code = mode->code;
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.colorspace = V4L2_COLORSPACE_RAW;
+	fmt->format.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->format.quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->format.xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+/**
+ * imx586_get_pad_format() - Get subdevice pad format
+ * @sd: pointer to imx586 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @fmt: V4L2 sub-device format need to be set
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_get_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx586 *imx586 = to_imx586(sd);
+
+	mutex_lock(&imx586->mutex);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		struct v4l2_mbus_framefmt *framefmt;
+
+		framefmt = v4l2_subdev_state_get_format(sd_state, fmt->pad);
+		fmt->format = *framefmt;
+	} else {
+		imx586_fill_pad_format(imx586, imx586->cur_mode, fmt);
+	}
+
+	mutex_unlock(&imx586->mutex);
+
+	return 0;
+}
+
+/**
+ * imx586_set_pad_format() - Set subdevice pad format
+ * @sd: pointer to imx586 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @fmt: V4L2 sub-device format need to be set
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx586 *imx586 = to_imx586(sd);
+	const struct imx586_mode *mode;
+	int ret = 0;
+
+	mutex_lock(&imx586->mutex);
+
+	mode = &supported_mode;
+	imx586_fill_pad_format(imx586, mode, fmt);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		struct v4l2_mbus_framefmt *framefmt;
+
+		framefmt = v4l2_subdev_state_get_format(sd_state, fmt->pad);
+		*framefmt = fmt->format;
+	} else {
+		ret = imx586_update_controls(imx586, mode);
+		if (!ret)
+			imx586->cur_mode = mode;
+	}
+
+	mutex_unlock(&imx586->mutex);
+
+	return ret;
+}
+
+static int imx586_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	if (sel->which != V4L2_SUBDEV_FORMAT_ACTIVE)
+		return -EINVAL;
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP:
+		/* The 4000x3000 mode bins the complete 8000x6000 array 2x2. */
+		sel->r = (struct v4l2_rect) { 0, 0, 8000, 6000 };
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+/**
+ * imx586_init_state() - Initialize sub-device state
+ * @sd: pointer to imx586 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *sd_state)
+{
+	struct imx586 *imx586 = to_imx586(sd);
+	struct v4l2_subdev_format fmt = { 0 };
+
+	fmt.which = sd_state ? V4L2_SUBDEV_FORMAT_TRY : V4L2_SUBDEV_FORMAT_ACTIVE;
+	imx586_fill_pad_format(imx586, &supported_mode, &fmt);
+
+	return imx586_set_pad_format(sd, sd_state, &fmt);
+}
+
+/**
+ * imx586_start_streaming() - Start sensor stream
+ * @imx586: pointer to imx586 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_start_streaming(struct imx586 *imx586)
+{
+	const struct imx586_reg_list *reg_list;
+	int ret;
+
+	ret = imx586_write_regs(imx586, imx586_init_regs,
+				ARRAY_SIZE(imx586_init_regs));
+	if (ret) {
+		dev_err(imx586->dev, "failed to write global registers\n");
+		return ret;
+	}
+
+	/* Write sensor mode registers */
+	reg_list = &imx586->cur_mode->reg_list;
+	ret = imx586_write_regs(imx586, reg_list->regs,
+				reg_list->num_of_regs);
+	if (ret) {
+		dev_err(imx586->dev, "failed to write mode registers\n");
+		return ret;
+	}
+
+	/* Setup handler will write actual exposure and gain */
+	ret =  __v4l2_ctrl_handler_setup(imx586->sd.ctrl_handler);
+	if (ret) {
+		dev_err(imx586->dev, "fail to setup handler\n");
+		return ret;
+	}
+
+	/* Start streaming */
+	ret = imx586_write_reg(imx586, IMX586_REG_MODE_SELECT,
+			       1, IMX586_MODE_STREAMING);
+	if (ret) {
+		dev_err(imx586->dev, "failed to start streaming\n");
+		return ret;
+	}
+
+	dev_info(imx586->dev, "streaming 4000x3000 RAW10 over three-trio C-PHY\n");
+
+	return 0;
+}
+
+/**
+ * imx586_stop_streaming() - Stop sensor stream
+ * @imx586: pointer to imx586 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_stop_streaming(struct imx586 *imx586)
+{
+	return imx586_write_reg(imx586, IMX586_REG_MODE_SELECT,
+				1, IMX586_MODE_STANDBY);
+}
+
+/**
+ * imx586_set_stream() - Enable sensor streaming
+ * @sd: pointer to imx586 subdevice
+ * @enable: set to enable sensor streaming
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_set_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct imx586 *imx586 = to_imx586(sd);
+	int ret;
+
+	mutex_lock(&imx586->mutex);
+
+	if (enable) {
+		ret = pm_runtime_resume_and_get(imx586->dev);
+		if (ret)
+			goto error_unlock;
+
+		ret = imx586_start_streaming(imx586);
+		if (ret)
+			goto error_power_off;
+	} else {
+		imx586_stop_streaming(imx586);
+		pm_runtime_put(imx586->dev);
+	}
+
+	mutex_unlock(&imx586->mutex);
+
+	return 0;
+
+error_power_off:
+	pm_runtime_put(imx586->dev);
+error_unlock:
+	mutex_unlock(&imx586->mutex);
+
+	return ret;
+}
+
+/**
+ * imx586_detect() - Detect imx586 sensor
+ * @imx586: pointer to imx586 device
+ *
+ * Return: 0 if successful, -EIO if sensor id does not match
+ */
+static int imx586_detect(struct imx586 *imx586)
+{
+	int ret;
+	u32 val;
+
+	ret = imx586_read_reg(imx586, IMX586_REG_ID, 2, &val);
+	if (ret)
+		return ret;
+
+	if (val != IMX586_ID) {
+		dev_err(imx586->dev, "chip id mismatch: %x!=%x\n",
+			IMX586_ID, val);
+		return -ENXIO;
+	}
+
+	return 0;
+}
+
+/**
+ * imx586_parse_hw_config() - Parse HW configuration and check if supported
+ * @imx586: pointer to imx586 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_parse_hw_config(struct imx586 *imx586)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(imx586->dev);
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_CPHY
+	};
+	struct fwnode_handle *ep;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	if (!fwnode)
+		return -ENXIO;
+
+	/* The GPIO values are logical; reset is active low in the DT. */
+	imx586->reset_gpio = devm_gpiod_get(imx586->dev, "reset",
+					    GPIOD_OUT_HIGH);
+	if (IS_ERR(imx586->reset_gpio)) {
+		dev_err(imx586->dev, "failed to get reset gpio %ld\n",
+			PTR_ERR(imx586->reset_gpio));
+		return PTR_ERR(imx586->reset_gpio);
+	}
+
+	imx586->vana_enable_gpio = devm_gpiod_get(imx586->dev, "vana-enable",
+						  GPIOD_OUT_LOW);
+	if (IS_ERR(imx586->vana_enable_gpio))
+		return dev_err_probe(imx586->dev,
+				     PTR_ERR(imx586->vana_enable_gpio),
+				     "failed to get VANA enable GPIO\n");
+
+	imx586->custom1_gpio = devm_gpiod_get(imx586->dev, "custom1",
+					      GPIOD_OUT_LOW);
+	if (IS_ERR(imx586->custom1_gpio))
+		return dev_err_probe(imx586->dev, PTR_ERR(imx586->custom1_gpio),
+				     "failed to get CUSTOM_GPIO1\n");
+
+	imx586->custom2_gpio = devm_gpiod_get(imx586->dev, "custom2",
+					      GPIOD_OUT_LOW);
+	if (IS_ERR(imx586->custom2_gpio))
+		return dev_err_probe(imx586->dev, PTR_ERR(imx586->custom2_gpio),
+				     "failed to get CUSTOM_GPIO2\n");
+
+	/* Get sensor input clock */
+	imx586->inclk = devm_clk_get(imx586->dev, NULL);
+	if (IS_ERR(imx586->inclk)) {
+		dev_err(imx586->dev, "could not get inclk\n");
+		return PTR_ERR(imx586->inclk);
+	}
+
+	ret = clk_set_rate(imx586->inclk, IMX586_INCLK_RATE);
+	if (ret)
+		return dev_err_probe(imx586->dev, ret,
+				     "could not set 19.2 MHz input clock\n");
+
+	rate = clk_get_rate(imx586->inclk);
+	if (rate != IMX586_INCLK_RATE) {
+		dev_err(imx586->dev, "inclk frequency mismatch\n");
+		return -EINVAL;
+	}
+
+	imx586->vana = devm_regulator_get(imx586->dev, "vana");
+	if (IS_ERR(imx586->vana))
+		return dev_err_probe(imx586->dev, PTR_ERR(imx586->vana),
+				     "failed to get VANA\n");
+
+	imx586->vdig = devm_regulator_get(imx586->dev, "vdig");
+	if (IS_ERR(imx586->vdig))
+		return dev_err_probe(imx586->dev, PTR_ERR(imx586->vdig),
+				     "failed to get VDIG\n");
+
+	imx586->vio = devm_regulator_get(imx586->dev, "vio");
+	if (IS_ERR(imx586->vio))
+		return dev_err_probe(imx586->dev, PTR_ERR(imx586->vio),
+				     "failed to get VIO\n");
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -ENXIO;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus_type != V4L2_MBUS_CSI2_CPHY) {
+		dev_err(imx586->dev, "endpoint must use C-PHY\n");
+		ret = -EINVAL;
+		goto done_endpoint_free;
+	}
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != IMX586_NUM_DATA_LANES) {
+		dev_err(imx586->dev,
+			"number of CSI2 data lanes %d is not supported\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto done_endpoint_free;
+	}
+
+	if (!bus_cfg.nr_of_link_frequencies) {
+		dev_err(imx586->dev, "no link frequencies defined\n");
+		ret = -EINVAL;
+		goto done_endpoint_free;
+	}
+
+	for (i = 0; i < bus_cfg.nr_of_link_frequencies; i++)
+		if (bus_cfg.link_frequencies[i] == IMX586_LINK_FREQ)
+			goto done_endpoint_free;
+
+	ret = -EINVAL;
+
+done_endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+/* V4l2 subdevice ops */
+static const struct v4l2_subdev_video_ops imx586_video_ops = {
+	.s_stream = imx586_set_stream,
+};
+
+static const struct v4l2_subdev_pad_ops imx586_pad_ops = {
+	.enum_mbus_code = imx586_enum_mbus_code,
+	.enum_frame_size = imx586_enum_frame_size,
+	.get_fmt = imx586_get_pad_format,
+	.set_fmt = imx586_set_pad_format,
+	.get_selection = imx586_get_selection,
+};
+
+static const struct v4l2_subdev_ops imx586_subdev_ops = {
+	.video = &imx586_video_ops,
+	.pad = &imx586_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx586_internal_ops = {
+	.init_state = imx586_init_state,
+};
+
+/**
+ * imx586_power_on() - Sensor power on sequence
+ * @dev: pointer to i2c device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx586 *imx586 = to_imx586(sd);
+	int ret;
+
+	ret = regulator_set_voltage(imx586->vana, IMX586_VANA_MIN_UV,
+				    IMX586_VANA_MAX_UV);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set VANA voltage\n");
+
+	ret = regulator_enable(imx586->vana);
+	if (ret)
+		goto error_vana_voltage;
+
+	gpiod_set_value_cansleep(imx586->vana_enable_gpio, 1);
+	usleep_range(1000, 2000);
+
+	gpiod_set_value_cansleep(imx586->custom1_gpio, 1);
+
+	ret = regulator_set_load(imx586->vdig, IMX586_VDIG_LOAD_UA);
+	if (ret)
+		goto error_custom1;
+
+	ret = regulator_enable(imx586->vdig);
+	if (ret)
+		goto error_vdig_load;
+	usleep_range(1000, 2000);
+
+	gpiod_set_value_cansleep(imx586->custom2_gpio, 1);
+
+	ret = regulator_enable(imx586->vio);
+	if (ret)
+		goto error_custom2;
+	usleep_range(1000, 2000);
+
+	ret = clk_prepare_enable(imx586->inclk);
+	if (ret) {
+		dev_err(imx586->dev, "failed to enable input clock\n");
+		goto error_vio;
+	}
+
+	usleep_range(1000, 1200);
+	gpiod_set_value_cansleep(imx586->reset_gpio, 0);
+	usleep_range(1000, 2000);
+
+	return 0;
+
+error_vio:
+	regulator_disable(imx586->vio);
+error_custom2:
+	gpiod_set_value_cansleep(imx586->custom2_gpio, 0);
+	regulator_disable(imx586->vdig);
+error_vdig_load:
+	regulator_set_load(imx586->vdig, 0);
+error_custom1:
+	gpiod_set_value_cansleep(imx586->custom1_gpio, 0);
+	gpiod_set_value_cansleep(imx586->vana_enable_gpio, 0);
+	regulator_disable(imx586->vana);
+error_vana_voltage:
+	regulator_set_voltage(imx586->vana, 0, IMX586_VANA_MAX_UV);
+
+	return ret;
+}
+
+/**
+ * imx586_power_off() - Sensor power off sequence
+ * @dev: pointer to i2c device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx586 *imx586 = to_imx586(sd);
+
+	gpiod_set_value_cansleep(imx586->reset_gpio, 1);
+	clk_disable_unprepare(imx586->inclk);
+	regulator_disable(imx586->vio);
+	gpiod_set_value_cansleep(imx586->custom2_gpio, 0);
+	regulator_disable(imx586->vdig);
+	regulator_set_load(imx586->vdig, 0);
+	gpiod_set_value_cansleep(imx586->custom1_gpio, 0);
+	gpiod_set_value_cansleep(imx586->vana_enable_gpio, 0);
+	regulator_disable(imx586->vana);
+	regulator_set_voltage(imx586->vana, 0, IMX586_VANA_MAX_UV);
+
+	return 0;
+}
+
+/**
+ * imx586_init_controls() - Initialize sensor subdevice controls
+ * @imx586: pointer to imx586 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_init_controls(struct imx586 *imx586)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &imx586->ctrl_handler;
+	const struct imx586_mode *mode = imx586->cur_mode;
+	struct v4l2_fwnode_device_properties props;
+	u32 lpfr;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 8);
+	if (ret)
+		return ret;
+
+	/* Serialize controls with sensor device */
+	ctrl_hdlr->lock = &imx586->mutex;
+
+	/* Initialize exposure and gain */
+	lpfr = mode->vblank + mode->height;
+	imx586->exp_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					     &imx586_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX586_EXPOSURE_MIN,
+					     lpfr - IMX586_EXPOSURE_OFFSET,
+					     IMX586_EXPOSURE_STEP,
+					     IMX586_EXPOSURE_DEFAULT);
+
+	imx586->again_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					       &imx586_ctrl_ops,
+					       V4L2_CID_ANALOGUE_GAIN,
+					       IMX586_AGAIN_MIN,
+					       IMX586_AGAIN_MAX,
+					       IMX586_AGAIN_STEP,
+					       IMX586_AGAIN_DEFAULT);
+
+	v4l2_ctrl_cluster(2, &imx586->exp_ctrl);
+
+	imx586->vblank_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+						&imx586_ctrl_ops,
+						V4L2_CID_VBLANK,
+						mode->vblank_min,
+						mode->vblank_max,
+						1, mode->vblank);
+
+	/* Read only controls */
+	imx586->pclk_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					      &imx586_ctrl_ops,
+					      V4L2_CID_PIXEL_RATE,
+					      mode->pclk, mode->pclk,
+					      1, mode->pclk);
+
+	imx586->link_freq_ctrl = v4l2_ctrl_new_int_menu(ctrl_hdlr,
+							&imx586_ctrl_ops,
+							V4L2_CID_LINK_FREQ,
+							ARRAY_SIZE(link_freq) -
+							1,
+							mode->link_freq_idx,
+							link_freq);
+	if (imx586->link_freq_ctrl)
+		imx586->link_freq_ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx586->hblank_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+						&imx586_ctrl_ops,
+						V4L2_CID_HBLANK,
+						IMX586_REG_MIN,
+						IMX586_REG_MAX,
+						1, mode->hblank);
+	if (imx586->hblank_ctrl)
+		imx586->hblank_ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ret = v4l2_fwnode_device_parse(imx586->dev, &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &imx586_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		dev_err(imx586->dev, "control init failed: %d\n",
+			ret);
+		goto error_free_hdlr;
+	}
+
+	imx586->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error_free_hdlr:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
+
+/**
+ * imx586_probe() - I2C client device binding
+ * @client: pointer to i2c client device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_probe(struct i2c_client *client)
+{
+	struct imx586 *imx586;
+	const char *name;
+	int ret;
+
+	imx586 = devm_kzalloc(&client->dev, sizeof(*imx586), GFP_KERNEL);
+	if (!imx586)
+		return -ENOMEM;
+
+	imx586->dev = &client->dev;
+	name = device_get_match_data(&client->dev);
+	if (!name)
+		return -ENODEV;
+
+	/* Initialize subdev */
+	v4l2_i2c_subdev_init(&imx586->sd, client, &imx586_subdev_ops);
+	imx586->sd.internal_ops = &imx586_internal_ops;
+
+	ret = imx586_parse_hw_config(imx586);
+	if (ret) {
+		dev_err(imx586->dev, "HW configuration is not supported\n");
+		return ret;
+	}
+
+	mutex_init(&imx586->mutex);
+
+	ret = imx586_power_on(imx586->dev);
+	if (ret) {
+		dev_err(imx586->dev, "failed to power-on the sensor\n");
+		goto error_mutex_destroy;
+	}
+
+	/* Check module identity */
+	ret = imx586_detect(imx586);
+	if (ret) {
+		dev_err(imx586->dev, "failed to find sensor: %d\n", ret);
+		goto error_power_off;
+	}
+
+	/* Set default mode to max resolution */
+	imx586->cur_mode = &supported_mode;
+	imx586->vblank = imx586->cur_mode->vblank;
+
+	ret = imx586_init_controls(imx586);
+	if (ret) {
+		dev_err(imx586->dev, "failed to init controls: %d\n", ret);
+		goto error_power_off;
+	}
+
+	/* Initialize subdev */
+	imx586->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx586->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	v4l2_i2c_subdev_set_name(&imx586->sd, client, name, NULL);
+
+	/* Initialize source pad */
+	imx586->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&imx586->sd.entity, 1, &imx586->pad);
+	if (ret) {
+		dev_err(imx586->dev, "failed to init entity pads: %d\n", ret);
+		goto error_handler_free;
+	}
+
+	ret = v4l2_async_register_subdev_sensor(&imx586->sd);
+	if (ret < 0) {
+		dev_err(imx586->dev,
+			"failed to register async subdev: %d\n", ret);
+		goto error_media_entity;
+	}
+
+	pm_runtime_set_active(imx586->dev);
+	pm_runtime_enable(imx586->dev);
+	pm_runtime_idle(imx586->dev);
+
+	return 0;
+
+error_media_entity:
+	media_entity_cleanup(&imx586->sd.entity);
+error_handler_free:
+	v4l2_ctrl_handler_free(imx586->sd.ctrl_handler);
+error_power_off:
+	imx586_power_off(imx586->dev);
+error_mutex_destroy:
+	mutex_destroy(&imx586->mutex);
+
+	return ret;
+}
+
+/**
+ * imx586_remove() - I2C client device unbinding
+ * @client: pointer to I2C client device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static void imx586_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx586 *imx586 = to_imx586(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		imx586_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+
+	mutex_destroy(&imx586->mutex);
+}
+
+static const struct dev_pm_ops imx586_pm_ops = {
+	SET_RUNTIME_PM_OPS(imx586_power_off, imx586_power_on, NULL)
+};
+
+static const struct of_device_id imx586_of_match[] = {
+	{ .compatible = "sony,imx586", .data = "imx586" },
+	{ }
+};
+
+MODULE_DEVICE_TABLE(of, imx586_of_match);
+
+static struct i2c_driver imx586_driver = {
+	.probe = imx586_probe,
+	.remove = imx586_remove,
+	.driver = {
+		.name = "imx586",
+		.pm = &imx586_pm_ops,
+		.of_match_table = imx586_of_match,
+	},
+};
+
+module_i2c_driver(imx586_driver);
+
+MODULE_DESCRIPTION("Sony IMX586 sensor driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/i2c/lc898217xc.c b/drivers/media/i2c/lc898217xc.c
new file mode 100644
index 000000000000..f65156257589
--- /dev/null
+++ b/drivers/media/i2c/lc898217xc.c
@@ -0,0 +1,335 @@
+// SPDX-License-Identifier: GPL-2.0
+// Copyright (C) 2026 Robin Snyders
+
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/property.h>
+#include <linux/regulator/consumer.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+
+#define LC898217XC_REG_STATUS		0xb3
+#define LC898217XC_REG_POSITION		0x84
+#define LC898217XC_STATUS_READY		0x00
+#define LC898217XC_MAX_FOCUS_POS	1023
+#define LC898217XC_DEFAULT_FOCUS_POS	50
+#define LC898217XC_CTRL_STEPS		16
+#define LC898217XC_CTRL_DELAY_US		1000
+#define LC898217XC_POWER_DELAY_US	1000
+#define LC898217XC_READY_RETRIES		20
+#define LC898217XC_READY_DELAY_US	20000
+
+static const char * const lc898217xc_supply_names[] = {
+	"vdd",
+	"vio",
+};
+
+struct lc898217xc_device {
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_subdev sd;
+	struct v4l2_ctrl *focus;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(lc898217xc_supply_names)];
+	u16 focus_pos_max;
+	u16 focus_pos_default;
+};
+
+static inline struct lc898217xc_device *
+to_lc898217xc(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct lc898217xc_device, sd);
+}
+
+static int lc898217xc_read8(struct lc898217xc_device *vcm, u8 reg, u8 *val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&vcm->sd);
+	int ret;
+
+	ret = i2c_smbus_read_byte_data(client, reg);
+	if (ret < 0)
+		return ret;
+
+	*val = ret;
+	return 0;
+}
+
+static int lc898217xc_set_position(struct lc898217xc_device *vcm, u16 position)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&vcm->sd);
+	u8 buf[] = {
+		LC898217XC_REG_POSITION,
+		position >> 8,
+		position & 0xff,
+	};
+	int ret;
+
+	ret = i2c_master_send(client, buf, sizeof(buf));
+	if (ret < 0)
+		return ret;
+
+	return ret == sizeof(buf) ? 0 : -EIO;
+}
+
+static int lc898217xc_wait_ready(struct lc898217xc_device *vcm)
+{
+	int ret;
+	int i;
+	u8 status = 0xff;
+
+	for (i = 0; i < LC898217XC_READY_RETRIES; i++) {
+		ret = lc898217xc_read8(vcm, LC898217XC_REG_STATUS, &status);
+		if (!ret && status == LC898217XC_STATUS_READY)
+			return 0;
+		if (ret && ret != -ENXIO && ret != -EREMOTEIO)
+			return ret;
+		usleep_range(LC898217XC_READY_DELAY_US,
+			     LC898217XC_READY_DELAY_US + 1000);
+	}
+
+	dev_err(vcm->sd.dev, "status 0x%02x did not become ready\n", status);
+	return ret ? ret : -EBUSY;
+}
+
+static int lc898217xc_power_up(struct lc898217xc_device *vcm)
+{
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(lc898217xc_supply_names),
+				    vcm->supplies);
+	if (ret)
+		return ret;
+
+	usleep_range(LC898217XC_POWER_DELAY_US,
+		     LC898217XC_POWER_DELAY_US + 500);
+
+	ret = lc898217xc_wait_ready(vcm);
+	if (ret)
+		goto err_disable;
+
+	ret = lc898217xc_set_position(vcm, vcm->focus->val);
+	if (ret)
+		goto err_disable;
+
+	return 0;
+
+err_disable:
+	regulator_bulk_disable(ARRAY_SIZE(lc898217xc_supply_names),
+			       vcm->supplies);
+	return ret;
+}
+
+static int lc898217xc_power_down(struct lc898217xc_device *vcm)
+{
+	int ret;
+	int val;
+
+	for (val = vcm->focus->val & ~(LC898217XC_CTRL_STEPS - 1);
+	     val >= 0; val -= LC898217XC_CTRL_STEPS) {
+		ret = lc898217xc_set_position(vcm, val);
+		if (ret) {
+			dev_warn_once(vcm->sd.dev,
+				      "failed to park lens: %d\n", ret);
+			break;
+		}
+		usleep_range(LC898217XC_CTRL_DELAY_US,
+			     LC898217XC_CTRL_DELAY_US + 100);
+	}
+
+	return regulator_bulk_disable(ARRAY_SIZE(lc898217xc_supply_names),
+				      vcm->supplies);
+}
+
+static int lc898217xc_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct lc898217xc_device *vcm = container_of(ctrl->handler,
+						    struct lc898217xc_device,
+						    ctrls);
+	int ret;
+
+	if (ctrl->id != V4L2_CID_FOCUS_ABSOLUTE)
+		return -EINVAL;
+
+	if (!pm_runtime_get_if_in_use(vcm->sd.dev))
+		return 0;
+
+	ret = lc898217xc_set_position(vcm, ctrl->val);
+	pm_runtime_put(vcm->sd.dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops lc898217xc_ctrl_ops = {
+	.s_ctrl = lc898217xc_set_ctrl,
+};
+
+static int lc898217xc_open(struct v4l2_subdev *sd,
+			   struct v4l2_subdev_fh *fh)
+{
+	return pm_runtime_resume_and_get(sd->dev);
+}
+
+static int lc898217xc_close(struct v4l2_subdev *sd,
+			    struct v4l2_subdev_fh *fh)
+{
+	pm_runtime_put_autosuspend(sd->dev);
+	return 0;
+}
+
+static const struct v4l2_subdev_internal_ops lc898217xc_internal_ops = {
+	.open = lc898217xc_open,
+	.close = lc898217xc_close,
+};
+
+static const struct v4l2_subdev_ops lc898217xc_subdev_ops = { };
+
+static int lc898217xc_runtime_suspend(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+
+	return lc898217xc_power_down(to_lc898217xc(sd));
+}
+
+static int lc898217xc_runtime_resume(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+
+	return lc898217xc_power_up(to_lc898217xc(sd));
+}
+
+static int lc898217xc_probe(struct i2c_client *client)
+{
+	struct lc898217xc_device *vcm;
+	u32 value;
+	unsigned int i;
+	int ret;
+
+	vcm = devm_kzalloc(&client->dev, sizeof(*vcm), GFP_KERNEL);
+	if (!vcm)
+		return -ENOMEM;
+
+	vcm->focus_pos_max = LC898217XC_MAX_FOCUS_POS;
+	if (!device_property_read_u32(&client->dev,
+				      "onnn,max-focus-position", &value)) {
+		if (!value || value > LC898217XC_MAX_FOCUS_POS)
+			return dev_err_probe(&client->dev, -EINVAL,
+					     "invalid maximum focus position\n");
+		vcm->focus_pos_max = value;
+	}
+
+	vcm->focus_pos_default = LC898217XC_DEFAULT_FOCUS_POS;
+	if (!device_property_read_u32(&client->dev,
+				      "onnn,default-focus-position", &value))
+		vcm->focus_pos_default = value;
+	if (vcm->focus_pos_default > vcm->focus_pos_max)
+		return dev_err_probe(&client->dev, -EINVAL,
+				     "default focus position exceeds maximum\n");
+
+	for (i = 0; i < ARRAY_SIZE(lc898217xc_supply_names); i++)
+		vcm->supplies[i].supply = lc898217xc_supply_names[i];
+
+	ret = devm_regulator_bulk_get(&client->dev,
+				      ARRAY_SIZE(lc898217xc_supply_names),
+				      vcm->supplies);
+	if (ret)
+		return dev_err_probe(&client->dev, ret,
+				     "failed to get regulators\n");
+
+	v4l2_i2c_subdev_init(&vcm->sd, client, &lc898217xc_subdev_ops);
+	device_disable_async_suspend(&client->dev);
+	vcm->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	vcm->sd.internal_ops = &lc898217xc_internal_ops;
+	vcm->sd.entity.function = MEDIA_ENT_F_LENS;
+
+	v4l2_ctrl_handler_init(&vcm->ctrls, 1);
+	vcm->focus = v4l2_ctrl_new_std(&vcm->ctrls, &lc898217xc_ctrl_ops,
+				       V4L2_CID_FOCUS_ABSOLUTE, 0,
+				       vcm->focus_pos_max, 1,
+				       vcm->focus_pos_default);
+	if (vcm->ctrls.error) {
+		ret = vcm->ctrls.error;
+		goto err_free_ctrls;
+	}
+	vcm->sd.ctrl_handler = &vcm->ctrls;
+
+	ret = media_entity_pads_init(&vcm->sd.entity, 0, NULL);
+	if (ret)
+		goto err_free_ctrls;
+
+	ret = lc898217xc_power_up(vcm);
+	if (ret) {
+		dev_err_probe(&client->dev, ret,
+			      "failed to power or identify actuator\n");
+		goto err_cleanup_entity;
+	}
+
+	dev_info(&client->dev, "LC898217XC actuator ready\n");
+
+	pm_runtime_set_active(&client->dev);
+	pm_runtime_get_noresume(&client->dev);
+	pm_runtime_enable(&client->dev);
+
+	ret = v4l2_async_register_subdev(&vcm->sd);
+	if (ret) {
+		dev_err_probe(&client->dev, ret,
+			      "failed to register V4L2 subdevice\n");
+		goto err_pm;
+	}
+
+	pm_runtime_set_autosuspend_delay(&client->dev, 1000);
+	pm_runtime_use_autosuspend(&client->dev);
+	pm_runtime_put_autosuspend(&client->dev);
+
+	return 0;
+
+err_pm:
+	pm_runtime_disable(&client->dev);
+	pm_runtime_put_noidle(&client->dev);
+	lc898217xc_power_down(vcm);
+err_cleanup_entity:
+	media_entity_cleanup(&vcm->sd.entity);
+err_free_ctrls:
+	v4l2_ctrl_handler_free(&vcm->ctrls);
+	return ret;
+}
+
+static void lc898217xc_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct lc898217xc_device *vcm = to_lc898217xc(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_ctrl_handler_free(&vcm->ctrls);
+	media_entity_cleanup(&sd->entity);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		lc898217xc_power_down(vcm);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id lc898217xc_of_match[] = {
+	{ .compatible = "onnn,lc898217xc" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, lc898217xc_of_match);
+
+static DEFINE_RUNTIME_DEV_PM_OPS(lc898217xc_pm_ops,
+				 lc898217xc_runtime_suspend,
+				 lc898217xc_runtime_resume, NULL);
+
+static struct i2c_driver lc898217xc_i2c_driver = {
+	.driver = {
+		.name = "lc898217xc",
+		.pm = pm_sleep_ptr(&lc898217xc_pm_ops),
+		.of_match_table = lc898217xc_of_match,
+	},
+	.probe = lc898217xc_probe,
+	.remove = lc898217xc_remove,
+};
+module_i2c_driver(lc898217xc_i2c_driver);
+
+MODULE_AUTHOR("Robin Snyders <robin@snyders.xyz>");
+MODULE_DESCRIPTION("ON Semiconductor LC898217XC VCM driver");
+MODULE_LICENSE("GPL");
