From e28976be989a7240e63dd691e2dad0bbbdfb6241 Mon Sep 17 00:00:00 2001
From: Robin Snyders <robin@snyders.xyz>
Date: Thu, 27 Aug 2026 16:09:50 +0200
Subject: [PATCH] ASoC: qcom: sm8150: report DisplayPort presence

Without a jack the DisplayPort sink is offered whether or not a monitor
is attached, and a sound server will route to a port with nothing on the
other end. sm8250 wires qcom_snd_dp_jack_setup() for the same link; do
the same here.

Signed-off-by: Robin Snyders <robin@snyders.xyz>
---
 sound/soc/qcom/sm8150.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/sound/soc/qcom/sm8150.c b/sound/soc/qcom/sm8150.c
index 078b2b1f6a420..4dcc4d9275349 100644
--- a/sound/soc/qcom/sm8150.c
+++ b/sound/soc/qcom/sm8150.c
@@ -32,6 +32,7 @@ struct sm8150_snd_data {
 	struct snd_soc_card *card;
 	uint32_t quat_tdm_clk_count;
 	struct sdw_stream_runtime *sruntime[AFE_PORT_MAX];
+	struct snd_soc_jack dp_jack;
 };
 
 static unsigned int tdm_slot_offset[8] = {0, 4, 8, 12, 16, 20, 24, 28};
@@ -249,6 +250,13 @@ static int sm8150_dai_init(struct snd_soc_pcm_runtime *rtd)
 					    140, 141, 142, 143};
 	int rval, i;
 
+	/*
+	 * DisplayPort reports its own presence. Without this the sink is
+	 * offered whether or not a monitor is attached, and a sound server
+	 * will happily route to a port with nothing on the other end.
+	 */
+	if (cpu_dai->id == DISPLAY_PORT_RX)
+		return qcom_snd_dp_jack_setup(rtd, &pdata->dp_jack, 0);
 
 	if (!pdata->jack_setup) {
 		rval = snd_soc_card_jack_new(card, "Headset Jack",
