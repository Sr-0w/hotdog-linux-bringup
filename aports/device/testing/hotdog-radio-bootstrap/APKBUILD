4daa5a5aad64e5b804de6d08c2ed4224dfda36f45edca3af7cfe0bc47820f5407f9e6ecdf5f02fe3e2fe67f9f483009b7656b9a051c796e2b90ba9d54cfb21a0  hotdog-radio-bootstrap.initd
5bc713a246425e9748689aad0a95b30e184cc1322c6b0e9c1080f2f9b7a5724a866b2c01d66305b25abee39c265fac27df280e172967202d96980f9a9c3b96b8  hotdog-radio-supervisor.initd
