pkgname=hotdog-radio-bootstrap
pkgver=0.17
pkgrel=0
pkgdesc="Verified radio bootstrap and lifecycle supervisor for OnePlus Hotdog"
url="https://github.com/Sr-0w/hotdog-linux-bringup"
arch="aarch64"
license="GPL-2.0-only"
maintainer="Sr-0w <Sr-0w@users.noreply.github.com>"
options="!check"
depends="libqmi libqrtr-glib"
makedepends="glib-dev libqmi-dev libqrtr-glib-dev pkgconf"
subpackages="$pkgname-openrc"

_commit="43210aef15237558d2fd19449ba638f5591cfd7e"
source="
	$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz
	hotdog-radio-bootstrap.initd
	hotdog-radio-supervisor.initd
	"
builddir="$srcdir/hotdog-linux-bringup-$_commit"

build() {
	local flags
	flags="$(pkg-config --cflags --libs qmi-glib qrtr-glib gio-2.0 glib-2.0)"
	# shellcheck disable=SC2086
	$CC $CFLAGS $CPPFLAGS -std=c11 -Wall -Wextra -Werror \
		-DHOTDOG_QMI_PDC_SUBSCRIPTIONS \
		-Ihelpers/hotdog-radio \
		helpers/hotdog-radio/hotdog-radio-bootstrapd.c \
		helpers/hotdog-radio/hotdog-qmi-uim.c \
		helpers/hotdog-radio/hotdog-qmi-dms.c \
		helpers/hotdog-radio/hotdog-qmi-nas.c \
		helpers/hotdog-radio/hotdog-network.c \
		helpers/hotdog-radio/hotdog-uim.c \
		helpers/hotdog-radio/hotdog-qmi-pdc.c \
		helpers/hotdog-radio/hotdog-qmi-pdc-list.c \
		helpers/hotdog-radio/hotdog-qmi-pdc-load.c \
		helpers/hotdog-radio/hotdog-qmi-pdc-dispatch.c \
		helpers/hotdog-radio/hotdog-qmi-pdc-backend.c \
		helpers/hotdog-radio/hotdog-pdc.c \
		helpers/hotdog-radio/hotdog-pdc-load.c \
		helpers/hotdog-radio/hotdog-pdc-executor.c \
		helpers/hotdog-radio/hotdog-pdc-controller.c \
		helpers/hotdog-radio/hotdog-mcfg.c \
		helpers/hotdog-radio/hotdog-mcfg-runtime.c \
		helpers/hotdog-radio/hotdog-mbn.c \
		helpers/hotdog-radio/hotdog-radio-approval.c \
		helpers/hotdog-radio/hotdog-radio-gate.c \
		helpers/hotdog-radio/hotdog-radio-readiness.c \
		$flags $LDFLAGS -o hotdog-radio-bootstrapd
	# shellcheck disable=SC2086
	$CC $CFLAGS $CPPFLAGS -std=c11 -Wall -Wextra -Werror \
		-Ihelpers/hotdog-radio \
		helpers/hotdog-radio/hotdog-radio-supervisord.c \
		helpers/hotdog-radio/hotdog-radio-supervisor.c \
		helpers/hotdog-radio/hotdog-radio-readiness.c \
		helpers/hotdog-radio/hotdog-mcfg-runtime.c \
		helpers/hotdog-radio/hotdog-pdc.c \
		helpers/hotdog-radio/hotdog-uim.c \
		helpers/hotdog-radio/hotdog-mbn.c \
		$flags $LDFLAGS -o hotdog-radio-supervisord
}

package() {
	install -Dm755 "$builddir/hotdog-radio-bootstrapd" \
		"$pkgdir/usr/libexec/hotdog-radio-bootstrapd"
	install -Dm755 "$builddir/hotdog-radio-supervisord" \
		"$pkgdir/usr/libexec/hotdog-radio-supervisord"
}

openrc() {
	depends="$pkgname=$pkgver-r$pkgrel modemmanager-openrc postmarketos-ui-plasma-mobile postmarketos-ui-plasma-mobile-openrc"
	install="$subpkgname.post-install"
	install -Dm755 "$srcdir/hotdog-radio-bootstrap.initd" \
		"$subpkgdir/etc/init.d/hotdog-radio-bootstrap"
	install -Dm755 "$srcdir/hotdog-radio-supervisor.initd" \
		"$subpkgdir/etc/init.d/hotdog-radio-supervisor"
}

