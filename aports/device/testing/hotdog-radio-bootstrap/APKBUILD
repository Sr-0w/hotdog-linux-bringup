pkgname=hotdog-radio-bootstrap
pkgver=0.10
pkgrel=0
pkgdesc="Read-only UIM and PDC bootstrap for OnePlus Hotdog"
url="https://github.com/Sr-0w/hotdog-linux-bringup"
arch="aarch64"
license="GPL-2.0-only"
maintainer="Sr-0w <Sr-0w@users.noreply.github.com>"
options="!check"
depends="libqmi libqrtr-glib"
makedepends="glib-dev libqmi-dev libqrtr-glib-dev pkgconf"
subpackages="$pkgname-openrc"

_commit="f4dab72bbfa304406b8ba855b5ae4a35d638e82b"
source="
	$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz
	hotdog-radio-bootstrap.initd
	"
builddir="$srcdir/hotdog-linux-bringup-$_commit"

build() {
	local flags
	flags="$(pkg-config --cflags --libs qmi-glib qrtr-glib gio-2.0 glib-2.0)"
	# shellcheck disable=SC2086
	$CC $CFLAGS $CPPFLAGS -std=c11 -Wall -Wextra -Werror \
		-DHOTDOG_QMI_PDC_SUBSCRIPTIONS \
		-Ihelpers/hotdog-radio \
		helpers/hotdog-radio/hotdog-radio-bootstrapd.c \
		helpers/hotdog-radio/hotdog-qmi-uim.c \
		helpers/hotdog-radio/hotdog-qmi-dms.c \
		helpers/hotdog-radio/hotdog-uim.c \
		helpers/hotdog-radio/hotdog-qmi-pdc.c \
		helpers/hotdog-radio/hotdog-qmi-pdc-list.c \
		helpers/hotdog-radio/hotdog-pdc.c \
		helpers/hotdog-radio/hotdog-mcfg.c \
		helpers/hotdog-radio/hotdog-mbn.c \
		$flags $LDFLAGS -o hotdog-radio-bootstrapd
}

package() {
	install -Dm755 "$builddir/hotdog-radio-bootstrapd" \
		"$pkgdir/usr/libexec/hotdog-radio-bootstrapd"
}

openrc() {
	install -Dm755 "$srcdir/hotdog-radio-bootstrap.initd" \
		"$subpkgdir/etc/init.d/hotdog-radio-bootstrap"
}

sha512sums="
