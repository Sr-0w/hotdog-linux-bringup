#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034,SC3043

description="Observe Hotdog UIM and subscription-scoped PDC state"
command="/usr/libexec/hotdog-radio-bootstrapd"
command_args="--node ${HOTDOG_QRTR_NODE:-0}"
observation="/run/hotdog-radio/observation"

depend() {
	need rmtfs
	after pd-mapper
	before modemmanager
}

start() {
	local temporary="${observation}.new"

	ebegin "Reading Hotdog UIM and PDC state"
	checkpath --directory --mode 0755 "${observation%/*}"
	if {
		printf 'schema=1\n'
		printf 'boot-id='
		cat /proc/sys/kernel/random/boot_id
		printf 'kernel='
		uname -r
		# shellcheck disable=SC2086
		$command $command_args
	} >"$temporary"; then
		chmod 0644 "$temporary"
		mv "$temporary" "$observation"
		eend 0
		return 0
	fi
	rm -f "$temporary"
	eend 1
}

stop() {
	rm -f "$observation" "${observation}.new"
}
