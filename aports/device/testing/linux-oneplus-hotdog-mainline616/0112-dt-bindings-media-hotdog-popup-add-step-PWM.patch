From 97ec3db317f116ef98202cb8549c80d3ab20e831 Mon Sep 17 00:00:00 2001
From: Robin Snyders <robin@snyders.xyz>
Date: Mon, 10 Aug 2026 16:50:18 +0200
Subject: [PATCH 112/114] dt-bindings: media: hotdog-popup: add step PWM

---
 .../media/oneplus,hotdog-popup-motor.yaml       | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/media/oneplus,hotdog-popup-motor.yaml b/Documentation/devicetree/bindings/media/oneplus,hotdog-popup-motor.yaml
index 7ecb4218a..c4ff28623 100644
--- a/Documentation/devicetree/bindings/media/oneplus,hotdog-popup-motor.yaml
+++ b/Documentation/devicetree/bindings/media/oneplus,hotdog-popup-motor.yaml
@@ -37,6 +37,12 @@ properties:
   step-gpios:
     maxItems: 1
 
+  pwms:
+    maxItems: 1
+
+  pwm-names:
+    const: step
+
   io-channels:
     minItems: 2
     maxItems: 2
@@ -49,9 +55,12 @@ properties:
   pinctrl-names:
     items:
       - const: default
+      - const: pwm
 
   pinctrl-0: true
 
+  pinctrl-1: true
+
 required:
   - compatible
   - '#power-domain-cells'
@@ -60,10 +69,13 @@ required:
   - mode1-gpios
   - sleep-gpios
   - step-gpios
+  - pwms
+  - pwm-names
   - io-channels
   - io-channel-names
   - pinctrl-names
   - pinctrl-0
+  - pinctrl-1
 
 additionalProperties: false
 
@@ -77,8 +89,11 @@ examples:
         mode1-gpios = <&pmic_gpio 8 0>;
         sleep-gpios = <&pmic_gpio 10 0>;
         step-gpios = <&pmic_gpio 10 0>;
+        pwms = <&pmic_pwm 3 104166>;
+        pwm-names = "step";
         io-channels = <&hall_up>, <&hall_down>;
         io-channel-names = "hall-up", "hall-down";
-        pinctrl-names = "default";
+        pinctrl-names = "default", "pwm";
         pinctrl-0 = <&motor_default>;
+        pinctrl-1 = <&motor_pwm>;
     };
-- 
2.54.0

