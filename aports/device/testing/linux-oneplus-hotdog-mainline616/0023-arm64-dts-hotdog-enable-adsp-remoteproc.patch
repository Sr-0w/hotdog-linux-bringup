From: Sr-0w <Sr-0w@users.noreply.github.com>
Date: Tue, 4 Aug 2026 10:30:00 +0200
Subject: [PATCH] arm64: dts: qcom: hotdog: enable ADSP remoteproc

Enable only the audio DSP remote processor with the packaged handset
firmware. Keep CDSP, SLIMbus, the sound card, and the unsupported TFA9894
speaker amplifier disabled so the first hardware gate measures ADSP/PAS and
APR readiness without conflating it with the codec topology.
---
 .../boot/dts/qcom/sm8150-oneplus-hotdog.dts   | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
--- a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
@@ -228,6 +228,11 @@
 	};
 };
 
+&remoteproc_adsp {
+	firmware-name = "qcom/sm8150/oneplus/hotdog/adsp.mbn";
+	status = "okay";
+};
+
 &remoteproc_mpss {
 	firmware-name = "qcom/sm8150/oneplus/hotdog/modem.mbn";
 	status = "okay";
-- 
2.50.1
