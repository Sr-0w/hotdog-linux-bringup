From: Robin Snyders <robin@snyders.xyz>
Date: Wed, 12 Aug 2026 00:00:00 +0200
Subject: [PATCH] NFC: nxp-nci: take an optional reference clock

Boards that do not fit the controller with its own crystal feed it a
reference clock from the platform. The digital side runs off an internal
oscillator either way, so a missing reference is invisible over NCI: the
controller answers every command and accepts RF_DISCOVER, and simply never
raises a carrier.

Take the clock when one is described.

Signed-off-by: Robin Snyders <robin@snyders.xyz>
---
diff --git a/drivers/nfc/nxp-nci/i2c.c b/drivers/nfc/nxp-nci/i2c.c
index 049662f..fb21abf 100644
--- a/drivers/nfc/nxp-nci/i2c.c
+++ b/drivers/nfc/nxp-nci/i2c.c
@@ -18,6 +18,7 @@
 #include <linux/interrupt.h>
 #include <linux/module.h>
 #include <linux/nfc.h>
+#include <linux/clk.h>
 #include <linux/gpio/consumer.h>
 #include <linux/unaligned.h>
 
@@ -34,6 +35,7 @@ struct nxp_nci_i2c_phy {
 	struct nci_dev *ndev;
 
 	struct gpio_desc *gpiod_en;
+	struct clk *clk;
 	struct gpio_desc *gpiod_fw;
 
 	int hard_fault; /*
@@ -298,6 +300,17 @@ static int nxp_nci_i2c_probe(struct i2c_client *client)
 		return PTR_ERR(phy->gpiod_fw);
 	}
 
+	/*
+	 * Boards that do not fit the controller with its own crystal feed it a
+	 * reference from the platform instead. The digital side runs off an
+	 * internal oscillator either way, so a missing reference is invisible
+	 * over NCI and only shows up as a carrier that never appears.
+	 */
+	phy->clk = devm_clk_get_optional_enabled(dev, NULL);
+	if (IS_ERR(phy->clk))
+		return dev_err_probe(dev, PTR_ERR(phy->clk),
+				     "Failed to get reference clock\n");
+
 	r = nxp_nci_probe(phy, &client->dev, &i2c_phy_ops,
 			  NXP_NCI_I2C_MAX_PAYLOAD, &phy->ndev);
 	if (r < 0)
