	0010-arm64-hotdog-match-working-image-size.patch
	0011-arm64-hotdog-continue-after-direct-entry-canary.patch
	0012-drm-msm-enable-native-hotdog-dsc-panel.patch
	0013-ufs-core-add-v33-ordering-diagnostics.patch
	0014-ufs-qcom-force-dma32-without-smmu.patch
	0015-arm64-dts-hotdog-source-v43-hardware-contract.patch
	0016-arm64-dts-hotdog-enable-s6sy761-touchscreen.patch
	0017-arm64-dts-hotdog-enable-adreno640-gpu.patch
	0018-arm64-dts-hotdog-enable-volume-keys.patch
	0019-arm64-dts-hotdog-enable-battery-charger.patch
	0020-power-supply-qcom-smbx-use-generation-specific-limits.patch
	0021-arm64-dts-hotdog-enable-wcn3990-wifi.patch
	0022-arm64-dts-hotdog-complete-wcn3990-mpss.patch
	0023-arm64-dts-hotdog-isolate-mpss-rmtfs.patch
	0024-arm64-dts-hotdog-enable-wifi-after-rmtfs.patch
	0025-arm64-dts-hotdog-enable-wcn3990-bluetooth.patch
	0026-arm64-dts-hotdog-select-wcn3990-firmware.patch
	0027-drm-panel-oneplus-select-stock-90hz-mode.patch
	0028-drm-panel-oneplus-dsc-expose-stock-60-and-90-Hz-mode.patch
	0029-arm64-dts-hotdog-restore-ufs-smmu.patch
	0030-ufs-core-restore-legacy-hardirq-completions.patch
	0031-arm64-dts-hotdog-reserve-xbl-aop-gap.patch
	0032-arm64-dts-hotdog-complete-stock-reservations.patch
	0033-arm64-dts-hotdog-enable-adsp.patch
	0034-arm64-dts-hotdog-enable-wcd9340.patch
	0035-arm64-dts-hotdog-add-internal-audio-card.patch
	validate-mainline616-build.sh
"
builddir="$srcdir/$_repo-$_commit"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
	make ARCH="$_carch" LLVM=1 LLVM_IAS=1 olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 LLVM_IAS=1 \
		SOURCE_DATE_EPOCH="$SOURCE_DATE_EPOCH" \
		KBUILD_BUILD_TIMESTAMP="2025-08-22 17:25:08" \
		KBUILD_BUILD_USER="postmarketOS" \
		KBUILD_BUILD_HOST="pmaports" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor" \
		Image modules dtbs

	sh "$srcdir/validate-mainline616-build.sh" \
		"arch/$_carch/boot/Image" \
		.config \
		"arch/$_carch/boot/dts/qcom/sm8150-oneplus-hotdog.dtb"
}

package() {
	mkdir -p "$pkgdir"/boot

	install -Dm644 "$builddir/arch/$_carch/boot/Image" \
		"$pkgdir/boot/vmlinuz"

	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 LLVM_IAS=1 \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir/usr" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"

	sh "$srcdir/validate-mainline616-build.sh" \
		"$pkgdir/boot/vmlinuz" \
		"$builddir/.config" \
		"$pkgdir/boot/dtbs/qcom/sm8150-oneplus-hotdog.dtb" \
		"$pkgdir/usr/lib/modules/$(cat "$builddir/include/config/kernel.release")"
}

