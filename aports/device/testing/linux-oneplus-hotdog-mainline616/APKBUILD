# Hardware-validated reference kernel for the OnePlus 7T Pro mainline port.

pkgname=linux-oneplus-hotdog-mainline616
pkgver=6.16.0
pkgrel=4
pkgdesc="Hardware-validated mainline 6.16 reference kernel for OnePlus 7T Pro"
maintainer="Sr-0w <Sr-0w@users.noreply.github.com>"
arch="aarch64"
_carch="arm64"
_flavor="oneplus-hotdog-mainline616"
url="https://github.com/ClearStaff/linux-sm8150-mainline-hotdog"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-nftables
	"
makedepends="
	bash
	bc
	bison
	clang
	dtc
	findutils
	flex
	lld
	llvm
	openssl-dev
	perl
	python3
	zstd
"

_repo="linux-sm8150-mainline-hotdog"
_commit="403b56c33e2ccdda25d90378970a5e5b928dee19"
export SOURCE_DATE_EPOCH=1755883508
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/ClearStaff/$_repo/archive/$_commit.tar.gz
	$_config
	0001-input-fts-fix-llvm-prototypes.patch
	0002-arm64-hotdog-direct-entry.patch
	0003-arm64-hotdog-early-entry-diagnostics.patch
	0004-arm64-hotdog-isolate-pre-cpu-entry.patch
	0005-arm64-hotdog-post-el-entry-diagnostics.patch
	0006-arm64-hotdog-persistent-entry-markers.patch
	0007-arm64-hotdog-remove-visual-entry-delays.patch
	0008-arm64-hotdog-native-pmsg-and-visual-stages.patch
	0009-arm64-hotdog-first-entry-canary.patch
	0010-arm64-hotdog-match-working-image-size.patch
	0011-arm64-hotdog-continue-after-direct-entry-canary.patch
	0012-drm-msm-enable-native-hotdog-dsc-panel.patch
	0013-ufs-core-add-v33-ordering-diagnostics.patch
	0014-ufs-qcom-force-dma32-without-smmu.patch
	0015-arm64-dts-hotdog-source-v43-hardware-contract.patch
	0016-arm64-dts-hotdog-enable-s6sy761-touchscreen.patch
	validate-mainline616-build.sh
"
builddir="$srcdir/$_repo-$_commit"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
	make ARCH="$_carch" LLVM=1 LLVM_IAS=1 olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 LLVM_IAS=1 \
		SOURCE_DATE_EPOCH="$SOURCE_DATE_EPOCH" \
		KBUILD_BUILD_TIMESTAMP="2025-08-22 17:25:08" \
		KBUILD_BUILD_USER="postmarketOS" \
		KBUILD_BUILD_HOST="pmaports" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor" \
		Image modules dtbs

	sh "$srcdir/validate-mainline616-build.sh" \
		"arch/$_carch/boot/Image" \
		.config \
		"arch/$_carch/boot/dts/qcom/sm8150-oneplus-hotdog.dtb"
}

package() {
	mkdir -p "$pkgdir"/boot

	install -Dm644 "$builddir/arch/$_carch/boot/Image" \
		"$pkgdir/boot/vmlinuz"

	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 LLVM_IAS=1 \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir/usr" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"

	sh "$srcdir/validate-mainline616-build.sh" \
		"$pkgdir/boot/vmlinuz" \
		"$builddir/.config" \
		"$pkgdir/boot/dtbs/qcom/sm8150-oneplus-hotdog.dtb" \
		"$pkgdir/usr/lib/modules/$(cat "$builddir/include/config/kernel.release")"
}

