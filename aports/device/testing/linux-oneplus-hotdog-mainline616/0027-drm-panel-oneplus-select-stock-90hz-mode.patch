From 18fbc0e8b86d1fb40f0fc7261386f378d04bde16 Mon Sep 17 00:00:00 2001
From: Robin Snyders <robin@snyders.xyz>
Date: Tue, 4 Aug 2026 20:42:00 +0200
Subject: [PATCH] drm: panel: oneplus-dsc: select the stock 90 Hz mode

The HD1913 stock panel description uses the same 1.1 GHz DSI link clock
for its 60 Hz and 90 Hz modes.  The 90 Hz mode reaches the higher refresh
rate by reducing vertical blanking from 1584 to 16 lines while retaining
the proven 1440x3120 DSC transport.  It also selects control-display value
0x30 instead of the 60 Hz value 0x20.

Use those exact stock values and expose only the 90 Hz mode for this
hardware-validation revision.  Dynamic switching is deliberately left for
a follow-up so userspace cannot select a 60 Hz mode without the matching
panel command sequence.

Signed-off-by: Robin Snyders <robin@snyders.xyz>
---
 drivers/gpu/drm/panel/panel-samsung-oneplus-dsc.c | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-oneplus-dsc.c b/drivers/gpu/drm/panel/panel-samsung-oneplus-dsc.c
index 179550c78208..ec8951179454 100644
--- a/drivers/gpu/drm/panel/panel-samsung-oneplus-dsc.c
+++ b/drivers/gpu/drm/panel/panel-samsung-oneplus-dsc.c
@@ -108,7 +108,7 @@ static int samsung_oneplus_dsc_on(struct samsung_oneplus_dsc *ctx)
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x02);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb5, 0xd3);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
-				     0x20);
+				     0x30);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
 	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
 
@@ -186,16 +186,16 @@ static int samsung_oneplus_dsc_unprepare(struct drm_panel *panel)
 	return 0;
 }
 
-static const struct drm_display_mode samsung_oneplus_dsc_mode = {
-	.clock = (1440 + 16 + 8 + 8) * (3120 + 400 + 28 + 1156) * 60 / 1000,
+static const struct drm_display_mode samsung_oneplus_dsc_90hz_mode = {
+	.clock = (1440 + 16 + 8 + 8) * (3120 + 4 + 4 + 8) * 90 / 1000,
 	.hdisplay = 1440,
 	.hsync_start = 1440 + 16,
 	.hsync_end = 1440 + 16 + 8,
 	.htotal = 1440 + 16 + 8 + 8,
 	.vdisplay = 3120,
-	.vsync_start = 3120 + 400,
-	.vsync_end = 3120 + 400 + 28,
-	.vtotal = 3120 + 400 + 28 + 1156,
+	.vsync_start = 3120 + 4,
+	.vsync_end = 3120 + 4 + 4,
+	.vtotal = 3120 + 4 + 4 + 8,
 	.width_mm = 71,
 	.height_mm = 154,
 	.type = DRM_MODE_TYPE_DRIVER,
@@ -204,7 +204,7 @@ static const struct drm_display_mode samsung_oneplus_dsc_mode = {
 static int samsung_oneplus_dsc_get_modes(struct drm_panel *panel,
 					 struct drm_connector *connector)
 {
-	return drm_connector_helper_get_modes_fixed(connector, &samsung_oneplus_dsc_mode);
+	return drm_connector_helper_get_modes_fixed(connector, &samsung_oneplus_dsc_90hz_mode);
 }
 
 static const struct drm_panel_funcs samsung_oneplus_dsc_panel_funcs = {
-- 
2.50.1

