From 67c0f264445448f06f418be53bdcd1260873bcfe Mon Sep 17 00:00:00 2001
From: Robin Snyders <robin@snyders.xyz>
Date: Mon, 10 Aug 2026 10:36:10 +0200
Subject: [PATCH] media: add OnePlus hotdog IMX481 ultra-wide camera

---
 .../boot/dts/qcom/sm8150-oneplus-hotdog.dts   |   37 +-
 drivers/media/i2c/Kconfig                     |   11 +
 drivers/media/i2c/Makefile                    |    1 +
 drivers/media/i2c/imx481.c                    | 1464 +++++++++++++++++
 4 files changed, 1508 insertions(+), 5 deletions(-)
 create mode 100644 drivers/media/i2c/imx481.c

diff --git a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
index 10dffc8cf..078d4a40b 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
@@ -1016,6 +1016,12 @@ &vreg_l1f_1p1 {
 				   RPMH_REGULATOR_MODE_HPM>;
 };
 
+&vreg_l4f_1p05 {
+	regulator-allow-set-load;
+	regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
+				   RPMH_REGULATOR_MODE_HPM>;
+};
+
 &cci1_i2c0 {
 	camera-scan@7f {
 		compatible = "oneplus,hotdog-camera-scan";
@@ -1038,23 +1044,35 @@ camera-scan@7f {
 };
 
 &cci1_i2c1 {
-	camera-scan@7f {
-		compatible = "oneplus,hotdog-camera-scan";
-		reg = <0x7f>;
+	/* Ultra-wide rear camera, identified on hardware by its 0x0481 chip id. */
+	camera@1a {
+		compatible = "sony,imx481";
+		reg = <0x1a>;
+		orientation = <1>;
+		rotation = <90>;
 
 		clocks = <&camcc CAM_CC_MCLK3_CLK>;
 		assigned-clocks = <&camcc CAM_CC_MCLK3_CLK>;
-		assigned-clock-rates = <24000000>;
+		assigned-clock-rates = <19200000>;
 
 		vio-supply = <&vreg_l1c_1p8>;
 		vana-supply = <&vreg_bob>;
 		vdig-supply = <&vreg_l4f_1p05>;
 
 		reset-gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
-		vana-enable-gpios = <&pm8150l_gpios 2 GPIO_ACTIVE_LOW>;
+		vana-enable-gpios = <&pm8150l_gpios 2 GPIO_ACTIVE_HIGH>;
 
 		pinctrl-names = "default";
 		pinctrl-0 = <&cam_mclk3_default>;
+
+		port {
+			imx481_ep: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				data-lanes = <0 1 2 3>;
+				link-frequencies = /bits/ 64 <654075000>;
+				remote-endpoint = <&csiphy3_ep>;
+			};
+		};
 	};
 };
 
@@ -1080,6 +1098,15 @@ csiphy1_ep: endpoint {
 				remote-endpoint = <&imx586_ep>;
 			};
 		};
+
+		port@3 {
+			reg = <3>;
+
+			csiphy3_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&imx481_ep>;
+			};
+		};
 	};
 };
 
diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 97ae3edf2..1a63b90a6 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -266,6 +266,17 @@ config VIDEO_IMX586
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx586.
 
+config VIDEO_IMX481
+	tristate "Sony IMX481 sensor support"
+	depends on OF_GPIO
+	help
+	  This is a Video4Linux2 sensor driver for the Sony IMX481
+	  16 megapixel camera sensor. It supports raw Bayer capture,
+	  exposure and analogue gain controls over a MIPI D-PHY link.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx481.
+
 config VIDEO_IMX415
 	tristate "Sony IMX415 sensor support"
 	depends on OF_GPIO
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 2e65209f0..6cb9b23df 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -58,6 +58,7 @@ obj-$(CONFIG_VIDEO_IMX334) += imx334.o
 obj-$(CONFIG_VIDEO_IMX335) += imx335.o
 obj-$(CONFIG_VIDEO_IMX355) += imx355.o
 obj-$(CONFIG_VIDEO_IMX412) += imx412.o
+obj-$(CONFIG_VIDEO_IMX481) += imx481.o
 obj-$(CONFIG_VIDEO_IMX586) += imx586.o
 obj-$(CONFIG_VIDEO_IMX415) += imx415.o
 obj-$(CONFIG_VIDEO_IR_I2C) += ir-kbd-i2c.o
