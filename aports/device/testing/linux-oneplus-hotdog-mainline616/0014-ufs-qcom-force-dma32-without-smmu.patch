From 0000000000000000000000000000000000000014 Mon Sep 17 00:00:00 2001
From: Sr-0w <Sr-0w@users.noreply.github.com>
Date: Mon, 3 Aug 2026 18:25:00 +0200
Subject: [PATCH] ufs: qcom: constrain SM8150 DMA to 32 bits

Direct boot exposes memory above 4 GiB, where the SM8150 UFS controller has
consumed a doorbell but left OCS at 0xf and never written a response UPIU.
Keep its coherent request lists in a 32-bit DMA aperture both with an Apps
SMMU translated domain and with the temporary bypass configuration.

This is a targeted bring-up workaround while the lost-completion failure is
being isolated. It does not replace the restored SMMU link.

---
 drivers/ufs/host/ufs-qcom.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/drivers/ufs/host/ufs-qcom.c b/drivers/ufs/host/ufs-qcom.c
index 18a978452001..785bd2c4ee51 100644
--- a/drivers/ufs/host/ufs-qcom.c
+++ b/drivers/ufs/host/ufs-qcom.c
@@ -8,6 +8,7 @@
 #include <linux/cleanup.h>
 #include <linux/delay.h>
 #include <linux/devfreq.h>
+#include <linux/dma-mapping.h>
 #include <linux/gpio/consumer.h>
 #include <linux/interconnect.h>
 #include <linux/module.h>
@@ -2191,6 +2192,25 @@ static u32 ufs_qcom_freq_to_gear_speed(struct ufs_hba *hba, unsigned long freq)
 	return min_t(u32, gear, hba->max_pwr_info.info.gear_rx);
 }
 
+static int ufs_qcom_set_dma_mask(struct ufs_hba *hba)
+{
+	/*
+	 * Keep SM8150 request lists in the known-good 32-bit DMA aperture even
+	 * when the host is attached to an Apps SMMU translated domain.
+	 */
+	if (of_device_is_compatible(hba->dev->of_node, "qcom,sm8150-ufshc")) {
+		dev_info(hba->dev,
+			 "SM8150 UFS DMA mask constrained to 32-bit\n");
+		return dma_set_mask_and_coherent(hba->dev, DMA_BIT_MASK(32));
+	}
+
+	if (hba->capabilities & MASK_64_ADDRESSING_SUPPORT &&
+	    !dma_set_mask_and_coherent(hba->dev, DMA_BIT_MASK(64)))
+		return 0;
+
+	return dma_set_mask_and_coherent(hba->dev, DMA_BIT_MASK(32));
+}
+
 /*
  * struct ufs_hba_qcom_vops - UFS QCOM specific variant operations
  *
@@ -2199,6 +2219,7 @@ static u32 ufs_qcom_freq_to_gear_speed(struct ufs_hba *hba, unsigned long freq)
  */
 static const struct ufs_hba_variant_ops ufs_hba_qcom_vops = {
 	.name                   = "qcom",
+	.set_dma_mask		= ufs_qcom_set_dma_mask,
 	.init                   = ufs_qcom_init,
 	.exit                   = ufs_qcom_exit,
 	.get_ufs_hci_version	= ufs_qcom_get_ufs_hci_version,
-- 
