From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sr-0w <Sr-0w@users.noreply.github.com>
Date: Sat, 8 Aug 2026 01:20:00 +0200
Subject: [PATCH] arm64: dts: qcom: hotdog: describe the four camera slots

Attach the identification aid to each of the four camera slots, with the
supplies, enable GPIOs, reset line and MCLK the stock device tree gives for
each.

The slot to bus mapping comes from the stock overlay's cci-device and
cci-master pairs: slot 0 is CCI0 master 1, slot 1 is CCI0 master 0, slot 2 is
CCI1 master 0 and slot 3 is CCI1 master 1.

The digital rails are the three PM8009 LDOs just added plus ldo2, which slot 1
shares with nothing else. MCLK is requested at 24 MHz rather than the 19.2 MHz
the stock tree uses, because the clock is generated by the SoC and the upstream
sensor drivers' register sequences are written for 24 MHz.

Signed-off-by: Sr-0w <Sr-0w@users.noreply.github.com>
---
 .../boot/dts/qcom/sm8150-oneplus-hotdog.dts | 132 ++++++++++++++++++
 1 file changed, 132 insertions(+)

--- a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
@@ -223,6 +223,34 @@
 };
 
 &tlmm {
+	cam_mclk0_default: cam-mclk0-default-state {
+		pins = "gpio13";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mclk1_default: cam-mclk1-default-state {
+		pins = "gpio14";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mclk2_default: cam-mclk2-default-state {
+		pins = "gpio15";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mclk3_default: cam-mclk3-default-state {
+		pins = "gpio16";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	fsa_usbc_ana_en: fsa-usbc-ana-en-state {
 		pins = "gpio100";
 		function = "gpio";
@@ -770,10 +798,102 @@
 	status = "okay";
 };
 
+/*
+ * The four camera slots, described only far enough for the identification aid
+ * to power them up. Each slot's analogue rail comes from the boost converter
+ * through a switch the slot controls itself, so both the supply and its enable
+ * GPIOs are given. Reset is active low.
+ */
+&cci0_i2c0 {
+	camera-scan@7f {
+		compatible = "oneplus,hotdog-camera-scan";
+		reg = <0x7f>;
+
+		clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		vio-supply = <&vreg_l1c_1p8>;
+		vana-supply = <&vreg_bob>;
+		vdig-supply = <&vreg_l2f_1p2>;
+
+		reset-gpios = <&tlmm 28 GPIO_ACTIVE_LOW>;
+		vana-enable-gpios = <&tlmm 148 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_mclk0_default>;
+	};
+};
+
+&cci0_i2c1 {
+	camera-scan@7f {
+		compatible = "oneplus,hotdog-camera-scan";
+		reg = <0x7f>;
+
+		clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		vio-supply = <&vreg_l1c_1p8>;
+		vana-supply = <&vreg_bob>;
+		vdig-supply = <&vreg_l1f_1p1>;
+
+		reset-gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;
+		vana-enable-gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>,
+				    <&tlmm 29 GPIO_ACTIVE_HIGH>,
+				    <&pm8150l_gpios 1 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_mclk1_default>;
+	};
+};
+
 &cci1 {
 	status = "okay";
 };
 
+&cci1_i2c0 {
+	camera-scan@7f {
+		compatible = "oneplus,hotdog-camera-scan";
+		reg = <0x7f>;
+
+		clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		vio-supply = <&vreg_l1c_1p8>;
+		vana-supply = <&vreg_bob>;
+		vdig-supply = <&vreg_l3f_1p05>;
+
+		reset-gpios = <&tlmm 12 GPIO_ACTIVE_LOW>;
+		vana-enable-gpios = <&pm8150l_gpios 12 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_mclk2_default>;
+	};
+};
+
+&cci1_i2c1 {
+	camera-scan@7f {
+		compatible = "oneplus,hotdog-camera-scan";
+		reg = <0x7f>;
+
+		clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		vio-supply = <&vreg_l1c_1p8>;
+		vana-supply = <&vreg_bob>;
+		vdig-supply = <&vreg_l4f_1p05>;
+
+		reset-gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
+		vana-enable-gpios = <&pm8150l_gpios 2 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_mclk3_default>;
+	};
+};
+
 &camss {
 	status = "okay";
 };
--
2.50.1
