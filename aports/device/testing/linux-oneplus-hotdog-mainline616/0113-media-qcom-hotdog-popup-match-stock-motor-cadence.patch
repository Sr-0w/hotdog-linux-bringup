-	usleep_range(40, 60);
-}
-
-static void hotdog_popup_drive_exact(struct hotdog_popup *popup, bool upward,
-				     unsigned int microsteps)
+static int hotdog_popup_drive_exact(struct hotdog_popup *popup, bool upward,
+				    unsigned int microsteps)
 {
-	unsigned int i;
+	u64 duration_us;
+	int ret;
 
 	hotdog_popup_power_on(popup, upward);
-	for (i = 0; i < microsteps; i++)
