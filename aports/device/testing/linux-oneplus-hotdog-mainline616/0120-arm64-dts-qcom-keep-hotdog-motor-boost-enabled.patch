From 019eca0e1dd361a3c03051142ae5d219a6e99155 Mon Sep 17 00:00:00 2001
From: Robin Snyders <robin@snyders.xyz>
Date: Mon, 10 Aug 2026 18:04:53 +0200
Subject: [PATCH] arm64: dts: qcom: keep hotdog motor boost enabled

---
 arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
index ffbc28227..326102233 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
@@ -262,7 +262,7 @@ motor_boost_default: motor-boost-default-state {
 		pins = "gpio12";
 		function = "normal";
 		power-source = <0>;
-		output-low;
+		output-high;
 		input-disable;
 	};
 };
