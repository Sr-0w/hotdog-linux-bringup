diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index ca04b338cb0d..36871310b388 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -42,6 +42,44 @@
 #error PAGE_OFFSET must be at least 2MB aligned
 #endif
 
+/*
+ * Draw cumulative white checkpoints in the bootloader-provided framebuffer.
+ * The 1440x3120 a8r8g8b8 scanout starts at 0x9c000000 with a 5760-byte
+ * stride. This is temporary direct-boot instrumentation, not a display
+ * driver.
+ */
+	.macro	hotdog_fb_stage slot, cached=0
+	mov	x11, #0x9c000000
+	movz	x12, #0x16, lsl #16
+	add	x12, x12, #8, lsl #12	// row 256: 0x168000
+	add	x11, x11, x12
+	mov	x17, #(\slot * 896)		// 224 pixels per slot
+	add	x11, x11, x17
+	movz	w12, #0xffff
+	movk	w12, #0x00ff, lsl #16	// a8r8g8b8 white
+	mov	x13, #96
+.Lhotdog_fb_row\@:
+	mov	x16, x11
+	mov	x14, #160
+.Lhotdog_fb_pixel\@:
+	str	w12, [x11], #4
+	subs	x14, x14, #1
+	b.ne	.Lhotdog_fb_pixel\@
+	.if \cached
+	mov	x14, #10
+.Lhotdog_fb_flush\@:
+	dc	cvac, x16
+	add	x16, x16, #64
+	subs	x14, x14, #1
+	b.ne	.Lhotdog_fb_flush\@
+	.endif
+	mov	x15, #5120			// stride - 160 * 4
+	add	x11, x11, x15
+	subs	x13, x13, #1
+	b.ne	.Lhotdog_fb_row\@
+	dsb	sy
+	.endm
+
 /*
  * Kernel startup entry point.
  * ---------------------------
@@ -58,9 +96,14 @@
 	/*
 	 * DO NOT MODIFY. Image header expected by Linux boot-loaders.
 	 */
+#ifdef CONFIG_EFI
 	efi_signature_nop			// special NOP to identity as PE/COFF executable
 	b	primary_entry			// branch to kernel start, magic
-	.quad	0				// Image load offset from start of RAM, little-endian
+#else
+	b	primary_entry			// stock Android entry layout
+	.long	0				// reserved / stock-compatible code1
+#endif
+	.quad	0x00080000			// Image load offset from start of RAM, little-endian
 	le64sym	_kernel_size_le			// Effective size of kernel image, little-endian
 	le64sym	_kernel_flags_le		// Informative flags, little-endian
 	.quad	0				// reserved
@@ -127,6 +170,13 @@ SYM_CODE_START(primary_entry)
 	 * the TCR will have been set.
 	 */
 	bl	__cpu_setup			// initialise processor
+
+	/* Prevent an inherited APSS watchdog from expiring during early boot. */
+	movz	x9, #0x17c1, lsl #16		// APSS WDT: 0x17c10000
+	str	wzr, [x9, #0x08]		// WDT0_EN = 0
+	dsb	sy
+
+	hotdog_fb_stage 0
 	b	__primary_switch
 SYM_CODE_END(primary_entry)
 
@@ -218,6 +268,7 @@ SYM_CODE_END(preserve_boot_args)
  *   x0 = __pa(KERNEL_START)
  */
 SYM_FUNC_START_LOCAL(__primary_switched)
+	hotdog_fb_stage 4, 1
 	adr_l	x4, init_task
 	init_cpu_task x4, x5, x6
 
@@ -506,9 +557,11 @@ SYM_FUNC_START_LOCAL(__no_granule_support)
 SYM_FUNC_END(__no_granule_support)
 
 SYM_FUNC_START_LOCAL(__primary_switch)
+	hotdog_fb_stage 1
 	adrp	x1, reserved_pg_dir
 	adrp	x2, __pi_init_idmap_pg_dir
 	bl	__enable_mmu
+	hotdog_fb_stage 2, 1
 
 	adrp	x1, early_init_stack
 	mov	sp, x1
@@ -516,6 +569,7 @@ SYM_FUNC_START_LOCAL(__primary_switch)
 	mov	x0, x20				// pass the full boot status
 	mov	x1, x21				// pass the FDT
 	bl	__pi_early_map_kernel		// Map and relocate the kernel
+	hotdog_fb_stage 3, 1
 
 	ldr	x8, =__primary_switched
 	adrp	x0, KERNEL_START		// __pa(KERNEL_START)
