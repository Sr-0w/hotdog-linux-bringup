Subject: [PATCH 2/2] input: add Awinic AW8697 haptics support

---
 .../boot/dts/qcom/sm8150-oneplus-hotdog.dts   |   8 +
 drivers/input/misc/Kconfig                    |  13 +
 drivers/input/misc/Makefile                   |   1 +
 drivers/input/misc/aw8697-haptics.c           | 417 ++++++++++++++++++
 4 files changed, 439 insertions(+)
 create mode 100644 drivers/input/misc/aw8697-haptics.c

diff --git a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
index d3c2605da..505ccbb75 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
@@ -546,6 +546,14 @@ &i2c7 {
 	/delete-property/ dma-names;
 	clock-frequency = <400000>;
 	status = "okay";
+
+	haptics@5a {
+		compatible = "awinic,aw8697";
+		reg = <0x5a>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <24 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&tlmm 116 GPIO_ACTIVE_LOW>;
+	};
 };
 
 &qupv3_id_2 {
diff --git a/drivers/input/misc/Kconfig b/drivers/input/misc/Kconfig
index f5496ca0c..69812961a 100644
--- a/drivers/input/misc/Kconfig
+++ b/drivers/input/misc/Kconfig
@@ -101,6 +101,19 @@ config INPUT_ARIZONA_HAPTICS
 	  To compile this driver as a module, choose M here: the
 	  module will be called arizona-haptics.
 
+config INPUT_AW8697_HAPTICS
+	tristate "Awinic AW8697 haptics support"
+	depends on I2C
+	select INPUT_FF_MEMLESS
+	select REGMAP_I2C
+	help
+	  Say Y to enable support for the Awinic AW8697 LRA haptics
+	  controller. The device is exposed through the input force-feedback
+	  interface with rumble intensity control.
+
+	  To compile this driver as a module, choose M here: the module will be
+	  called aw8697-haptics.
+
 config INPUT_ATC260X_ONKEY
 	tristate "Actions Semi ATC260x PMIC ONKEY"
 	depends on MFD_ATC260X
diff --git a/drivers/input/misc/Makefile b/drivers/input/misc/Makefile
index 6d91804d0..7cca14957 100644
--- a/drivers/input/misc/Makefile
+++ b/drivers/input/misc/Makefile
@@ -18,6 +18,7 @@ obj-$(CONFIG_INPUT_ADXL34X_SPI)		+= adxl34x-spi.o
 obj-$(CONFIG_INPUT_APANEL)		+= apanel.o
 obj-$(CONFIG_INPUT_ARIEL_PWRBUTTON)	+= ariel-pwrbutton.o
 obj-$(CONFIG_INPUT_ARIZONA_HAPTICS)	+= arizona-haptics.o
