 	u8 num_lanes = csiphy->cfg.csi2->lane_cfg.num_data;
 	u8 val;
 
+	if (cfg->csi2->lane_cfg.bus_type == V4L2_MBUS_CSI2_CPHY &&
+	    !csiphy->regs->cphy_lane_regs) {
+		dev_err(csiphy->camss->dev,
+			"C-PHY is not supported by this CSIPHY version\n");
+		return -EOPNOTSUPP;
+	}
+
 	link_freq = camss_get_link_freq(&csiphy->subdev.entity, bpp, num_lanes);
 
 	if (link_freq < 0) {
