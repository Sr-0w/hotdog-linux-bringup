 /* GEN2 1.2.1 2PH */
 static const struct
 csiphy_lane_regs lane_regs_sm8250[] = {
@@ -615,13 +754,13 @@ static irqreturn_t csiphy_isr(int irq, void *dev)
  * Return settle count value or 0 if the CSI2 link frequency
  * is not available
  */
-static u8 csiphy_settle_cnt_calc(s64 link_freq, u32 timer_clk_rate)
+static u16 csiphy_settle_cnt_calc(s64 link_freq, u32 timer_clk_rate)
 {
 	u32 ui; /* ps */
 	u32 timer_period; /* ps */
 	u32 t_hs_prepare_max; /* ps */
 	u32 t_hs_settle; /* ps */
-	u8 settle_cnt;
+	u16 settle_cnt;
 
 	if (link_freq <= 0)
 		return 0;
@@ -639,7 +778,7 @@ static u8 csiphy_settle_cnt_calc(s64 link_freq, u32 timer_clk_rate)
 
 static void csiphy_gen1_config_lanes(struct csiphy_device *csiphy,
 				     struct csiphy_config *cfg,
-				     u8 settle_cnt)
+				     u16 settle_cnt)
 {
 	struct csiphy_lanes_cfg *c = &cfg->csi2->lane_cfg;
 	int i, l = 0;
@@ -699,11 +838,11 @@ static void csiphy_gen1_config_lanes(struct csiphy_device *csiphy,
 	writel_relaxed(val, csiphy->base + CSIPHY_3PH_LNn_MISC1(l));
 }
 
-static void csiphy_gen2_config_lanes(struct csiphy_device *csiphy,
-				     u8 settle_cnt)
+static void csiphy_gen2_write_regs(struct csiphy_device *csiphy,
+				   const struct csiphy_lane_regs *r,
+				   int array_size, u16 settle_cnt)
 {
-	const struct csiphy_lane_regs *r = csiphy->regs->lane_regs;
-	int i, array_size = csiphy->regs->lane_array_size;
+	int i;
 	u32 val;
 
 	for (i = 0; i < array_size; i++, r++) {
@@ -711,6 +850,9 @@ static void csiphy_gen2_config_lanes(struct csiphy_device *csiphy,
 		case CSIPHY_SETTLE_CNT_LOWER_BYTE:
 			val = settle_cnt & 0xff;
 			break;
+		case CSIPHY_SETTLE_CNT_HIGHER_BYTE:
+			val = settle_cnt >> 8;
+			break;
 		case CSIPHY_SKEW_CAL:
 			/* TODO: support application of skew from dt flag */
 			continue;
@@ -726,15 +868,40 @@ static void csiphy_gen2_config_lanes(struct csiphy_device *csiphy,
 	}
 }
 
+static void csiphy_gen2_config_lanes(struct csiphy_device *csiphy,
+				     struct csiphy_config *cfg,
+				     u16 settle_cnt)
+{
+	struct csiphy_lanes_cfg *lanes = &cfg->csi2->lane_cfg;
+	struct csiphy_device_regs *regs = csiphy->regs;
+	int i;
+
+	if (lanes->bus_type != V4L2_MBUS_CSI2_CPHY) {
+		csiphy_gen2_write_regs(csiphy, regs->lane_regs,
+				       regs->lane_array_size, settle_cnt);
+		return;
+	}
+
+	for (i = 0; i < lanes->num_data; i++) {
+		const struct csiphy_lane_regs *r;
+
+		r = regs->cphy_lane_regs +
+			lanes->data[i].pos * regs->cphy_lane_array_size;
+		csiphy_gen2_write_regs(csiphy, r, regs->cphy_lane_array_size,
+				       settle_cnt);
+	}
+}
+
 static u8 csiphy_get_lane_mask(struct csiphy_lanes_cfg *lane_cfg)
 {
 	u8 lane_mask;
 	int i;
 
-	lane_mask = CSIPHY_3PH_CMN_CSI_COMMON_CTRL5_CLK_ENABLE;
+	lane_mask = lane_cfg->bus_type == V4L2_MBUS_CSI2_CPHY ? 0 :
+		CSIPHY_3PH_CMN_CSI_COMMON_CTRL5_CLK_ENABLE;
 
 	for (i = 0; i < lane_cfg->num_data; i++)
-		lane_mask |= 1 << lane_cfg->data[i].pos;
+		lane_mask |= BIT(lane_cfg->data[i].pos);
 
 	return lane_mask;
 }
@@ -764,15 +931,21 @@ static void csiphy_lanes_enable(struct csiphy_device *csiphy,
 {
 	struct csiphy_lanes_cfg *c = &cfg->csi2->lane_cfg;
 	struct csiphy_device_regs *regs = csiphy->regs;
-	u8 settle_cnt;
+	u16 settle_cnt;
 	u8 val;
 	int i;
 
 	settle_cnt = csiphy_settle_cnt_calc(link_freq, csiphy->timer_clk_rate);
 
-	val = CSIPHY_3PH_CMN_CSI_COMMON_CTRL5_CLK_ENABLE;
-	for (i = 0; i < c->num_data; i++)
-		val |= BIT(c->data[i].pos * 2);
+	if (c->bus_type == V4L2_MBUS_CSI2_CPHY) {
+		val = 0;
+		for (i = 0; i < c->num_data; i++)
+			val |= BIT(c->data[i].pos * 2 + 1);
+	} else {
+		val = CSIPHY_3PH_CMN_CSI_COMMON_CTRL5_CLK_ENABLE;
+		for (i = 0; i < c->num_data; i++)
+			val |= BIT(c->data[i].pos * 2);
+	}
 
 	writel_relaxed(val, csiphy->base +
 		       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 5));
@@ -790,7 +963,7 @@ static void csiphy_lanes_enable(struct csiphy_device *csiphy,
 		       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 0));
 
 	if (csiphy_is_gen2(csiphy->camss->res->version))
-		csiphy_gen2_config_lanes(csiphy, settle_cnt);
+		csiphy_gen2_config_lanes(csiphy, cfg, settle_cnt);
 	else
 		csiphy_gen1_config_lanes(csiphy, cfg, settle_cnt);
 
@@ -839,6 +1012,8 @@ static int csiphy_init(struct csiphy_device *csiphy)
 	case CAMSS_8150:
 		regs->lane_regs = &lane_regs_sc8280xp[0];
 		regs->lane_array_size = ARRAY_SIZE(lane_regs_sc8280xp);
+		regs->cphy_lane_regs = &lane_regs_sm8150_cphy[0][0];
+		regs->cphy_lane_array_size = ARRAY_SIZE(lane_regs_sm8150_cphy[0]);
 		break;
 	case CAMSS_7280:
 	case CAMSS_8250:
diff --git a/drivers/media/platform/qcom/camss/camss-csiphy.c b/drivers/media/platform/qcom/camss/camss-csiphy.c
