--- a/drivers/media/platform/qcom/camss/camss.c
+++ b/drivers/media/platform/qcom/camss/camss.c
@@ -3199,11 +3199,8 @@ static int camss_of_parse_endpoint_node(struct device *dev,
 	if (ret)
 		return ret;
 
-	/*
-	 * Most SoCs support both D-PHY and C-PHY standards, but currently only
-	 * D-PHY is supported in the driver.
-	 */
-	if (vep.bus_type != V4L2_MBUS_CSI2_DPHY) {
+	if (vep.bus_type != V4L2_MBUS_CSI2_DPHY &&
+	    vep.bus_type != V4L2_MBUS_CSI2_CPHY) {
 		dev_err(dev, "Unsupported bus type %d\n", vep.bus_type);
 		return -EINVAL;
 	}
@@ -3211,9 +3208,16 @@ static int camss_of_parse_endpoint_node(struct device *dev,
 	csd->interface.csiphy_id = vep.base.port;
 
 	mipi_csi2 = &vep.bus.mipi_csi2;
-	lncfg->clk.pos = mipi_csi2->clock_lane;
-	lncfg->clk.pol = mipi_csi2->lane_polarities[0];
+	lncfg->bus_type = vep.bus_type;
+	if (vep.bus_type == V4L2_MBUS_CSI2_DPHY) {
+		lncfg->clk.pos = mipi_csi2->clock_lane;
+		lncfg->clk.pol = mipi_csi2->lane_polarities[0];
+	}
 	lncfg->num_data = mipi_csi2->num_data_lanes;
+	if (vep.bus_type == V4L2_MBUS_CSI2_CPHY && lncfg->num_data > 3) {
+		dev_err(dev, "C-PHY supports at most three trios\n");
+		return -EINVAL;
+	}
 
 	lncfg->data = devm_kcalloc(dev,
 				   lncfg->num_data, sizeof(*lncfg->data),
@@ -3223,7 +3227,19 @@ static int camss_of_parse_endpoint_node(struct device *dev,
 
 	for (i = 0; i < lncfg->num_data; i++) {
 		lncfg->data[i].pos = mipi_csi2->data_lanes[i];
-		lncfg->data[i].pol = mipi_csi2->lane_polarities[i + 1];
+		if (vep.bus_type == V4L2_MBUS_CSI2_CPHY &&
+		    lncfg->data[i].pos >= 3) {
+			dev_err(dev, "Invalid C-PHY trio position %u\n",
+				lncfg->data[i].pos);
+			return -EINVAL;
+		}
+		if (vep.bus_type == V4L2_MBUS_CSI2_DPHY)
+			lncfg->data[i].pol = mipi_csi2->lane_polarities[i + 1];
+		else if (mipi_csi2->line_orders[i] !=
+			 V4L2_MBUS_CSI2_CPHY_LINE_ORDER_ABC) {
+			dev_err(dev, "Unsupported C-PHY line order on trio %u\n", i);
+			return -EINVAL;
+		}
 	}
 
 	return 0;
