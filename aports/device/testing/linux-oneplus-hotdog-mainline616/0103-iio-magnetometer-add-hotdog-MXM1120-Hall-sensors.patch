From f68739b4928b84a71ee5a70359cbdd7a3bf3055a Mon Sep 17 00:00:00 2001
From: Robin Snyders <robin@snyders.xyz>
Date: Mon, 10 Aug 2026 12:37:35 +0200
Subject: [PATCH] iio: magnetometer: add hotdog MXM1120 Hall sensors

---
 .../iio/magnetometer/magnachip,mxm1120.yaml   |  49 +++++
 .../devicetree/bindings/vendor-prefixes.yaml  |   2 +
 .../boot/dts/qcom/sm8150-oneplus-hotdog.dts   |  23 ++
 drivers/iio/magnetometer/Kconfig              |  11 +
 drivers/iio/magnetometer/Makefile             |   1 +
 drivers/iio/magnetometer/mxm1120.c            | 202 ++++++++++++++++++
 6 files changed, 288 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/iio/magnetometer/magnachip,mxm1120.yaml
 create mode 100644 drivers/iio/magnetometer/mxm1120.c

diff --git a/Documentation/devicetree/bindings/iio/magnetometer/magnachip,mxm1120.yaml b/Documentation/devicetree/bindings/iio/magnetometer/magnachip,mxm1120.yaml
new file mode 100644
index 000000000..18e78087b
--- /dev/null
+++ b/Documentation/devicetree/bindings/iio/magnetometer/magnachip,mxm1120.yaml
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iio/magnetometer/magnachip,mxm1120.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MagnaChip MXM1120 Hall effect magnetic position sensor
+
+maintainers:
+  - Robin Snyders <robin@snyders.xyz>
+
+properties:
+  compatible:
+    const: magnachip,mxm1120
+
+  reg:
+    maxItems: 1
+
+  label:
+    description: Human-readable sensor position
+
+  vdd-supply:
+    description: Analog sensor supply
+
+  vio-supply:
+    description: I/O supply
+
+required:
+  - compatible
+  - reg
+  - vdd-supply
+  - vio-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        magnetometer@c {
+            compatible = "magnachip,mxm1120";
+            reg = <0x0c>;
+            label = "camera-popup-up";
+            vdd-supply = <&vreg_hall_3p0>;
+            vio-supply = <&vreg_hall_1p8>;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/vendor-prefixes.yaml b/Documentation/devicetree/bindings/vendor-prefixes.yaml
index 5d2a7a8d3..97abad9b6 100644
--- a/Documentation/devicetree/bindings/vendor-prefixes.yaml
+++ b/Documentation/devicetree/bindings/vendor-prefixes.yaml
@@ -902,6 +902,8 @@ patternProperties:
     description: M5Stack
   "^macnica,.*":
     description: Macnica Americas
+  "^magnachip,.*":
+    description: MagnaChip Semiconductor Corporation
   "^mantix,.*":
     description: Mantix Display Technology Co.,Ltd.
   "^mapleboard,.*":
diff --git a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
index 677abe53e..77a4b0438 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdog.dts
@@ -400,6 +400,29 @@ &qupv3_id_0 {
 	status = "okay";
 };
 
+&i2c1 {
+	/delete-property/ dmas;
+	/delete-property/ dma-names;
+	clock-frequency = <100000>;
+	status = "okay";
+
+	hall_up: magnetometer@c {
+		compatible = "magnachip,mxm1120";
+		reg = <0x0c>;
+		label = "camera-popup-up";
+		vdd-supply = <&vreg_l7c_3p0>;
+		vio-supply = <&vreg_l8c_1p8>;
+	};
+
+	hall_down: magnetometer@d {
+		compatible = "magnachip,mxm1120";
+		reg = <0x0d>;
+		label = "camera-popup-down";
+		vdd-supply = <&vreg_l7c_3p0>;
+		vio-supply = <&vreg_l8c_1p8>;
+	};
+};
+
 &i2c4 {
 	/delete-property/ dmas;
 	/delete-property/ dma-names;
diff --git a/drivers/iio/magnetometer/Kconfig b/drivers/iio/magnetometer/Kconfig
index 3debf1320..996bb01e9 100644
--- a/drivers/iio/magnetometer/Kconfig
+++ b/drivers/iio/magnetometer/Kconfig
@@ -139,6 +139,17 @@ config MMC35240
 	  To compile this driver as a module, choose M here: the module
 	  will be called mmc35240.
 
+config MXM1120
+	tristate "MagnaChip MXM1120 Hall effect sensor"
+	depends on I2C
+	select REGMAP_I2C
+	help
+	  Say yes here to build support for the MagnaChip MXM1120
+	  single-axis Hall effect magnetic position sensor.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called mxm1120.
+
 config IIO_ST_MAGN_3AXIS
 	tristate "STMicroelectronics magnetometers 3-Axis Driver"
 	depends on (I2C || SPI_MASTER) && SYSFS
diff --git a/drivers/iio/magnetometer/Makefile b/drivers/iio/magnetometer/Makefile
index 9297723a9..ce8ce776a 100644
--- a/drivers/iio/magnetometer/Makefile
+++ b/drivers/iio/magnetometer/Makefile
@@ -15,6 +15,7 @@ obj-$(CONFIG_BMC150_MAGN_SPI) += bmc150_magn_spi.o
 obj-$(CONFIG_MAG3110)	+= mag3110.o
 obj-$(CONFIG_HID_SENSOR_MAGNETOMETER_3D) += hid-sensor-magn-3d.o
 obj-$(CONFIG_MMC35240)	+= mmc35240.o
+obj-$(CONFIG_MXM1120)		+= mxm1120.o
 
 obj-$(CONFIG_IIO_ST_MAGN_3AXIS) += st_magn.o
 st_magn-y := st_magn_core.o
diff --git a/drivers/iio/magnetometer/mxm1120.c b/drivers/iio/magnetometer/mxm1120.c
new file mode 100644
index 000000000..641e5bf9d
--- /dev/null
+++ b/drivers/iio/magnetometer/mxm1120.c
@@ -0,0 +1,202 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MagnaChip MXM1120 Hall effect magnetic position sensor driver
+ */
+
+#include <linux/bitops.h>
+#include <linux/cleanup.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/iio/iio.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+
+#define MXM1120_REG_PERSINT		0x00
+#define MXM1120_REG_INTSRS		0x01
+#define MXM1120_REG_SRST		0x07
+#define MXM1120_REG_OPF			0x08
+#define MXM1120_REG_DID			0x09
+#define MXM1120_REG_ST1			0x10
+#define MXM1120_REG_HSL			0x11
+#define MXM1120_REG_HSH			0x12
+
+#define MXM1120_SRST_RESET		0x01
+#define MXM1120_DID_VALUE		0x9c
+#define MXM1120_ST1_DRDY		BIT(0)
+#define MXM1120_PERSINT_COUNT_4		0x40
+#define MXM1120_INTSRS_POLL_0034_MT	0x01
+#define MXM1120_OPF_80HZ_10BIT_ACTIVE	0x41
+
+struct mxm1120_data {
+	struct regmap *regmap;
+	struct mutex lock; /* serialize status and sample register reads */
+};
+
+static const struct regmap_config mxm1120_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = MXM1120_REG_HSH,
+};
+
+static const struct iio_chan_spec mxm1120_channels[] = {
+	{
+		.type = IIO_MAGN,
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),
+	},
+};
+
+static int mxm1120_read_measurement(struct mxm1120_data *data, int *value)
+{
+	unsigned int status;
+	u8 sample[2];
+	int ret;
+
+	guard(mutex)(&data->lock);
+
+	ret = regmap_read_poll_timeout(data->regmap, MXM1120_REG_ST1,
+				       status, status & MXM1120_ST1_DRDY,
+				       1000, 25000);
+	if (ret)
+		return ret;
+
+	ret = regmap_bulk_read(data->regmap, MXM1120_REG_HSL,
+			       sample, sizeof(sample));
+	if (ret)
+		return ret;
+
+	*value = ((sample[1] & BIT(6)) << 2) | sample[0];
+	if (sample[1] & BIT(7))
+		*value -= 0x200;
+
+	return 0;
+}
+
+static int mxm1120_read_raw(struct iio_dev *indio_dev,
+			    const struct iio_chan_spec *chan, int *val,
+			    int *val2, long mask)
+{
+	struct mxm1120_data *data = iio_priv(indio_dev);
+	int ret;
+
+	if (mask != IIO_CHAN_INFO_RAW)
+		return -EINVAL;
+
+	ret = mxm1120_read_measurement(data, val);
+	if (ret)
+		return ret;
+
+	return IIO_VAL_INT;
+}
+
+static const struct iio_info mxm1120_info = {
+	.read_raw = mxm1120_read_raw,
+};
+
+static int mxm1120_chip_init(struct device *dev, struct mxm1120_data *data)
+{
+	unsigned int id;
+	int ret;
+
+	ret = regmap_write(data->regmap, MXM1120_REG_SRST,
+			   MXM1120_SRST_RESET);
+	if (ret)
+		return ret;
+
+	usleep_range(5000, 6000);
+
+	ret = regmap_read(data->regmap, MXM1120_REG_DID, &id);
+	if (ret)
+		return ret;
+
+	if (id != MXM1120_DID_VALUE)
+		return dev_err_probe(dev, -ENODEV,
+				     "unexpected device ID 0x%02x\n", id);
+
+	ret = regmap_write(data->regmap, MXM1120_REG_PERSINT,
+			   MXM1120_PERSINT_COUNT_4);
+	if (ret)
+		return ret;
+
+	/* Polling mode avoids enabling the position IRQ before calibration. */
+	ret = regmap_write(data->regmap, MXM1120_REG_INTSRS,
+			   MXM1120_INTSRS_POLL_0034_MT);
+	if (ret)
+		return ret;
+
+	return regmap_write(data->regmap, MXM1120_REG_OPF,
+			    MXM1120_OPF_80HZ_10BIT_ACTIVE);
+}
+
+static int mxm1120_probe(struct i2c_client *client)
+{
+	static const char * const supply_names[] = { "vdd", "vio" };
+	struct device *dev = &client->dev;
+	struct mxm1120_data *data;
+	struct iio_dev *indio_dev;
+	const char *label;
+	int ret;
+
+	indio_dev = devm_iio_device_alloc(dev, sizeof(*data));
+	if (!indio_dev)
+		return -ENOMEM;
+
+	data = iio_priv(indio_dev);
+	data->regmap = devm_regmap_init_i2c(client, &mxm1120_regmap_config);
+	if (IS_ERR(data->regmap))
+		return dev_err_probe(dev, PTR_ERR(data->regmap),
+				     "failed to initialize regmap\n");
+
+	ret = devm_mutex_init(dev, &data->lock);
+	if (ret)
+		return ret;
+
+	ret = devm_regulator_bulk_get_enable(dev, ARRAY_SIZE(supply_names),
+					     supply_names);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable supplies\n");
+
+	usleep_range(5000, 6000);
+
+	ret = mxm1120_chip_init(dev, data);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to initialize sensor\n");
+
+	indio_dev->name = "mxm1120";
+	indio_dev->modes = INDIO_DIRECT_MODE;
+	indio_dev->info = &mxm1120_info;
+	indio_dev->channels = mxm1120_channels;
+	indio_dev->num_channels = ARRAY_SIZE(mxm1120_channels);
+	if (!device_property_read_string(dev, "label", &label))
+		indio_dev->label = label;
+
+	return devm_iio_device_register(dev, indio_dev);
+}
+
+static const struct of_device_id mxm1120_of_match[] = {
+	{ .compatible = "magnachip,mxm1120" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mxm1120_of_match);
+
+static const struct i2c_device_id mxm1120_id[] = {
+	{ "mxm1120" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, mxm1120_id);
+
+static struct i2c_driver mxm1120_driver = {
+	.driver = {
+		.name = "mxm1120",
+		.of_match_table = mxm1120_of_match,
+	},
+	.probe = mxm1120_probe,
+	.id_table = mxm1120_id,
+};
+module_i2c_driver(mxm1120_driver);
+
+MODULE_AUTHOR("Robin Snyders <robin@snyders.xyz>");
+MODULE_DESCRIPTION("MagnaChip MXM1120 Hall effect sensor driver");
+MODULE_LICENSE("GPL");
-- 
