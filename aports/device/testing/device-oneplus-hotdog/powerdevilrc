# Keep system suspend disabled until every wake path is reliable, but blank the
# OLED after two idle minutes. KWin DPMS does not suspend USB or networking.
[AC][DPMSControl]
idleTime=120
lockBeforeTurnOff=false
turnOffOnIdleTimeout=true

[AC][DimDisplay]
idleTime=0

[AC][Display]
TurnOffDisplayIdleTimeoutSec=120
TurnOffDisplayWhenIdle=true

[AC][DisplayAndBrightness]
DimDisplayIdleTimeoutSec=0
DimDisplayWhenIdle=false
LockBeforeTurnOffDisplay=false
TurnOffDisplayIdleTimeoutSec=120
TurnOffDisplayIdleTimeoutWhenLockedSec=120
TurnOffDisplayWhenIdle=true

[AC][SuspendAndShutdown]
AutoSuspendAction=0

[Battery][DPMSControl]
idleTime=120
lockBeforeTurnOff=false
turnOffOnIdleTimeout=true

[Battery][DimDisplay]
idleTime=0

[Battery][Display]
TurnOffDisplayIdleTimeoutSec=120
TurnOffDisplayWhenIdle=true

[Battery][DisplayAndBrightness]
DimDisplayIdleTimeoutSec=0
DimDisplayWhenIdle=false
LockBeforeTurnOffDisplay=false
TurnOffDisplayIdleTimeoutSec=120
TurnOffDisplayIdleTimeoutWhenLockedSec=120
TurnOffDisplayWhenIdle=true

[Battery][SuspendAndShutdown]
AutoSuspendAction=0

[LowBattery][DPMSControl]
idleTime=120
lockBeforeTurnOff=false
turnOffOnIdleTimeout=true

[LowBattery][DimDisplay]
idleTime=0

[LowBattery][Display]
TurnOffDisplayIdleTimeoutSec=120
TurnOffDisplayWhenIdle=true

[LowBattery][DisplayAndBrightness]
DimDisplayIdleTimeoutSec=0
DimDisplayWhenIdle=false
LockBeforeTurnOffDisplay=false
TurnOffDisplayIdleTimeoutSec=120
TurnOffDisplayIdleTimeoutWhenLockedSec=120
TurnOffDisplayWhenIdle=true

[LowBattery][SuspendAndShutdown]
AutoSuspendAction=0
