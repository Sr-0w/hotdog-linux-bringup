# Reference: <https://postmarketos.org/devicepkg>

pkgname=device-oneplus-hotdog
pkgdesc="OnePlus 7T Pro"
pkgver=3
pkgrel=39
url="https://postmarketos.org"
license="MIT"
maintainer="Igor Belwon <igor.belwon@mentallysanemainliners.org>"
arch="aarch64"
options="!check !archcheck"
install="$pkgname.post-install $pkgname.post-upgrade"
depends="
	alsa-ucm-conf
	android-tools-avbtool
	postmarketos-base
	mkbootimg
	soc-qcom-qbootctl
	swclock-offset
"
makedepends="devicepkg-dev"
source="
	HiFi.conf
	deviceinfo
	hotdog.conf
	kernel-cmdline.conf
	30-initramfs-firmware.files
	51-qcom-sm8150.lua
	90-hotdog-bringup-doas.conf
	90-hotdog-camera.conf
	postprocess-boot-avb.sh
	hotdog-alert-slider.desktop
	hotdog-no-sleep.initd
	hotdog-plasma-no-sleep
	hotdog-plasma-no-sleep.desktop
	hotdog-usb-acm
	hotdog-usb-acm-login
	hotdog-usb-acm.initd
	hotdog-qbootctl.initd
	hotdog-reboot-mode.py
	62-hotdog-elliptic-proximity.rules
	elliptic-proximity-smoke.py
	hotdog-elliptic-calibration.py
	hotdog-import-factory-calibration.py
	hotdog-oppo-version-provision
	hotdog-proximity-arm.initd
	hotdog-proximity-armd.py
	hotdog-run-hexagonrpcd
	hotdog-sensor-gate.initd
	hotdog-sensor-proxy-gate.sh
	hotdog-ssc-client.py
	device-oneplus-hotdog-sensors.post-install
	powerdevilrc
"

subpackages="
	$pkgname-kernel-downstream:kernel_downstream
	$pkgname-kernel-mainline:kernel_mainline
	$pkgname-nonfree-firmware:nonfree_firmware
	$pkgname-mainline-firmware:mainline_firmware
	$pkgname-wireplumber:wireplumber
	$pkgname-sensors:sensors
	$pkgname-bringup:bringup
	$pkgname-plasma-mobile-apps:plasma_mobile_apps
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	# Alpine's PAM server is named sshd.pam while OpenRC starts sshd.
	mkdir -p "$pkgdir/usr/sbin"
	ln -s sshd.pam "$pkgdir/usr/sbin/sshd"
	ln -s /usr/share/deviceinfo/deviceinfo "$pkgdir/etc/deviceinfo"
	install -Dm644 "$srcdir/HiFi.conf" \
		"$pkgdir/usr/share/alsa/ucm2/OnePlus/hotdog/HiFi.conf"
	install -Dm644 "$srcdir/hotdog.conf" \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/sm8150/OnePlus 7T Pro.conf"
	install -Dm755 "$srcdir/postprocess-boot-avb.sh" \
		"$pkgdir/usr/share/mkinitfs/postprocess-oneplus-hotdog-boot-avb.sh"
	install -Dm755 "$srcdir/hotdog-usb-acm" \
		"$pkgdir/usr/libexec/hotdog-usb-acm"
	install -Dm755 "$srcdir/hotdog-usb-acm-login" \
		"$pkgdir/usr/libexec/hotdog-usb-acm-login"
	install -Dm755 "$srcdir/hotdog-usb-acm.initd" \
		"$pkgdir/etc/init.d/hotdog-usb-acm"
	install -Dm755 "$srcdir/hotdog-qbootctl.initd" \
		"$pkgdir/etc/init.d/hotdog-qbootctl"
	install -Dm755 "$srcdir/hotdog-reboot-mode.py" \
		"$pkgdir/usr/libexec/hotdog-reboot-mode.py"
}

sensors() {
	pkgdesc="SLPI and Elliptic sensor integration"
	install="$subpkgname.post-install"
	install_if="$pkgname-kernel-mainline $pkgname-nonfree-firmware"
	depends="
		alsa-utils
		hexagonrpcd
		hotdog-sensor-config
		iio-sensor-proxy
		iio-sensor-proxy-openrc
		pd-mapper-openrc
		python3
		qrtr
	"
	install -Dm644 "$srcdir/62-hotdog-elliptic-proximity.rules" \
		"$subpkgdir/usr/lib/udev/rules.d/62-hotdog-elliptic-proximity.rules"
	install -Dm755 "$srcdir/elliptic-proximity-smoke.py" \
		"$subpkgdir/usr/libexec/elliptic-proximity-smoke.py"
	install -Dm755 "$srcdir/hotdog-elliptic-calibration.py" \
		"$subpkgdir/usr/libexec/hotdog-elliptic-calibration.py"
	install -Dm755 "$srcdir/hotdog-import-factory-calibration.py" \
		"$subpkgdir/usr/libexec/hotdog-import-factory-calibration.py"
	install -Dm755 "$srcdir/hotdog-oppo-version-provision" \
		"$subpkgdir/usr/libexec/hotdog-oppo-version-provision"
	install -Dm755 "$srcdir/hotdog-proximity-arm.initd" \
		"$subpkgdir/etc/init.d/hotdog-proximity-arm"
	install -Dm755 "$srcdir/hotdog-proximity-armd.py" \
		"$subpkgdir/usr/libexec/hotdog-proximity-armd.py"
	install -Dm755 "$srcdir/hotdog-run-hexagonrpcd" \
		"$subpkgdir/usr/libexec/hotdog-run-hexagonrpcd"
	install -Dm755 "$srcdir/hotdog-sensor-gate.initd" \
		"$subpkgdir/etc/init.d/hotdog-sensor-gate"
	install -Dm755 "$srcdir/hotdog-sensor-proxy-gate.sh" \
		"$subpkgdir/usr/libexec/hotdog-sensor-proxy-gate.sh"
	install -Dm755 "$srcdir/hotdog-ssc-client.py" \
		"$subpkgdir/usr/libexec/hotdog-ssc-client.py"
}

kernel_downstream() {
	pkgdesc="LineageOS 4.14 rescue bridge (boot-proven)"
	depends="
		!$pkgname-kernel-mainline
		$pkgname=$pkgver-r$pkgrel
		linux-oneplus-hotdog-lineage414
	"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

kernel_mainline() {
	pkgdesc="Clean SM8150 6.17 direct-boot kernel"
	depends="
		!$pkgname-kernel-downstream
		$pkgname=$pkgver-r$pkgrel
		linux-oneplus-hotdog-mainline617-clean
		mesa-vulkan-freedreno
	"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

bringup() {
	pkgdesc="Development-only doas policy for dedicated bring-up phones"
	depends="doas"
	install -Dm0440 "$srcdir/90-hotdog-bringup-doas.conf" \
		"$subpkgdir/etc/doas.d/90-hotdog-bringup.conf"
}

plasma_mobile_apps() {
	pkgdesc="Mobile application set for Plasma Mobile"
	install="$subpkgname.post-install"
	depends="
		angelfish
		discover
		discover-backend-flatpak
		dolphin
		flatpak
		kalk
		kclock
		koko
		konsole
		kweather
		libcamera-gstreamer
		libcamera-tools
		megapixels
		merkuro
		okular-mobile
		pipewire-spa-libcamera
		plasma-camera
		plasma-dialer
		polkit-elogind
		py3-libcamera
		spacebar
		xdg-user-dirs
	"
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-plasma-mobile"
	install -Dm644 "$srcdir/powerdevilrc" \
		"$subpkgdir/etc/xdg/powerdevilrc"
	install -Dm755 "$srcdir/hotdog-no-sleep.initd" \
		"$subpkgdir/etc/init.d/hotdog-no-sleep"
	install -Dm755 "$srcdir/hotdog-plasma-no-sleep" \
		"$subpkgdir/usr/libexec/hotdog-plasma-no-sleep"
	install -Dm644 "$srcdir/hotdog-alert-slider.desktop" \
		"$subpkgdir/etc/xdg/autostart/hotdog-alert-slider.desktop"
	install -Dm644 "$srcdir/hotdog-plasma-no-sleep.desktop" \
		"$subpkgdir/etc/xdg/autostart/hotdog-plasma-no-sleep.desktop"
}

mainline_firmware() {
	pkgdesc="Firmware support packages for mainline kernel"
	depends="firmware-oneplus-hotdog-adreno"
	install_if="$pkgname-kernel-mainline $pkgname-nonfree-firmware"
	mkdir "$subpkgdir"

	install -Dm644 "$srcdir/30-initramfs-firmware.files" \
		"$subpkgdir/usr/share/mkinitfs/files/30-initramfs-firmware.files"
}

nonfree_firmware() {
	pkgdesc="Firmware for GPU, Touchscreen, Audio, Bluetooth, WiFi, etc."
	install="$subpkgname.post-install"
	depends="
		firmware-oneplus-hotdog-adreno
		firmware-oneplus-hotdog-adsp
		firmware-oneplus-hotdog-cdsp
		firmware-oneplus-hotdog-modem-oos10
		firmware-oneplus-hotdog-nfc
		firmware-oneplus-hotdog-slpi
		firmware-oneplus-hotdog-pd-maps
		firmware-oneplus-hotdog-wlan
		firmware-oneplus-hotdog-bluetooth
		firmware-oneplus-hotdog-venus
		modemmanager
		modemmanager-openrc
		hotdog-radio-bootstrap
		hotdog-radio-bootstrap-openrc
		msm-modem-uim-selection
		msm-modem
		rmtfs
		rmtfs-openrc
		pd-mapper
		pd-mapper-openrc
		qrtr
		hexagonrpcd
		tqftpserv
		tqftpserv-openrc
		bootmac
		alsa-utils
		"
	mkdir "$subpkgdir"
}

wireplumber() {
	install_if="$pkgname=$pkgver-r$pkgrel wireplumber"
	install -Dm644 "$srcdir"/51-qcom-sm8150.lua \
		-t "$subpkgdir"/usr/share/wireplumber/main.lua.d
	install -Dm644 "$srcdir"/90-hotdog-camera.conf \
		-t "$subpkgdir"/etc/wireplumber/wireplumber.conf.d
}

