#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034

supervisor="supervise-daemon"
name="OnePlus hotdog USB ACM console"
description="Add a serial console while preserving the existing USB gadget"
command="/usr/libexec/hotdog-usb-acm"
respawn_delay=2
respawn_max=0

depend() {
	need localmount
	after usb-signaller
}
