pkgname=firmware-oneplus-hotdog-modem-oos10
pkgver=1.0.11.1.7
pkgrel=2
pkgdesc="OxygenOS 10 modem firmware for OnePlus 7T Pro"
url="https://www.oneplus.com/global/support/softwareupgrade"
arch="aarch64"
license="proprietary"
maintainer="Sr-0w <Sr-0w@users.noreply.github.com>"
options="!check !strip !archcheck !tracedeps"
provides="firmware-oneplus-hotdog-modem=$pkgver-r$pkgrel"
replaces="firmware-oneplus-hotdog-modem"

source="
	modem-oos10.0.13.mbn
	mcfg-oos10.0.13.tar.gz
	README.md
	"
builddir="$srcdir"

package() {
	install -Dm644 "$srcdir/modem-oos10.0.13.mbn" \
		"$pkgdir/lib/firmware/qcom/sm8150/oneplus/hotdog/modem.mbn"
	find "$srcdir/mcfg_sw" -type f -print | while IFS= read -r file; do
		relative=${file#"$srcdir/mcfg_sw/"}
		install -Dm644 "$file" \
			"$pkgdir/usr/share/hotdog-radio/mcfg/mcfg_sw/$relative"
	done
}

