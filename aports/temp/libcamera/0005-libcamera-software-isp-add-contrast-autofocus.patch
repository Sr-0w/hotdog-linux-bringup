 	double error = kExposureOptimal - exposureMSV;
 
 	if (std::abs(error) <= kExposureSatisfactory)
-		return;
+		return false;
 
 	/*
 	 * Compute a proportional correction factor. The sign of the error
@@ -122,6 +130,8 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, dou
 		<< "exposureMSV " << exposureMSV
 		<< " error " << error << " factor " << factor
 		<< " exp " << exposure << " again " << again;
+
+	return exposure != oldExposure || again != oldAgain;
 }
 
 void Agc::process(IPAContext &context,
@@ -142,6 +152,7 @@ void Agc::process(IPAContext &context,
 		 */
 		context.activeState.agc.exposure = frameContext.sensor.exposure;
 		context.activeState.agc.again = frameContext.sensor.gain;
+		context.activeState.agc.stableSamples = 0;
 		context.activeState.agc.valid = true;
 	}
 
@@ -189,7 +200,16 @@ void Agc::process(IPAContext &context,
 	}
 
 	float exposureMSV = (denom == 0 ? 0 : static_cast<float>(num) / denom);
-	updateExposure(context, frameContext, exposureMSV);
+	const bool adjusted = updateExposure(context, frameContext, exposureMSV);
+	if (adjusted)
+		context.activeState.agc.stableSamples = 0;
+	else
+		context.activeState.agc.stableSamples = std::min(
+			context.activeState.agc.stableSamples + 1, 100U);
+
+	LOG(IPASoftExposure, Debug)
+		<< "AE stable samples " << context.activeState.agc.stableSamples
+		<< " (adjusted " << adjusted << ")";
 }
 
