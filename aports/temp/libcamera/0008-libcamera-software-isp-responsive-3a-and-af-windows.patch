+uint64_t Af::windowSharpness(const IPAContext &context,
+			     const SwIspStats *stats) const
+{
+	const auto &af = context.activeState.af;
+	Rectangle crop = context.sensorInfo.analogCrop;
+	if (!crop.width || !crop.height)
+		crop = Rectangle(context.sensorInfo.outputSize);
+
+	Rectangle window;
+	if (af.metering == controls::AfMeteringWindows && af.windowValid) {
+		window = af.window.boundedTo(crop);
+	} else {
+		window = Rectangle(crop.x + crop.width / 4,
+				   crop.y + crop.height / 4,
+				   crop.width / 2, crop.height / 2);
+	}
+
+	uint64_t weightedSharpness = 0;
+	uint64_t totalWeight = 0;
+	for (unsigned int y = 0; y < SwIspStats::kAfGridHeight; ++y) {
+		for (unsigned int x = 0; x < SwIspStats::kAfGridWidth; ++x) {
+			const int x0 = crop.x + crop.width * x /
+						SwIspStats::kAfGridWidth;
+			const int x1 = crop.x + crop.width * (x + 1) /
+						SwIspStats::kAfGridWidth;
+			const int y0 = crop.y + crop.height * y /
+						SwIspStats::kAfGridHeight;
+			const int y1 = crop.y + crop.height * (y + 1) /
+						SwIspStats::kAfGridHeight;
+			const Rectangle overlap =
+				Rectangle(x0, y0, x1 - x0, y1 - y0).boundedTo(window);
+			const uint64_t weight =
+				static_cast<uint64_t>(overlap.width) * overlap.height;
+			if (!weight)
+				continue;
+
+			const unsigned int index =
+				y * SwIspStats::kAfGridWidth + x;
+			weightedSharpness += stats->afSharpness[index] * weight;
+			totalWeight += weight;
+		}
+	}
+
+	return totalWeight ? weightedSharpness / totalWeight : stats->sharpness;
+}
