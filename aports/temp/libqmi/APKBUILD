# Forked from Alpine community/libqmi
maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=libqmi
pkgver=1.38.0_git20260414
_commit=cff17a676e10d75081516dafa997fe9bc9043c38
pkgrel=1
pkgdesc="QMI modem protocol helper library"
url="https://www.freedesktop.org/wiki/Software/libqmi"
arch="all"
license="GPL-2.0-or-later AND LGPL-2.1-or-later"
makedepends="
	bash-completion-dev
	glib-dev
	gobject-introspection-dev
	help2man
	libgudev-dev
	libmbim-dev
	libqrtr-glib-dev
	linux-headers
	meson
	python3
	"
subpackages="
	$pkgname-dev
	$pkgname-doc
	$pkgname-bash-completion
	qmi-utils
	"
source="
	https://gitlab.freedesktop.org/mobile-broadband/libqmi/-/archive/$_commit/libqmi-$_commit.tar.gz
	0001-pdc-add-subscription-id.patch
	"
builddir="$srcdir/$pkgname-$_commit"

build() {
	abuild-meson \
		-Db_lto=true \
		. output
	meson compile -C output
}

check() {
	local tests=$(meson test --list -C output)
	case "$CARCH" in
		s390x) tests=${tests//test-message} ;;
	esac
	meson test --print-errorlogs -C output $tests
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

utils() {
	pkgdesc="$pkgdesc (CLI utilities)"

	amove usr/bin
}

