# Maintainer: Robin Snyders <robin@snyders.xyz>
pkgname=hexagonrpcd
pkgver=0.4.0
pkgrel=11
pkgdesc="FastRPC server for Qualcomm DSPs, with writable file service"
url="https://github.com/linux-msm/hexagonrpc"
arch="all"
license="GPL-3.0-or-later"
makedepends="meson linux-headers"

# The hexagonfs test takes its sample file by a path relative to the source
# tree and meson runs it from the build directory, so it cannot find it here.
# The test passes when run by hand against this build.
options="!check"
subpackages="$pkgname-dev $pkgname-doc libhexagonrpc:_lib"
source="
	$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz
	0001-serve-writable-files.patch
	0002-implement-fremove.patch
	0003-raise-listener-input-limit.patch
"
builddir="$srcdir/hexagonrpc-$pkgver"

build() {
	abuild-meson -Dc_args=-DHEXAGONRPC_VERBOSE . output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

_lib() {
	pkgdesc="FastRPC library for Qualcomm DSPs"
	amove usr/lib/libhexagonrpc.so.*
}
