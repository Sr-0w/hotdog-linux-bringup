1bf9600667747061e1d4bde2cf419dc9e7567ac409afccbe1025f074510d2cd17bd80dd69de9d4df83df24f64e0cb0a6c669176cc5251c0938658601f89d0c9e  0001-serve-writable-files.patch
"
