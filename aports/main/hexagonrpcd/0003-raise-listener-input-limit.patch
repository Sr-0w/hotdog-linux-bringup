diff --git a/hexagonrpcd/listener.c b/hexagonrpcd/listener.c
index 4a481df..6d49bdd 100644
--- a/hexagonrpcd/listener.c
+++ b/hexagonrpcd/listener.c
@@ -24,12 +24,15 @@
