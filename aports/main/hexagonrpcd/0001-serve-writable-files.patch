 	if (dir)
 		flags |= O_DIRECTORY;
 
-	ctx->fd = open(name, flags);
+	/*
+	 * The DSP updates some of the files it is served, the sensor registry
+	 * version among them. Prefer read-write and fall back, so a read-only
+	 * mount or a file we may not write still opens.
+	 */
+	ctx->fd = dir ? -1 : open(name, (flags & ~O_ACCMODE) | O_RDWR);
+	if (ctx->fd == -1)
