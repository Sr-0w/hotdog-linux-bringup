+	  .val = USBIN_AICL_PERIODIC_RERUN_EN_BIT | USBIN_AICL_EN_BIT |
+		 SUSPEND_ON_COLLAPSE_USBIN_BIT },
+	{ .addr = AICL_RERUN_TIME_CFG,
+	  .mask = AICL_RERUN_TIME_MASK,
+	  .val = AICL_RERUN_TIME_12_SECS },
 };
 
