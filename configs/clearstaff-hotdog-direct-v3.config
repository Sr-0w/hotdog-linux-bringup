# Match the early ARM64 geometry of the direct-boot-proven 6.17 hotdog kernel.
CONFIG_ARM64_VA_BITS_39=y
# CONFIG_ARM64_VA_BITS_48 is not set
# CONFIG_ARM64_VA_BITS_52 is not set
CONFIG_ARM64_PA_BITS_48=y
# CONFIG_ARM64_PA_BITS_52 is not set
# CONFIG_ARM64_LPA2 is not set
# CONFIG_NUMA is not set
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_RODATA_FULL_DEFAULT_ENABLED is not set

# Avoid enabling architectural extensions absent from the proven entry build.
# CONFIG_ARM64_PTR_AUTH is not set
# CONFIG_ARM64_BTI is not set
# CONFIG_ARM64_MTE is not set
# CONFIG_ARM64_EPAN is not set
# CONFIG_ARM64_POE is not set
# CONFIG_ARM64_GCS is not set
# CONFIG_ARM64_SVE is not set
# CONFIG_ARM64_SME is not set

# Match the proven EL2 path: do not clean or initialize the KVM nVHE payload.
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set

# Preserve the stock-ABL image layout and adopt the APSS watchdog in-kernel.
# CONFIG_EFI is not set
CONFIG_QCOM_WDT=y
