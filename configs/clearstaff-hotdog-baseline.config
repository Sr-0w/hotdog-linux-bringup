# Dependencies omitted by the external sm8150.config fragment.
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y

# ClearStaff's hotdog branch references this object but does not contain its
# source file. Keep the first boot control buildable without substituting the
# incompatible OnePlus 7 Pro panel driver.
# CONFIG_DRM_PANEL_SAMSUNG_ONEPLUS_DSC is not set

# Keep the release stable when the build-only LLVM compatibility patch is applied.
# CONFIG_LOCALVERSION_AUTO is not set
